{
  "name": "recall-radar-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 5179",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:data": "npm run fetch:cpsc && npm run fetch:fda-food && npm run fetch:rappelconso && npm run fetch:canada && npm run fetch:eu-safety-gate && npm run fetch:uk-fsa",
    "fetch:cpsc": "node --experimental-strip-types scripts/fetch-cpsc.ts",
    "fetch:fda-food": "node --experimental-strip-types scripts/fetch-fda-food.ts",
    "debug:fda-food-single": "node --experimental-strip-types scripts/debug-fda-food-single.ts",
    "plan:fda-food-backfill": "node --experimental-strip-types scripts/plan-fda-food-backfill.ts",
    "backfill:fda-food": "node --experimental-strip-types scripts/backfill-fda-food.ts",
    "audit:fda-food-backfill": "node --experimental-strip-types scripts/audit-fda-food-backfill.ts",
    "plan:source-backfills": "node --experimental-strip-types scripts/plan-source-backfills.ts",
    "audit:source-backfills": "node --experimental-strip-types scripts/audit-source-backfills.ts",
    "fetch:rappelconso": "node --experimental-strip-types scripts/fetch-rappelconso.ts",
    "fetch:canada": "node --experimental-strip-types scripts/fetch-canada-recalls.ts",
    "fetch:eu-safety-gate": "node --experimental-strip-types scripts/fetch-eu-safety-gate.ts",
    "fetch:uk-fsa": "node --experimental-strip-types scripts/fetch-uk-fsa-alerts.ts",
    "data:rappelconso:fetch": "npm run fetch:rappelconso",
    "data:rappelconso:normalize": "npm run normalize:rappelconso",
    "data:canada:fetch": "npm run fetch:canada",
    "data:canada:normalize": "npm run normalize:canada",
    "data:eu-safety-gate:fetch": "npm run fetch:eu-safety-gate",
    "data:eu-safety-gate:normalize": "npm run normalize:eu-safety-gate",
    "data:uk-fsa:fetch": "npm run fetch:uk-fsa",
    "data:uk-fsa:normalize": "npm run normalize:uk-fsa",
    "data:merge": "node --experimental-strip-types scripts/merge-recalls.ts",
    "update:rappelconso": "npm run data:rappelconso:fetch && npm run audit:rappelconso",
    "update:canada": "npm run data:canada:fetch && npm run audit:canada",
    "update:eu-safety-gate": "npm run data:eu-safety-gate:fetch && npm run audit:eu-safety-gate",
    "update:uk-fsa": "npm run data:uk-fsa:fetch && npm run data:uk-fsa:normalize && npm run data:merge && npm run audit:uk-fsa",
    "audit:sources": "node --experimental-strip-types scripts/audit-global-sources.ts",
    "audit:rappelconso": "node --experimental-strip-types scripts/audit-rappelconso.ts",
    "audit:canada": "node --experimental-strip-types scripts/audit-canada-recalls.ts",
    "audit:eu-safety-gate": "node --experimental-strip-types scripts/audit-eu-safety-gate.ts",
    "audit:uk-fsa": "node --experimental-strip-types scripts/audit-uk-fsa-alerts.ts",
    "audit:images": "node --experimental-strip-types scripts/audit-images.ts",
    "audit:images:live": "cross-env IMAGE_LIVE_CHECK=1 node --experimental-strip-types scripts/audit-images.ts",
    "audit:image-performance": "node --experimental-strip-types scripts/audit-image-performance.ts",
    "validate:launch": "npm run audit:sources && npm run audit:uk-fsa && npm run audit:eu-safety-gate && npm run audit:canada && npm run audit:rappelconso && npm run check && npm run build",
    "normalize:cpsc": "node --experimental-strip-types scripts/normalize-cpsc.ts",
    "normalize:fda-food": "node --experimental-strip-types scripts/normalize-fda-food.ts",
    "normalize:rappelconso": "node --experimental-strip-types scripts/normalize-rappelconso.ts",
    "normalize:canada": "node --experimental-strip-types scripts/normalize-canada-recalls.ts",
    "normalize:eu-safety-gate": "node --experimental-strip-types scripts/normalize-eu-safety-gate.ts",
    "normalize:uk-fsa": "node --experimental-strip-types scripts/normalize-uk-fsa-alerts.ts",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 5179",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.3"
  }
}
