{
  "name": "recall-radar-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 5179",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:data": "npm run fetch:cpsc && npm run fetch:fda-food",
    "fetch:cpsc": "node --experimental-strip-types scripts/fetch-cpsc.ts",
    "fetch:fda-food": "node --experimental-strip-types scripts/fetch-fda-food.ts",
    "normalize:cpsc": "node --experimental-strip-types scripts/normalize-cpsc.ts",
    "normalize:fda-food": "node --experimental-strip-types scripts/normalize-fda-food.ts",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 5179",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.3"
  }
}
