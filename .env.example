# Recall Radar local LLM classifier environment example.
# Copy this file to .env.local and put real API keys only in .env.local.
# Never commit .env.local or real API keys.

RECALL_CLASSIFIER_PROVIDER=gemini
RECALL_CLASSIFIER_MODEL=gemini-2.5-flash-lite
RECALL_CLASSIFIER_LIMIT=100
RECALL_CLASSIFIER_SAMPLE_STRATEGY=balanced
RECALL_CLASSIFIER_OUTPUT_DIR=outputs/llm-classifier

# Editable cost estimates. Verify current provider pricing before large runs.
RECALL_CLASSIFIER_INPUT_USD_PER_1M=0.10
RECALL_CLASSIFIER_OUTPUT_USD_PER_1M=0.40

# Required for Gemini live probes/classification.
GEMINI_API_KEY=

# Optional alternate provider.
OPENAI_API_KEY=

# Advertising stays disabled until both values are set with your approved AdSense account details.
# These public identifiers are included in browser ad code; do not put private credentials here.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_HOME_SLOT=

# Amazon Associates is intentionally not rendered yet. Add market-specific Associate tags only
# after the corresponding safety buying-guide content and disclosure are ready.
PUBLIC_AMAZON_ASSOCIATE_TAG_US=

# For offline dry runs, use:
# RECALL_CLASSIFIER_PROVIDER=mock
