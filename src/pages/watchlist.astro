---
import SiteHeader from '../components/SiteHeader.astro';
import EuImageResourceHints from '../components/EuImageResourceHints.astro';
import {
  dataSourceLabel,
  processedAustraliaProductSafetyRecordCount,
  processedCanadaRecordCount,
  processedCpscRecordCount,
  processedEuSafetyGateRecordCount,
  processedFdaRecordCount,
  processedFranceRappelConsoRecordCount,
  processedFsanzFoodRecallRecordCount,
  processedHongKongCfsRecordCount,
  processedLocalRecordCount,
  processedNewZealandProductSafetyRecordCount,
  processedUkFsaRecordCount,
  siteRecalls,
  usingProcessedLocalData
} from '../lib/recall-data';
import { getRecallImageForContext } from '../lib/recall-images';
import { cleanRecallDisplayText } from '../lib/recall-display-text';
import '../styles/global.css';

const title = 'Saved Watchlist | Recall Radar';
const description =
  'Save Recall Radar search terms and brands in this browser, then preview matching recall notices without an account or email alerts.';
const watchlistRecalls = siteRecalls.map((recall) => {
  const cardImage = getRecallImageForContext(recall, 'list');

  return {
  id: recall.id,
  source: recall.source,
  sourceLabel: recall.sourceLabel,
  sourceUrl: recall.sourceUrl,
  title: recall.title,
  brandNames: recall.brandNames,
  displayBrandNames: recall.displayBrandNames,
  primaryBrand: recall.primaryBrand,
  primaryBrandRawName: recall.primaryBrandRawName,
  primaryBrandSlug: recall.primaryBrandSlug,
  productNames: recall.productNames,
  primaryProductName: recall.primaryProductName,
  category: recall.category,
  rawCategory: recall.rawCategory,
  categoryLabel: recall.categoryLabel,
  taxonomyProductFamily: recall.taxonomyProductFamily,
  taxonomyProductFamilyLabel: recall.taxonomyProductFamilyLabel,
  taxonomyProductType: recall.taxonomyProductType,
  taxonomyProductTypeLabel: recall.taxonomyProductTypeLabel,
  taxonomyHazardType: recall.taxonomyHazardType,
  taxonomyHazardTypeLabel: recall.taxonomyHazardTypeLabel,
  taxonomyHazardTags: recall.taxonomyHazardTags,
  taxonomyRecallDomain: recall.taxonomyRecallDomain,
  taxonomyRecallDomainLabel: recall.taxonomyRecallDomainLabel,
  taxonomyAudience: recall.taxonomyAudience,
  taxonomyAudienceLabels: recall.taxonomyAudienceLabels,
  taxonomyReason: recall.taxonomyReason,
  hazard: recall.hazard,
  remedy: cleanRecallDisplayText(recall.remedy),
  recallDate: recall.recallDate,
  affectedUnits: recall.affectedUnits,
  description: cleanRecallDisplayText(recall.description),
  slug: recall.slug,
  detailPath: recall.detailPath,
  classification: recall.classification,
  reason: recall.reason,
  distributionPattern: recall.distributionPattern,
  productQuantity: recall.productQuantity,
  recallNumber: recall.recallNumber,
  status: recall.status,
  primaryImageUrl: recall.primaryImageUrl,
  primaryImageThumbnailUrl: recall.primaryImageThumbnailUrl,
  primaryImageAlt: recall.primaryImageAlt,
  cardImageUrl: cardImage.url,
  cardImageAlt: cardImage.alt
  };
});
const watchlistRecallsJson = JSON.stringify(watchlistRecalls);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <EuImageResourceHints />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteHeader />

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow" data-i18n="watchlist.eyebrow">Browser watchlist</p>
        <h1 data-i18n="watchlist.savedInBrowser">Saved in this browser</h1>
        <p class="lead" data-i18n="watchlist.lead">
          Save searches and brands in this browser, then preview matching recall notices from official sources.
        </p>
        <div class="meta-row data-source-row">
          <span class="status-pill">{dataSourceLabel}</span>
          <span class="tag">
            {usingProcessedLocalData ? `${processedLocalRecordCount} recall notices` : 'Example notices'}
          </span>
          {usingProcessedLocalData ? (
            <>
              <span class="tag">{processedCpscRecordCount} consumer product notices</span>
              <span class="tag">{processedFdaRecordCount} food enforcement notices</span>
              <span class="tag">{processedFranceRappelConsoRecordCount} France RappelConso notices</span>
              <span class="tag">{processedCanadaRecordCount} Canada recall and safety alert notices</span>
              <span class="tag">{processedEuSafetyGateRecordCount} EU Safety Gate alerts</span>
              <span class="tag">{processedUkFsaRecordCount} UK FSA food alerts</span>
              <span class="tag">{processedAustraliaProductSafetyRecordCount} Australia Product Safety notices</span>
              <span class="tag">{processedNewZealandProductSafetyRecordCount} New Zealand Product Safety notices</span>
              <span class="tag">{processedHongKongCfsRecordCount} Hong Kong CFS food alerts</span>
              <span class="tag">{processedFsanzFoodRecallRecordCount} FSANZ food recall notices</span>
            </>
          ) : null}
        </div>
      </section>

      <section class="section">
        <div class="watchlist-layout">
          <article class="detail-card">
            <h2 data-i18n="watchlist.emailPreviewTitle">Email preview only</h2>
            <p data-i18n="watchlist.emailPreviewCopy">
              This non-submitting form previews a future preference. It does not send, store, or transmit an email address.
            </p>
            <form id="demo-alert-form" class="signup-form">
              <label>
                <span data-i18n="watchlist.emailPreviewLabel">Email preview</span>
                <input type="email" placeholder="you@example.com" autocomplete="off" />
              </label>
              <button class="btn btn-primary" type="submit" data-i18n="watchlist.previewPreference">Preview preference</button>
              <p id="demo-alert-status" class="form-note" hidden></p>
            </form>
          </article>

          <article class="detail-card">
            <h2 data-i18n="watchlist.savedItems">Saved items</h2>
            <p data-i18n="watchlist.savedItemsCopy">
              Saved searches stay on this device. No account or email alerts are enabled yet.
            </p>
            <div class="meta-row data-source-row">
              <span id="watchlist-count" class="status-pill">0 saved items</span>
              <button id="clear-watchlist" class="btn btn-secondary" type="button" data-i18n="watchlist.clearAll">Clear all</button>
            </div>
          </article>
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <p class="eyebrow" data-i18n="watchlist.savedPreviewEyebrow">Saved recall previews</p>
            <h2 data-i18n="watchlist.savedPreviewTitle">Saved recall previews</h2>
            <p class="section-note" data-i18n="watchlist.savedPreviewCopy">Cards are matched in this browser from recall notices.</p>
          </div>
          <a class="btn btn-secondary" href="/checker" data-i18n="watchlist.saveAnotherSearch">Save another search</a>
        </div>
        <p class="disclaimer-copy" data-i18n="disclaimer.possibleMatches">
          Search results are possible matches, not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.
        </p>
        <div id="empty-watchlist" class="notice-panel">
          <p data-i18n="watchlist.empty">No saved searches or brands yet. Use Product Recalls or a brand page to add saved items.</p>
        </div>
        <div id="watchlist-items" class="watchlist-items"></div>
      </section>
    </main>

    <footer class="page-footer">
      <span data-i18n="footer.disclaimer">Recall Radar helps you find possible recall notices. Search results are not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.</span>
    </footer>

    <script id="watchlist-recall-data" type="application/json" is:inline set:html={watchlistRecallsJson}></script>
    <script>
      import { MATCH_LABELS, SEARCH_RESULTS_DISCLAIMER, getRecallIdentifierHint, searchRecalls } from '../lib/recall-search';
      import { getNoResultIdentifierHint } from '../lib/identifier-guidance';
      import {
        getRecallActionLabel,
        getRecallDefaultActionFallback,
        getRecallReasonLabel,
        getRecallSourceLabel,
        getRecallSourcePlaceholder
      } from '../lib/recall-sources';
      import { initImageFallbacks } from '../lib/image-fallback';
      import { initProgressiveCardImages } from '../lib/progressive-detail-image';
      import { formatUiMessage, getCurrentUiLanguage, getMessage, type MessageKey } from '../lib/i18n';
      import { getAudienceLabel, getRecallDomainLabel } from '../lib/taxonomy-v2-display';
      import {
        clearWatchlist,
        loadWatchlist,
        removeWatchlistItem,
        type WatchlistAudienceFilter,
        type WatchlistBrandItem,
        type WatchlistCategoryFilter,
        type WatchlistItem,
        type WatchlistRecallDomainFilter,
        type WatchlistSearchItem
      } from '../lib/watchlist';

      initProgressiveCardImages();
      initImageFallbacks();

      const dataNode = document.querySelector<HTMLScriptElement>('#watchlist-recall-data');
      const siteRecalls = dataNode?.textContent
        ? (JSON.parse(dataNode.textContent) as Parameters<typeof searchRecalls>[1])
        : [];
      const countLabel = document.querySelector<HTMLElement>('#watchlist-count');
      const clearButton = document.querySelector<HTMLButtonElement>('#clear-watchlist');
      const emptyWatchlist = document.querySelector<HTMLElement>('#empty-watchlist');
      const itemsContainer = document.querySelector<HTMLElement>('#watchlist-items');
      const demoAlertForm = document.querySelector<HTMLFormElement>('#demo-alert-form');
      const demoAlertStatus = document.querySelector<HTMLElement>('#demo-alert-status');

      type WatchlistRecall = (typeof siteRecalls)[number];
      type RecallCardImageFields = {
        cardImageUrl?: string;
        cardImageAlt?: string;
      };
      type WatchlistPreviewItem = {
        recall: WatchlistRecall;
        matchLabel?: string;
        matchReasonLabel?: string;
        identifierHint?: string;
      };

      function uiMessage(key: MessageKey): string {
        return getMessage(key, getCurrentUiLanguage());
      }

      function uiTemplate(key: MessageKey, values: Record<string, string | number>): string {
        return formatUiMessage(key, values, getCurrentUiLanguage());
      }

      function filterRecallsForSearch(item: WatchlistSearchItem): typeof siteRecalls {
        const domain = item.domain ?? 'all';
        const audience = item.audience ?? 'all';

        return siteRecalls.filter((recall) => {
          const sourceMatches = item.source === 'all' || recall.source === item.source;
          const family = recall.taxonomyProductFamily ?? '';
          const domainMatches = domain === 'all' || recall.taxonomyRecallDomain === domain;
          const audienceMatches = audience === 'all' || (recall.taxonomyAudience ?? []).includes(audience);
          const categoryMatches =
            item.category === 'all' ||
            family === item.category ||
            (item.category === 'food' && (family === 'food-grocery' || recall.category === 'food-allergy')) ||
            (item.category === 'food-allergy' && family === 'food-grocery') ||
            (item.category === 'battery-electronics' && family === 'electronics-batteries') ||
            (item.category === 'household-appliance' &&
              ['home-appliances', 'furniture-household', 'chemicals-cleaning'].includes(family)) ||
            (item.category === 'general' && recall.category === 'general-consumer-product') ||
            recall.category === item.category;

          return sourceMatches && categoryMatches && domainMatches && audienceMatches;
        });
      }

      function categoryLabel(category: WatchlistCategoryFilter): string {
        if (category === 'all') {
          return uiMessage('common.allCategories');
        }

        if (category === 'general') {
          return uiMessage('common.general');
        }

        return category.replace(/-/g, ' ');
      }

      function sourceLabel(source: WatchlistSearchItem['source']): string {
        return source === 'all' ? uiMessage('common.allMarkets') : getRecallSourceLabel(source);
      }

      function domainLabel(domain: WatchlistRecallDomainFilter | undefined): string | null {
        return domain && domain !== 'all' ? getRecallDomainLabel(domain) : null;
      }

      function audienceLabel(audience: WatchlistAudienceFilter | undefined): string | null {
        return audience && audience !== 'all' ? getAudienceLabel(audience) : null;
      }

      function createTag(text: string, className = 'tag'): HTMLElement {
        const tag = document.createElement('span');
        tag.className = className;
        tag.textContent = text;
        return tag;
      }

      function createImageShell(recall: WatchlistRecall & RecallCardImageFields): HTMLElement {
        const link = document.createElement('a');
        link.className = 'image-shell';
        link.href = recall.detailPath;
        link.setAttribute('aria-label', uiTemplate('common.viewRecallFor', { title: recall.title }));
        const fallbackLabel = getRecallSourcePlaceholder(recall.source);

        const imageUrl = recall.cardImageUrl || recall.primaryImageUrl;
        const imageAlt = recall.cardImageAlt || recall.primaryImageAlt || recall.title;

        if (imageUrl) {
          const image = document.createElement('img');
          image.src = imageUrl;
          image.alt = imageAlt;
          image.loading = 'lazy';
          image.setAttribute('decoding', 'async');
          image.dataset.fallbackLabel = fallbackLabel;

          const placeholder = document.createElement('span');
          placeholder.className = 'image-placeholder image-placeholder-fallback';
          placeholder.textContent = fallbackLabel;
          placeholder.hidden = true;

          image.addEventListener('error', () => {
            image.hidden = true;
            placeholder.hidden = false;
            link.classList.add('image-shell-fallback');
          });

          link.append(image, placeholder);
          return link;
        }

        const placeholder = document.createElement('span');
        placeholder.className = 'image-placeholder';
        placeholder.textContent = fallbackLabel;
        link.append(placeholder);
        return link;
      }

      function reasonLabelFor(recall: WatchlistRecall): string {
        return getRecallReasonLabel(recall.source);
      }

      function reasonTextFor(recall: WatchlistRecall): string {
        return recall.hazard || recall.reason || uiMessage('checker.notListedInNotice');
      }

      function actionTextFor(recall: WatchlistRecall): string {
        return recall.remedy || getRecallDefaultActionFallback(recall.source);
      }

      function createCardLine(label: string, value: string, className = 'result-card-line'): HTMLElement {
        const line = document.createElement('p');
        line.className = className;
        const strong = document.createElement('strong');
        strong.textContent = `${label}: `;
        line.append(strong, value);
        return line;
      }

      function createRecallPreview(item: WatchlistPreviewItem): HTMLElement {
        const { recall } = item;
        const article = document.createElement('article');
        article.className = 'product-card result-card';

        const body = document.createElement('div');
        body.className = 'card-body';

        const meta = document.createElement('div');
        meta.className = 'meta-row result-card-badges';
        if (item.matchLabel) {
          meta.append(createTag(item.matchLabel, 'badge-danger'));
        }
        meta.append(
          createTag(recall.sourceLabel, 'badge-source'),
          createTag(recall.taxonomyProductFamilyLabel || recall.categoryLabel),
          ...(recall.taxonomyHazardTypeLabel ? [createTag(recall.taxonomyHazardTypeLabel, 'badge-danger')] : []),
          createTag(recall.recallDate, 'badge-date')
        );

        const heading = document.createElement('h3');
        const link = document.createElement('a');
        link.href = recall.detailPath;
        link.textContent = recall.title;
        heading.append(link);

        const reason = createCardLine(reasonLabelFor(recall), reasonTextFor(recall), 'result-card-line result-card-reason');
        const action = createCardLine(getRecallActionLabel(recall.source), actionTextFor(recall), 'result-card-line result-card-action');
        const product = createCardLine(uiMessage('common.product'), recall.primaryProductName);
        const brand = createCardLine(uiMessage('common.brandCompany'), recall.primaryBrand);
        const taxonomy = createCardLine(
          uiMessage('common.classification'),
          [recall.taxonomyProductFamilyLabel, recall.taxonomyProductTypeLabel, recall.taxonomyHazardTypeLabel]
            .filter(Boolean)
            .join(' / ') || recall.categoryLabel,
          'result-card-line taxonomy-card-line'
        );
        const matchReason = item.matchReasonLabel
          ? createCardLine(uiMessage('common.matchReason'), item.matchReasonLabel, 'result-card-line match-reason-line')
          : null;
        const identifierHint = document.createElement('p');
        identifierHint.className = 'identifier-hint';
        identifierHint.textContent = item.identifierHint ?? getRecallIdentifierHint(recall);

        const details = document.createElement('a');
        details.className = 'btn btn-primary';
        details.href = recall.detailPath;
        details.textContent = uiMessage('common.viewRecall');

        body.append(
          heading,
          reason,
          action,
          product,
          brand,
          taxonomy,
          ...(matchReason ? [matchReason] : []),
          identifierHint,
          meta,
          details
        );
        article.append(createImageShell(recall), body);
        return article;
      }

      function brandMatches(item: WatchlistBrandItem, recall: WatchlistRecall): boolean {
        const normalizedBrand = item.brand.toLowerCase();
        return (
          recall.primaryBrandSlug === item.slug ||
          recall.displayBrandNames.some((brand) => brand.toLowerCase() === normalizedBrand) ||
          recall.brandNames.some((brand) => brand.toLowerCase() === normalizedBrand)
        );
      }

      function matchingRecallsForItem(item: WatchlistItem): WatchlistPreviewItem[] {
        if (item.type === 'search') {
          return searchRecalls(item.query, filterRecallsForSearch(item)).items
            .map((result) => ({
              recall: result.recall,
              matchLabel: MATCH_LABELS[result.match],
              matchReasonLabel: result.matchReasonLabel,
              identifierHint: result.identifierHint
            }))
            .slice(0, 4);
        }

        return siteRecalls
          .filter((recall) => brandMatches(item, recall))
          .map((recall) => ({
            recall,
            matchReasonLabel: uiMessage('search.matchedByBrand'),
            identifierHint: getRecallIdentifierHint(recall)
          }))
          .slice(0, 4);
      }

      function createSavedItemCard(item: WatchlistItem): HTMLElement {
        const article = document.createElement('article');
        article.className = 'detail-card watchlist-item';

        const header = document.createElement('div');
        header.className = 'watchlist-item-header';

        const title = document.createElement('div');
        const heading = document.createElement('h3');
        heading.textContent = item.type === 'search' ? item.query : item.brand;
        const details = document.createElement('p');
        details.textContent =
          item.type === 'search'
            ? [
                sourceLabel(item.source),
                categoryLabel(item.category),
                domainLabel(item.domain),
                audienceLabel(item.audience)
              ]
                .filter((value): value is string => Boolean(value))
                .join(' / ')
            : uiTemplate('watchlist.brandPagePath', { path: `/brands/${item.slug}` });
        title.append(heading, details);

        const remove = document.createElement('button');
        remove.className = 'btn btn-secondary';
        remove.type = 'button';
        remove.textContent = uiMessage('common.remove');
        remove.addEventListener('click', () => {
          removeWatchlistItem(item.id);
          renderWatchlist();
        });

        header.append(title, remove);

        const matches = matchingRecallsForItem(item);
        const list = document.createElement('div');
        list.className = 'product-grid';
        if (matches.length) {
          list.replaceChildren(...matches.map(createRecallPreview));
        } else {
          const empty = document.createElement('p');
          empty.textContent = getNoResultIdentifierHint();
          list.append(empty);
        }

        const disclaimer = document.createElement('p');
        disclaimer.className = 'disclaimer-copy';
        disclaimer.textContent = SEARCH_RESULTS_DISCLAIMER;

        article.append(header, list, disclaimer);
        return article;
      }

      function renderWatchlist(): void {
        if (!countLabel || !emptyWatchlist || !itemsContainer || !clearButton) {
          return;
        }

        const state = loadWatchlist();
        countLabel.textContent = uiTemplate('common.savedItemsCount', { count: state.items.length });
        clearButton.disabled = state.items.length === 0;
        emptyWatchlist.hidden = state.items.length > 0;
        itemsContainer.replaceChildren(...state.items.map(createSavedItemCard));
        initProgressiveCardImages();
      }

      clearButton?.addEventListener('click', () => {
        clearWatchlist();
        renderWatchlist();
      });

      demoAlertForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (demoAlertStatus) {
          demoAlertStatus.hidden = false;
          demoAlertStatus.textContent = uiMessage('watchlist.noEmailStored');
        }
      });

      document.querySelectorAll<HTMLSelectElement>('[data-ui-language-select]').forEach((select) => {
        select.addEventListener('change', renderWatchlist);
      });

      renderWatchlist();
    </script>
  </body>
</html>
