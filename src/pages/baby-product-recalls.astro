---
import { getRecallsByCategory } from '../lib/recall-data';
import '../styles/global.css';

const title = 'Baby Product Recalls | Recall Radar';
const description =
  'Browse local CPSC Baby Product Recalls in Recall Radar, including cribs, nursery products, and kids safety notices.';
const recalls = getRecallsByCategory('baby-kids');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/baby-product-recalls">Baby Product Recalls</a>
        <a href="/battery-recalls">Battery & Electronics Recalls</a>
        <a href="/food-allergy-recalls">Food Allergy Recalls</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow">Recall category</p>
        <div class="meta-row data-source-row">
          <span class="status-pill">Local CPSC data</span>
          <span class="tag">{recalls.length} record{recalls.length === 1 ? '' : 's'}</span>
        </div>
        <h1>Baby Product Recalls</h1>
        <p class="lead">Local recall pages for baby, infant, nursery, and kids products.</p>
      </section>

      <section class="section">
        {recalls.length ? (
          <div class="grid">
            {recalls.map((recall) => (
              <article class="recall-card">
                <div class="meta-row">
                  <span class="tag source-tag">{recall.sourceLabel}</span>
                  <span class="tag">{recall.recallDate}</span>
                </div>
                <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                <p>Product: {recall.primaryProductName}</p>
                <p>Brand/company: {recall.primaryBrand}</p>
                <p>Hazard: {recall.hazard || 'Not listed in local data'}</p>
                <div class="link-row">
                  {recall.primaryBrandSlug ? (
                    <a href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} recall page</a>
                  ) : null}
                  <a href={recall.detailPath}>Details</a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="notice-panel">
            <p>No local CPSC records are currently classified in this category.</p>
          </div>
        )}
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar uses local CPSC and FDA/openFDA processed data when available and local mock fallback data otherwise. Always verify against official recall notices.
    </footer>
  </body>
</html>
