---
import { getRecallsByCategory } from '../lib/recall-data';
import '../styles/global.css';

const title = 'Baby & Kids Product Recalls | Recall Radar';
const description =
  'Browse local CPSC baby and kids product recalls in Recall Radar, including cribs, nursery products, toys, and child-focused notices.';
const recalls = getRecallsByCategory('baby-kids');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby & Kids</a>
        <a href="/battery-recalls">Batteries & Electronics</a>
        <a href="/food-allergy-recalls">Food & Allergy</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow">Baby & Kids</p>
        <div class="meta-row data-source-row">
          <span class="badge-source">Local CPSC data</span>
          <span class="badge-date">{recalls.length} record{recalls.length === 1 ? '' : 's'}</span>
        </div>
        <h1>Baby & Kids product recalls</h1>
        <p class="lead">A conservative local category for baby, infant, nursery, toy, and kids product recalls.</p>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <h2>Matching local records</h2>
            <p class="section-note">Shown only when local classification identifies a baby or kids product recall.</p>
          </div>
        </div>
        {recalls.length ? (
          <div class="product-grid">
            {recalls.map((recall) => (
              <article class="product-card">
                <a class="image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                  {recall.primaryImageUrl ? (
                    <img src={recall.primaryImageUrl} alt={recall.primaryImageAlt || recall.title} loading="lazy" />
                  ) : (
                    <span class="image-placeholder">Recall notice</span>
                  )}
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{recall.sourceLabel}</span>
                    <span class="badge-date">{recall.recallDate}</span>
                  </div>
                  <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                  <p>{recall.hazard || recall.reason || 'Hazard/reason not listed in local data'}</p>
                  <div class="link-row">
                    {recall.primaryBrandSlug ? (
                      <a class="btn btn-ghost" href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} page</a>
                    ) : null}
                    <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="notice-panel">
            <p>No local CPSC records are currently classified in this category.</p>
          </div>
        )}
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar uses local CPSC and FDA/openFDA processed data when available and local mock fallback data otherwise. Always verify against official recall notices.
    </footer>
  </body>
</html>
