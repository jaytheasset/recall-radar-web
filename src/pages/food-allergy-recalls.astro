---
import { getRecallsByCategory } from '../lib/recall-data';
import '../styles/global.css';

const title = 'Food & Allergy Recalls | Recall Radar';
const description =
  'Browse local FDA/openFDA and CPSC food and allergy recalls in Recall Radar, including undeclared allergens, packaged foods, UPCs, and lot codes.';
const recalls = getRecallsByCategory('food-allergy').sort((a, b) => {
  if (a.source !== b.source) {
    return a.source === 'FDA' ? -1 : 1;
  }

  return b.recallDate.localeCompare(a.recallDate);
});
const fdaRecalls = recalls.filter((recall) => recall.source === 'FDA');
const cpscRelevantRecalls = recalls.filter((recall) => recall.source === 'CPSC');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby & Kids</a>
        <a href="/battery-recalls">Batteries & Electronics</a>
        <a href="/food-allergy-recalls">Food & Allergy</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow">Food & Allergy</p>
        <div class="meta-row data-source-row">
          <span class="badge-source">Local FDA/openFDA + CPSC data</span>
          <span class="badge-date">{recalls.length} record{recalls.length === 1 ? '' : 's'}</span>
          <span class="tag">{fdaRecalls.length} FDA/openFDA food</span>
          <span class="tag">{cpscRelevantRecalls.length} relevant CPSC</span>
        </div>
        <h1>Food & Allergy recalls</h1>
        <p class="lead">A conservative local category focused on FDA/openFDA food records, undeclared allergens, UPCs, lot codes, and packaged food notices.</p>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <h2>FDA/openFDA food recalls</h2>
            <p class="section-note">Food and allergen notices from the local FDA/openFDA processed data.</p>
          </div>
          <span class="badge-date">{fdaRecalls.length} record{fdaRecalls.length === 1 ? '' : 's'}</span>
        </div>
        {fdaRecalls.length ? (
          <div class="product-grid">
            {fdaRecalls.map((recall) => (
              <article class="product-card">
                <a class="image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                  <span class="image-placeholder">FDA food notice</span>
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{recall.sourceLabel}</span>
                    <span class="badge-date">{recall.recallDate}</span>
                  </div>
                  <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                  <p>{recall.hazard || recall.reason || 'Hazard/reason not listed in local data'}</p>
                  <div class="link-row">
                    {recall.primaryBrandSlug ? (
                      <a class="btn btn-ghost" href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} page</a>
                    ) : null}
                    <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="notice-panel">
            <p>No local FDA/openFDA records are currently classified in this category.</p>
          </div>
        )}
      </section>

      {cpscRelevantRecalls.length ? (
        <section class="section">
          <div class="section-header">
            <div>
              <h2>Relevant CPSC food and allergy recalls</h2>
              <p class="section-note">CPSC records shown only when local classification finds a food or allergy recall.</p>
            </div>
            <span class="badge-date">{cpscRelevantRecalls.length} record{cpscRelevantRecalls.length === 1 ? '' : 's'}</span>
          </div>
          <div class="product-grid">
            {cpscRelevantRecalls.map((recall) => (
              <article class="product-card">
                <a class="image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                  {recall.primaryImageUrl ? (
                    <img src={recall.primaryImageUrl} alt={recall.primaryImageAlt || recall.title} loading="lazy" />
                  ) : (
                    <span class="image-placeholder">Recall notice</span>
                  )}
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{recall.sourceLabel}</span>
                    <span class="badge-date">{recall.recallDate}</span>
                  </div>
                  <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                  <p>{recall.hazard || recall.reason || 'Hazard/reason not listed in local data'}</p>
                  <div class="link-row">
                    {recall.primaryBrandSlug ? (
                      <a class="btn btn-ghost" href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} page</a>
                    ) : null}
                    <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ) : null}
    </main>

    <footer class="page-footer">
      Recall Radar uses local CPSC and FDA/openFDA processed data when available and local mock fallback data otherwise. Always verify against official recall notices.
    </footer>
  </body>
</html>
