---
import { getRecallsByCategory } from '../lib/recall-data';
import '../styles/global.css';

const title = 'Food & Allergy Recall Signals | Recall Radar';
const description =
  'Scan local FDA/openFDA and CPSC food and allergy recall signals in Recall Radar, including undeclared allergens, packaged foods, and grocery products.';
const recalls = getRecallsByCategory('food-allergy').sort((a, b) => {
  if (a.source !== b.source) {
    return a.source === 'FDA' ? -1 : 1;
  }

  return b.recallDate.localeCompare(a.recallDate);
});
const fdaRecalls = recalls.filter((recall) => recall.source === 'FDA');
const cpscRelevantRecalls = recalls.filter((recall) => recall.source === 'CPSC');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby & Kids</a>
        <a href="/battery-recalls">Batteries & Electronics</a>
        <a href="/food-allergy-recalls">Food & Allergy</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow">Scan zone</p>
        <div class="meta-row data-source-row">
          <span class="status-pill">Local FDA/openFDA + CPSC data</span>
          <span class="tag">{recalls.length} record{recalls.length === 1 ? '' : 's'}</span>
          <span class="tag">{fdaRecalls.length} FDA/openFDA food</span>
          <span class="tag">{cpscRelevantRecalls.length} CPSC food/allergy</span>
        </div>
        <h1>Food & Allergy Recall Signals</h1>
        <p class="lead">A conservative local scan zone focused on FDA/openFDA food records, undeclared allergens, and packaged food notices. Relevant CPSC food/allergy records remain visible when classified locally.</p>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <h2>FDA/openFDA food signals</h2>
            <p class="section-note">Food and allergen signals from the local FDA/openFDA processed data.</p>
          </div>
          <span class="tag">{fdaRecalls.length} record{fdaRecalls.length === 1 ? '' : 's'}</span>
        </div>
        {fdaRecalls.length ? (
          <div class="grid">
            {fdaRecalls.map((recall) => (
              <article class="recall-card signal-card">
                <div class="meta-row">
                  <span class="tag source-tag">{recall.sourceLabel}</span>
                  <span class="tag">{recall.recallDate}</span>
                </div>
                <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                <p>Product: {recall.primaryProductName}</p>
                <p>Brand/company: {recall.primaryBrand}</p>
                <p>Hazard: {recall.hazard || 'Not listed in local data'}</p>
                <div class="link-row">
                  {recall.primaryBrandSlug ? (
                    <a href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} monitor page</a>
                  ) : null}
                  <a href={recall.detailPath}>Signal report</a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="notice-panel">
            <p>No local FDA/openFDA records are currently classified in this scan zone.</p>
          </div>
        )}
      </section>

      {cpscRelevantRecalls.length ? (
        <section class="section">
          <div class="section-header">
            <div>
              <h2>Relevant CPSC food/allergy signals</h2>
              <p class="section-note">CPSC records shown only when local classification finds a food or allergy signal.</p>
            </div>
            <span class="tag">{cpscRelevantRecalls.length} record{cpscRelevantRecalls.length === 1 ? '' : 's'}</span>
          </div>
          <div class="grid">
            {cpscRelevantRecalls.map((recall) => (
              <article class="recall-card signal-card">
                <div class="meta-row">
                  <span class="tag source-tag">{recall.sourceLabel}</span>
                  <span class="tag">{recall.recallDate}</span>
                </div>
                <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                <p>Product: {recall.primaryProductName}</p>
                <p>Brand/company: {recall.primaryBrand}</p>
                <p>Hazard signal: {recall.hazard || 'Not listed in local data'}</p>
                <div class="link-row">
                  {recall.primaryBrandSlug ? (
                    <a href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} monitor page</a>
                  ) : null}
                  <a href={recall.detailPath}>Signal report</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      ) : null}
    </main>

    <footer class="page-footer">
      Recall Radar uses local CPSC and FDA/openFDA processed data when available and local mock fallback data otherwise. Always verify against official recall notices.
    </footer>
  </body>
</html>
