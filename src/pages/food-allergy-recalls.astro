---
import { getRecallsByCategory } from '../lib/recall-data';
import { categorySearchTextFor } from '../lib/category-search';
import { getRecallSourceLabel, getRecallSourcePlaceholder } from '../lib/recall-sources';
import '../styles/global.css';

const title = 'Food & Allergy Recalls | Recall Radar';
const description =
  'Browse food and allergy recall notices in Recall Radar, including undeclared allergens, packaged foods, UPCs, and lot codes.';
const recalls = getRecallsByCategory('food-allergy').sort((a, b) => {
  if (a.source !== b.source) {
    return a.source === 'FDA' ? -1 : 1;
  }

  return b.recallDate.localeCompare(a.recallDate);
});
const fdaRecalls = recalls.filter((recall) => recall.source === 'FDA');
const ukFsaRecalls = recalls.filter((recall) => recall.source === 'UK_FSA');
const franceRecalls = recalls.filter((recall) => recall.source === 'FR_RAPPELCONSO');
const canadaRecalls = recalls.filter((recall) => recall.source === 'CA_RECALLS');
const cpscRelevantRecalls = recalls.filter((recall) => recall.source === 'CPSC');
const fdaSourceLabel = getRecallSourceLabel('FDA');
const ukFsaSourceLabel = getRecallSourceLabel('UK_FSA');
const franceSourceLabel = getRecallSourceLabel('FR_RAPPELCONSO');
const canadaSourceLabel = getRecallSourceLabel('CA_RECALLS');
const cpscSourceLabel = getRecallSourceLabel('CPSC');
const searchPlaceholder = 'Search food, brand, ingredient, allergen, lot code, or keyword';
const noResultCopy =
  'No indexed notices match this search in this product type. This does not mean the product is safe or recall-free. Try another brand, model, barcode, ingredient, allergen, or keyword.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby & Kids</a>
        <a href="/battery-recalls">Batteries & Electronics</a>
        <a href="/food-allergy-recalls">Food & Allergy</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow">Food & Allergy</p>
        <div class="meta-row data-source-row">
          <span class="badge-source">Product type</span>
          <span class="badge-date">{recalls.length} indexed notice{recalls.length === 1 ? '' : 's'}</span>
          <span class="tag">{fdaRecalls.length} {fdaSourceLabel}</span>
          <span class="tag">{ukFsaRecalls.length} {ukFsaSourceLabel}</span>
          <span class="tag">{franceRecalls.length} {franceSourceLabel}</span>
          <span class="tag">{canadaRecalls.length} {canadaSourceLabel}</span>
          <span class="tag">{cpscRelevantRecalls.length} {cpscSourceLabel}</span>
        </div>
        <h1>Food & Allergy recalls</h1>
        <p class="lead">Food, allergen, UPC, lot code, and packaged goods recall notices.</p>
      </section>

      <section class="section category-search-panel" data-category-search-root data-category-total={recalls.length}>
        <form class="category-search-form" data-category-search-form>
          <label>
            Search within Food & Allergy
            <input data-category-search-input type="search" placeholder={searchPlaceholder} autocomplete="off" />
          </label>
          <button class="btn btn-primary" type="submit">Search this type</button>
          <button class="btn btn-secondary" type="button" data-category-search-clear hidden>Clear</button>
        </form>
        <div class="category-search-status">
          <span class="status-pill" data-category-result-count>
            {recalls.length} of {recalls.length} indexed notice{recalls.length === 1 ? '' : 's'} shown
          </span>
        </div>
        <div class="notice-panel category-no-results" data-category-no-results hidden>
          <p>{noResultCopy}</p>
        </div>
      </section>

      <section class="section" data-category-group>
        <div class="section-header">
          <div>
            <h2>FDA/openFDA food recalls</h2>
            <p class="section-note">Food and allergen notices from {fdaSourceLabel}.</p>
          </div>
          <span class="badge-date">{fdaRecalls.length} indexed notice{fdaRecalls.length === 1 ? '' : 's'}</span>
        </div>
        {fdaRecalls.length ? (
          <div class="product-grid">
            {fdaRecalls.map((recall) => (
              <article class="product-card" data-category-card data-search-text={categorySearchTextFor(recall)}>
                <a class="image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                  <span class="image-placeholder">{getRecallSourcePlaceholder(recall.source)}</span>
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{recall.sourceLabel}</span>
                    <span class="badge-date">{recall.recallDate}</span>
                  </div>
                  <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                  <p>{recall.hazard || recall.reason || 'Hazard or reason not listed in the indexed notice.'}</p>
                  <div class="link-row">
                    {recall.primaryBrandSlug ? (
                      <a class="btn btn-ghost" href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} page</a>
                    ) : null}
                    <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="notice-panel">
            <p>No indexed notices are currently classified in this product type.</p>
          </div>
        )}
      </section>

      {ukFsaRecalls.length ? (
        <section class="section" data-category-group>
          <div class="section-header">
            <div>
              <h2>UK FSA food alerts</h2>
              <p class="section-note">Food, allergy, and food action alerts from {ukFsaSourceLabel}.</p>
            </div>
            <span class="badge-date">{ukFsaRecalls.length} indexed notice{ukFsaRecalls.length === 1 ? '' : 's'}</span>
          </div>
          <div class="product-grid">
            {ukFsaRecalls.map((recall) => (
              <article class="product-card" data-category-card data-search-text={categorySearchTextFor(recall)}>
                <a class="image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                  <span class="image-placeholder">{getRecallSourcePlaceholder(recall.source)}</span>
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{recall.sourceLabel}</span>
                    <span class="badge-date">{recall.recallDate}</span>
                  </div>
                  <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                  <p>{recall.hazard || recall.reason || 'Hazard or reason not listed in the indexed notice.'}</p>
                  <div class="link-row">
                    {recall.primaryBrandSlug ? (
                      <a class="btn btn-ghost" href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} page</a>
                    ) : null}
                    <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ) : null}

      {franceRecalls.length ? (
        <section class="section" data-category-group>
          <div class="section-header">
            <div>
              <h2>France RappelConso food recalls</h2>
              <p class="section-note">Food and product notices from {franceSourceLabel}.</p>
            </div>
            <span class="badge-date">{franceRecalls.length} indexed notice{franceRecalls.length === 1 ? '' : 's'}</span>
          </div>
          <div class="product-grid">
            {franceRecalls.map((recall) => (
              <article class="product-card" data-category-card data-search-text={categorySearchTextFor(recall)}>
                <a class="image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                  {recall.primaryImageUrl ? (
                    <>
                      <img
                        src={recall.primaryImageUrl}
                        alt={recall.primaryImageAlt || recall.title}
                        loading="lazy"
                        data-fallback-label={getRecallSourcePlaceholder(recall.source)}
                      />
                      <span class="image-placeholder image-placeholder-fallback" hidden>
                        {getRecallSourcePlaceholder(recall.source)}
                      </span>
                    </>
                  ) : (
                    <span class="image-placeholder">{getRecallSourcePlaceholder(recall.source)}</span>
                  )}
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{recall.sourceLabel}</span>
                    <span class="badge-date">{recall.recallDate}</span>
                  </div>
                  <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                  <p>{recall.hazard || recall.reason || 'Hazard or reason not listed in the indexed notice.'}</p>
                  <div class="link-row">
                    {recall.primaryBrandSlug ? (
                      <a class="btn btn-ghost" href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} page</a>
                    ) : null}
                    <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ) : null}

      {canadaRecalls.length ? (
        <section class="section" data-category-group>
          <div class="section-header">
            <div>
              <h2>Canada food and allergy recalls</h2>
              <p class="section-note">Food and safety alert notices from {canadaSourceLabel}.</p>
            </div>
            <span class="badge-date">{canadaRecalls.length} indexed notice{canadaRecalls.length === 1 ? '' : 's'}</span>
          </div>
          <div class="product-grid">
            {canadaRecalls.map((recall) => (
              <article class="product-card" data-category-card data-search-text={categorySearchTextFor(recall)}>
                <a class="image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                  <span class="image-placeholder">{getRecallSourcePlaceholder(recall.source)}</span>
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{recall.sourceLabel}</span>
                    <span class="badge-date">{recall.recallDate}</span>
                  </div>
                  <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                  <p>{recall.hazard || recall.reason || 'Hazard or reason not listed in the indexed notice.'}</p>
                  <div class="link-row">
                    {recall.primaryBrandSlug ? (
                      <a class="btn btn-ghost" href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} page</a>
                    ) : null}
                    <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ) : null}

      {cpscRelevantRecalls.length ? (
        <section class="section" data-category-group>
          <div class="section-header">
            <div>
              <h2>Relevant CPSC food and allergy recalls</h2>
              <p class="section-note">CPSC notices shown only when classification finds a food or allergy recall.</p>
            </div>
            <span class="badge-date">{cpscRelevantRecalls.length} indexed notice{cpscRelevantRecalls.length === 1 ? '' : 's'}</span>
          </div>
          <div class="product-grid">
            {cpscRelevantRecalls.map((recall) => (
              <article class="product-card" data-category-card data-search-text={categorySearchTextFor(recall)}>
                <a class="image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                  {recall.primaryImageUrl ? (
                    <>
                      <img
                        src={recall.primaryImageUrl}
                        alt={recall.primaryImageAlt || recall.title}
                        loading="lazy"
                        data-fallback-label={getRecallSourcePlaceholder(recall.source)}
                      />
                      <span class="image-placeholder image-placeholder-fallback" hidden>
                        {getRecallSourcePlaceholder(recall.source)}
                      </span>
                    </>
                  ) : (
                    <span class="image-placeholder">{getRecallSourcePlaceholder(recall.source)}</span>
                  )}
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{recall.sourceLabel}</span>
                    <span class="badge-date">{recall.recallDate}</span>
                  </div>
                  <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                  <p>{recall.hazard || recall.reason || 'Hazard or reason not listed in the indexed notice.'}</p>
                  <div class="link-row">
                    {recall.primaryBrandSlug ? (
                      <a class="btn btn-ghost" href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} page</a>
                    ) : null}
                    <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ) : null}
    </main>

    <footer class="page-footer">
      Recall Radar helps you find possible recall notices. Search results are not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.
    </footer>
    <script>
      import { initCategoryPageSearch } from '../lib/category-page-search';
      import { initImageFallbacks } from '../lib/image-fallback';

      initImageFallbacks();
      initCategoryPageSearch();
    </script>
  </body>
</html>
