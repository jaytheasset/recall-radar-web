---
import SourceLandingPage from '../components/SourceLandingPage.astro';
import { getSourceLandingPageByRoute, getSourceLandingPageRecalls } from '../lib/source-landing-pages';

const page = getSourceLandingPageByRoute('/australia-product-recalls');

if (!page) {
  throw new Error('Missing Australia source landing page config.');
}

const recalls = getSourceLandingPageRecalls(page);
---

<SourceLandingPage page={page} recalls={recalls} />
