---
import { brandGroups } from '../../lib/recall-data';
import { getRecallSourcePlaceholder } from '../../lib/recall-sources';
import '../../styles/global.css';

export function getStaticPaths() {
  return brandGroups.map((group) => ({
    params: { brand: group.slug },
    props: group
  }));
}

const { brand, rawNames, recalls, slug } = Astro.props;
const sourceNames = rawNames.filter(
  (rawName: string) => rawName.toLowerCase() !== brand.toLowerCase()
);
const sourceLabels = [...new Set(recalls.map((recall: { sourceLabel: string }) => recall.sourceLabel))];
const sourceLabel = sourceLabels.join(' + ');
const title = `Recalls linked to ${brand} | Recall Radar`;
const description = `Indexed recall notices linked to ${brand}, with related products, source company names, hazards, remedies, and official detail links.`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby & Kids</a>
        <a href="/battery-recalls">Batteries & Electronics</a>
        <a href="/food-allergy-recalls">Food & Allergy</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow">Brand page</p>
        <div class="meta-row data-source-row">
          <span class="badge-source">{sourceLabel}</span>
          <span class="badge-date">{recalls.length} indexed notice{recalls.length === 1 ? '' : 's'}</span>
        </div>
        <h1>Recalls linked to {brand}</h1>
        <p class="lead">Indexed recall notices linked to this brand, company, importer, recalling firm, or related product name.</p>
        <div class="link-row data-source-row">
          <button class="btn btn-primary" id="save-brand-watchlist" type="button" data-brand={brand} data-brand-slug={slug}>
            Save this brand in this browser
          </button>
          <a class="btn btn-secondary" href="/watchlist">View watchlist</a>
        </div>
        <p id="save-brand-status" class="form-note" hidden></p>
      </section>

      {sourceNames.length ? (
        <section class="section">
          <article class="detail-card">
            <h2>Official source names</h2>
            <p>Official notices may list a brand, importer, recalling firm, or legal company name differently.</p>
            <ul class="source-name-list">
              {sourceNames.map((name: string) => <li>{name}</li>)}
            </ul>
          </article>
        </section>
      ) : null}

      <section class="section">
        <div class="section-header">
          <div>
            <p class="eyebrow">Indexed brand notices</p>
            <h2>Indexed notices linked to this brand/company</h2>
            <p class="section-note">Cards are based on indexed notices connected to this brand/company page.</p>
          </div>
        </div>
        <div class="product-grid">
          {recalls.map((recall) => (
            <article class="product-card">
              <a class="image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                {recall.primaryImageUrl ? (
                  <img src={recall.primaryImageUrl} alt={recall.primaryImageAlt || recall.title} loading="lazy" />
                ) : (
                  <span class="image-placeholder">{getRecallSourcePlaceholder(recall.source)}</span>
                )}
              </a>
              <div class="card-body">
                <div class="meta-row">
                  <span class="badge-source">{recall.sourceLabel}</span>
                  <span class="badge-date">{recall.recallDate}</span>
                </div>
                <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                <p>{recall.hazard || recall.reason || 'Hazard or reason not listed in the indexed notice.'}</p>
                <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <a class="btn btn-secondary" href="/checker">Check another product</a>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar helps you find possible recall notices. Search results are not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.
    </footer>
    <script>
      import { upsertWatchlistBrand } from '../../lib/watchlist';

      const saveBrandButton = document.querySelector<HTMLButtonElement>('#save-brand-watchlist');
      const saveBrandStatus = document.querySelector<HTMLElement>('#save-brand-status');

      saveBrandButton?.addEventListener('click', () => {
        const brand = saveBrandButton.dataset.brand ?? '';
        const slug = saveBrandButton.dataset.brandSlug ?? '';
        if (!brand || !slug || !saveBrandStatus) {
          return;
        }

        const item = upsertWatchlistBrand({ brand, slug });
        saveBrandStatus.hidden = false;
        saveBrandStatus.textContent = `Saved ${item.brand} in this browser.`;
      });
    </script>
  </body>
</html>
