---
import SiteHeader from '../../components/SiteHeader.astro';
import EuImageResourceHints from '../../components/EuImageResourceHints.astro';
import RecallListCard from '../../components/RecallListCard.astro';
import { brandGroups } from '../../lib/recall-data';
import '../../styles/global.css';

export function getStaticPaths() {
  return brandGroups.map((group) => ({
    params: { brand: group.slug },
    props: group
  }));
}

const { brand, rawNames, recalls, slug } = Astro.props;
const sourceNames = rawNames.filter(
  (rawName: string) => rawName.toLowerCase() !== brand.toLowerCase()
);
const sourceLabels = [...new Set(recalls.map((recall: { sourceLabel: string }) => recall.sourceLabel))];
const sourceLabel = sourceLabels.join(' + ');
const title = `Recalls linked to ${brand} | Recall Radar`;
const description = `Recall notices linked to ${brand}, with related products, source company names, hazards, remedies, and official detail links.`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <EuImageResourceHints />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteHeader />

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow">Brand page</p>
        <div class="meta-row data-source-row">
          <span class="badge-source">{sourceLabel}</span>
          <span class="badge-date">{recalls.length} recall notice{recalls.length === 1 ? '' : 's'}</span>
        </div>
        <h1>Recalls linked to {brand}</h1>
        <p class="lead">Recall notices linked to this brand, company, importer, recalling firm, or related product name.</p>
        <div class="link-row data-source-row">
          <button class="btn btn-primary" id="save-brand-watchlist" type="button" data-brand={brand} data-brand-slug={slug}>
            Save this brand in this browser
          </button>
          <a class="btn btn-secondary" href="/watchlist">View watchlist</a>
        </div>
        <p id="save-brand-status" class="form-note" hidden></p>
      </section>

      {sourceNames.length ? (
        <section class="section">
          <article class="detail-card">
            <h2>Official source names</h2>
            <p>Official notices may list a brand, importer, recalling firm, or legal company name differently.</p>
            <ul class="source-name-list">
              {sourceNames.map((name: string) => <li>{name}</li>)}
            </ul>
          </article>
        </section>
      ) : null}

      <section class="section">
        <div class="section-header">
          <div>
            <p class="eyebrow">Brand notices</p>
            <h2>Recall notices linked to this brand/company</h2>
            <p class="section-note">Cards are based on recall notices connected to this brand/company page.</p>
          </div>
        </div>
        <div class="product-grid">
          {recalls.map((recall) => (
            <RecallListCard recall={recall} />
          ))}
        </div>
      </section>

      <section class="section">
        <a class="btn btn-secondary" href="/checker">Check another product</a>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar helps you find possible recall notices. Search results are not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.
    </footer>
    <script>
      import { initImageFallbacks } from '../../lib/image-fallback';
      import { initProgressiveCardImages } from '../../lib/progressive-detail-image';
      import { upsertWatchlistBrand } from '../../lib/watchlist';

      initProgressiveCardImages();
      initImageFallbacks();

      const saveBrandButton = document.querySelector<HTMLButtonElement>('#save-brand-watchlist');
      const saveBrandStatus = document.querySelector<HTMLElement>('#save-brand-status');

      saveBrandButton?.addEventListener('click', () => {
        const brand = saveBrandButton.dataset.brand ?? '';
        const slug = saveBrandButton.dataset.brandSlug ?? '';
        if (!brand || !slug || !saveBrandStatus) {
          return;
        }

        const item = upsertWatchlistBrand({ brand, slug });
        saveBrandStatus.hidden = false;
        saveBrandStatus.textContent = `Saved ${item.brand} in this browser.`;
      });
    </script>
  </body>
</html>
