---
import { brandGroups } from '../../lib/recall-data';
import '../../styles/global.css';

export function getStaticPaths() {
  return brandGroups.map((group) => ({
    params: { brand: group.slug },
    props: group
  }));
}

const { brand, rawNames, recalls } = Astro.props;
const sourceNames = rawNames.filter(
  (rawName: string) => rawName.toLowerCase() !== brand.toLowerCase()
);
const sourceLabels = [...new Set(recalls.map((recall: { sourceLabel: string }) => recall.sourceLabel))];
const sourceLabel = sourceLabels.join(' + ');
const title = `${brand} Recall Page | Recall Radar`;
const description = `Local recall records for ${brand}, with related products, source company names, hazards, remedies, and detail links.`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/baby-product-recalls">Baby Product Recalls</a>
        <a href="/battery-recalls">Battery & Electronics Recalls</a>
        <a href="/food-allergy-recalls">Food Allergy Recalls</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow">Brand Recall pages</p>
        <div class="meta-row data-source-row">
          <span class="status-pill">{sourceLabel}</span>
          <span class="tag">{recalls.length} record{recalls.length === 1 ? '' : 's'}</span>
        </div>
        <h1>{brand} Recall Page</h1>
        <p class="lead">Related local recall records for {brand}.</p>
      </section>

      {sourceNames.length ? (
        <section class="section">
          <article class="notice-panel">
            <h2>Source Brand Names</h2>
            <p>These local records may list the brand, importer, recalling firm, or legal company name differently.</p>
            <ul class="source-name-list">
              {sourceNames.map((name: string) => <li>{name}</li>)}
            </ul>
          </article>
        </section>
      ) : null}

      <section class="section">
        <div class="section-header">
          <h2>Related Recalls</h2>
        </div>
        <div class="grid">
          {recalls.map((recall) => (
            <article class="recall-card">
              <div class="meta-row">
                <span class="tag source-tag">{recall.sourceLabel}</span>
                <span class="tag">{recall.categoryLabel}</span>
                <span class="tag">{recall.recallDate}</span>
              </div>
              <h3><a href={recall.detailPath}>{recall.title}</a></h3>
              <p>Product: {recall.primaryProductName}</p>
              <p>Hazard: {recall.hazard || 'Not listed in local data'}</p>
              <a href={recall.detailPath}>Details</a>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <a class="button-link button-secondary" href="/checker">Product Recall Checker</a>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar uses local CPSC and FDA/openFDA processed data when available and local mock fallback data otherwise. Always verify against official recall notices.
    </footer>
  </body>
</html>
