---
import EuImageResourceHints from '../components/EuImageResourceHints.astro';
import {
  getRecallsByCategory,
  processedCanadaRecordCount,
  processedCpscRecordCount,
  processedEuSafetyGateRecordCount,
  processedFdaRecordCount,
  processedFranceRappelConsoRecordCount,
  processedLocalRecordCount,
  processedUkFsaRecordCount,
  siteRecalls
} from '../lib/recall-data';
import { getImageLoadingAttributes, getRecallImageForContext } from '../lib/recall-images';
import { getRecallSourcePlaceholder } from '../lib/recall-sources';
import { getSourceLandingPageCards } from '../lib/source-landing-pages';
import '../styles/global.css';

const title = 'Recall Radar | Global product recall search';
const description =
  'Recall Radar helps consumers search official product recall notices across markets by brand, product name, model number, UPC/barcode, lot code, ingredient, or keyword.';
const latestRecalls = siteRecalls.slice(0, 6);
const babyCount = getRecallsByCategory('baby-kids').length;
const batteryCount = getRecallsByCategory('battery-electronics').length;
const foodCount = getRecallsByCategory('food-allergy').length;
const householdCount = getRecallsByCategory('household-appliance').length;
const activeSourceCount = [
  processedCpscRecordCount,
  processedFdaRecordCount,
  processedFranceRappelConsoRecordCount,
  processedCanadaRecordCount,
  processedEuSafetyGateRecordCount,
  processedUkFsaRecordCount
].filter((count) => count > 0).length;
const countLine = `${processedLocalRecordCount} recall notices from ${activeSourceCount} official sources. Coverage is expanding and remains limited to sources currently included.`;
const productTypes = [
  {
    label: 'Baby & Kids',
    icon: 'baby',
    href: '/baby-product-recalls',
    count: babyCount,
    description: 'Nursery gear and kids products.'
  },
  {
    label: 'Batteries & Electronics',
    icon: 'battery',
    href: '/battery-recalls',
    count: batteryCount,
    description: 'Devices, batteries, and chargers.'
  },
  {
    label: 'Food & Allergy',
    icon: 'food',
    href: '/food-allergy-recalls',
    count: foodCount,
    description: 'Foods, allergens, UPCs, and lots.'
  },
  {
    label: 'Household Products',
    icon: 'household',
    href: '/household-product-recalls',
    count: householdCount,
    description: 'Appliances and home products.'
  }
];
const sourcePages = getSourceLandingPageCards();
const sourceCardDetails = {
  '/us-product-recalls': {
    marker: 'US',
    markerClass: 'source-marker-us',
    title: 'United States',
    description: 'Product recalls and food alerts from CPSC and FDA/openFDA.',
    sourceLabel: 'CPSC + FDA/openFDA',
    cta: 'Browse US recalls'
  },
  '/canada-product-recalls': {
    marker: 'CA',
    markerClass: 'source-marker-canada',
    title: 'Canada',
    description: 'Product recalls and safety alerts from Health Canada.',
    sourceLabel: 'Recalls and Safety Alerts',
    cta: 'Browse Canada recalls'
  },
  '/eu-safety-gate-recalls': {
    marker: 'EU',
    markerClass: 'source-marker-eu',
    title: 'European Union',
    description: 'Non-food product safety alerts from Safety Gate.',
    sourceLabel: 'Safety Gate',
    cta: 'Browse EU alerts'
  },
  '/france-product-recalls': {
    marker: 'FR',
    markerClass: 'source-marker-france',
    title: 'France',
    description: 'Consumer product and food recalls from RappelConso.',
    sourceLabel: 'RappelConso',
    cta: 'Browse France recalls'
  },
  '/uk-food-recalls': {
    marker: 'UK',
    markerClass: 'source-marker-uk',
    title: 'United Kingdom',
    description: 'Food recalls and allergy alerts from the UK FSA.',
    sourceLabel: 'FSA Food Alerts',
    cta: 'Browse UK food alerts'
  }
} as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <EuImageResourceHints />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby & Kids</a>
        <a href="/battery-recalls">Batteries & Electronics</a>
        <a href="/food-allergy-recalls">Food & Allergy</a>
      </nav>
    </header>

    <main class="page-shell home-page">
      <section class="home-hero">
        <div class="home-hero-copy">
          <h1>Search official recall notices across markets.</h1>
          <p class="lead">
            Search by brand, product, model, barcode, lot code, ingredient, or keyword.
          </p>
        </div>

        <div class="home-search-panel" aria-label="Search product recall notices">
          <form class="home-search-module" action="/checker" method="get">
            <label class="sr-only" for="home-recall-search">Brand, product, model, UPC, lot code, ingredient, or keyword</label>
            <input
              id="home-recall-search"
              name="q"
              type="search"
              placeholder="Product, brand, model, barcode, or lot code"
            />
            <button class="btn btn-primary" type="submit">Check recalls</button>
          </form>
          <div class="home-example-links" aria-label="Example searches">
            <span>Try</span>
            <a href="/checker?q=baby%20sleeper">baby sleeper</a>
            <a href="/checker?q=power%20bank">power bank</a>
            <a href="/checker?q=pistachio&source=FDA">pistachio</a>
            <a href="/checker?q=smoke%20detector&source=CPSC">smoke detector</a>
          </div>
          <p class="data-count-line">{countLine}</p>
        </div>
      </section>

      <section class="section home-category-section">
        <div class="section-header">
          <div>
            <h2>Browse recalls by product type</h2>
          </div>
        </div>
        <div class="category-grid">
          {productTypes.map((type) => (
            <a class="category-card home-product-type-card" href={type.href}>
              <span class="category-icon" aria-hidden="true">
                {type.icon === 'baby' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M16 18h16" />
                    <path d="M18 18l-2 14h16l-2-14" />
                    <path d="M20 32v6" />
                    <path d="M28 32v6" />
                    <circle cx="18" cy="14" r="4" />
                    <circle cx="30" cy="14" r="4" />
                  </svg>
                ) : type.icon === 'battery' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <rect x="9" y="17" width="26" height="16" rx="3" />
                    <path d="M35 22h4v6h-4" />
                    <path d="M23 19l-5 8h6l-3 7 8-10h-6l3-5z" />
                  </svg>
                ) : type.icon === 'food' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M15 18c5-8 14-8 18 0" />
                    <path d="M12 22h24l-3 15H15z" />
                    <path d="M20 12c3 1 5 3 6 6" />
                    <path d="M29 11c-3 1-5 3-6 7" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M10 24l14-12 14 12" />
                    <path d="M14 22v15h20V22" />
                    <path d="M20 37V27h8v10" />
                    <path d="M31 16v-4h4v8" />
                  </svg>
                )}
              </span>
              <span class="category-card-body">
                <h3>{type.label}</h3>
                <p>{type.description}</p>
                <span class="category-count">{type.count} recall notice{type.count === 1 ? '' : 's'}</span>
                <span class="btn btn-link">Browse category</span>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section class="section home-source-section">
        <div class="section-header">
          <div>
            <h2>Browse by country or source</h2>
          </div>
        </div>
        <div class="category-grid source-country-grid">
          {sourcePages.map((page) => {
            const details = sourceCardDetails[page.route as keyof typeof sourceCardDetails];

            return (
            <a class="category-card source-country-card" href={page.route}>
              <span class={`source-marker ${details.markerClass}`} aria-hidden="true">{details.marker}</span>
              <span class="category-card-body">
                <span class="source-card-kicker">{details.sourceLabel}</span>
                <h3>{details.title}</h3>
                <p>{details.description}</p>
                <span class="category-count">{page.count} recall notice{page.count === 1 ? '' : 's'}</span>
                <span class="btn btn-link">{details.cta}</span>
              </span>
            </a>
            );
          })}
        </div>
      </section>

      <section class="section home-latest-section">
        <div class="section-header">
          <div>
            <h2>Recently recalled products</h2>
          </div>
          <a class="btn btn-secondary" href="/checker">Search all notices</a>
        </div>
        <div class="product-grid">
          {latestRecalls.map((recall, index) => {
            const image = getRecallImageForContext(recall, 'card');
            const imageAttrs = getImageLoadingAttributes('card', index);

            return (
            <article class="home-recall-card product-card">
              <a class="home-card-image image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                {image.url ? (
                  <>
                    <img
                      src={image.url}
                      alt={image.alt}
                      {...imageAttrs}
                      data-fallback-label={getRecallSourcePlaceholder(recall.source)}
                    />
                    <span class="image-placeholder image-placeholder-fallback" hidden>
                      {getRecallSourcePlaceholder(recall.source)}
                    </span>
                  </>
                ) : (
                  <span class="image-placeholder">{getRecallSourcePlaceholder(recall.source)}</span>
                )}
              </a>
              <div class="card-body">
                <div class="home-card-meta">
                  <span>{recall.sourceLabel}</span>
                  <span>{recall.recallDate}</span>
                </div>
                <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                <span class="home-card-hazard">{recall.hazard || recall.reason || 'Hazard or reason not listed in the official notice.'}</span>
                <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
              </div>
            </article>
            );
          })}
        </div>
      </section>

      <section class="section home-watchlist-section">
        <div class="signup-panel compact-cta home-watchlist-cta">
          <div>
            <h2>Monitor saved searches in this browser</h2>
            <p>Saved searches stay on this device. No account or email alerts are enabled yet.</p>
          </div>
          <div class="link-row">
            <a class="btn btn-primary" href="/watchlist">Open watchlist</a>
            <a class="btn btn-secondary" href="/checker?q=pistachio&source=FDA">Try pistachio</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar helps you find possible recall notices. Search results are not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.
    </footer>
    <script>
      import { initImageFallbacks } from '../lib/image-fallback';
      import { initProgressiveCardImages } from '../lib/progressive-detail-image';

      initProgressiveCardImages();
      initImageFallbacks();
    </script>
  </body>
</html>
