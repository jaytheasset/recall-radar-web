---
import {
  brandGroups,
  dataSourceLabel,
  processedCpscRecordCount,
  processedFdaRecordCount,
  processedLocalRecordCount,
  siteRecalls,
  usingProcessedLocalData
} from '../lib/recall-data';
import '../styles/global.css';

const title = 'Recall Radar | Image-first local recall board';
const description =
  'Recall Radar helps consumers search local CPSC and FDA/openFDA recall records by product, brand, model, UPC, lot code, or keyword.';
const latestRecalls = siteRecalls.slice(0, 8);
const imageRecalls = siteRecalls.filter((recall) => recall.primaryImageUrl);
const heroGalleryRecalls = (imageRecalls.length ? imageRecalls : siteRecalls).slice(0, 4);
const featuredBrands = brandGroups.slice(0, 18);
const productTypes = [
  {
    label: 'Baby & Kids',
    href: '/baby-product-recalls',
    marker: 'B',
    description: 'Cribs, sleepers, toys, nursery gear, and child-focused recalls.'
  },
  {
    label: 'Batteries & Electronics',
    href: '/battery-recalls',
    marker: 'E',
    description: 'Power banks, chargers, lithium-ion batteries, and devices.'
  },
  {
    label: 'Food & Allergy',
    href: '/food-allergy-recalls',
    marker: 'F',
    description: 'FDA/openFDA food recalls, allergen notices, UPCs, and lot codes.'
  },
  {
    label: 'Household Products',
    href: '/checker?category=household-appliance',
    marker: 'H',
    description: 'Appliances, furniture, fixtures, and home products.'
  }
];
const workflowSteps = [
  {
    title: 'Search the product',
    text: 'Enter a brand, product, model, UPC, lot code, recall number, or keyword.'
  },
  {
    title: 'Compare product details',
    text: 'Review names, images when available, dates, hazards, remedies, and source labels.'
  },
  {
    title: 'Verify with official source',
    text: 'Open the official CPSC or FDA/openFDA notice before making decisions.'
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby & Kids</a>
        <a href="/battery-recalls">Batteries & Electronics</a>
        <a href="/food-allergy-recalls">Food & Allergy</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Local recall board</p>
          <h1>Find recalled products before they stay in your home</h1>
          <p class="lead">
            Search local CPSC and FDA/openFDA recall records by product, brand, model, UPC, lot code, or keyword.
          </p>
          <form class="hero-search" action="/checker" method="get">
            <label>
              Product, brand, model, UPC, lot, or recall number
              <input name="q" type="search" placeholder="Try baby sleeper, power bank, pistachio, or smoke detector" />
            </label>
            <button class="btn btn-primary" type="submit">Check recalls</button>
          </form>
          <div class="example-searches" aria-label="Example searches">
            <span>Examples:</span>
            <a class="tag" href="/checker?q=baby%20sleeper">baby sleeper</a>
            <a class="tag" href="/checker?q=power%20bank">power bank</a>
            <a class="tag" href="/checker?q=pistachio&source=FDA">pistachio</a>
            <a class="tag" href="/checker?q=smoke%20detector&source=CPSC">smoke detector</a>
          </div>
          <div class="trust-row" aria-label="Local recall data coverage">
            <span class="status-pill">
              {usingProcessedLocalData ? `${processedLocalRecordCount} local records` : 'Demo fallback records'}
            </span>
            <span class="tag">{processedCpscRecordCount} CPSC + {processedFdaRecordCount} FDA/openFDA</span>
            <span class="tag">Official source links</span>
            <span class="badge-danger">No safety guarantee</span>
          </div>
        </div>

        <aside class="hero-gallery" aria-labelledby="recently-recalled-title">
          <div>
            <p class="eyebrow">Recently recalled</p>
            <h2 id="recently-recalled-title">Product notices with source images</h2>
            <p class="section-note">{dataSourceLabel}</p>
          </div>
          <div class="hero-gallery-grid">
            {heroGalleryRecalls.map((recall) => (
              <article class="product-card">
                <a class="image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                  {recall.primaryImageUrl ? (
                    <img src={recall.primaryImageUrl} alt={recall.primaryImageAlt || recall.title} loading="lazy" />
                  ) : (
                    <span class="image-placeholder">{recall.source === 'FDA' ? 'FDA food notice' : 'Recall notice'}</span>
                  )}
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{recall.sourceLabel}</span>
                    <span class="badge-date">{recall.recallDate}</span>
                  </div>
                  <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                </div>
              </article>
            ))}
          </div>
        </aside>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <p class="eyebrow">Recently recalled products</p>
            <h2>Visual recall board</h2>
            <p class="section-note">Product cards use official CPSC image URLs already present in local data when available.</p>
          </div>
          <a class="btn btn-secondary" href="/checker">Search all records</a>
        </div>
        <div class="product-grid">
          {latestRecalls.map((recall) => (
            <article class="product-card">
              <a class="image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                {recall.primaryImageUrl ? (
                  <img src={recall.primaryImageUrl} alt={recall.primaryImageAlt || recall.title} loading="lazy" />
                ) : (
                  <span class="image-placeholder">{recall.source === 'FDA' ? 'FDA food notice' : 'Recall notice'}</span>
                )}
              </a>
              <div class="card-body">
                <div class="meta-row">
                  <span class="badge-source">{recall.sourceLabel}</span>
                  <span class="badge-date">{recall.recallDate}</span>
                </div>
                <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                <p>{recall.hazard || recall.reason || recall.description}</p>
                <a class="btn btn-ghost" href={recall.detailPath}>View recall</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <p class="eyebrow">Browse by product type</p>
            <h2>Focused recall categories</h2>
          </div>
        </div>
        <div class="category-grid">
          {productTypes.map((type) => (
            <a class="category-card" href={type.href}>
              <span class="category-visual" aria-hidden="true"><span>{type.marker}</span></span>
              <span class="category-card-body">
                <h3>{type.label}</h3>
                <p>{type.description}</p>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <p class="eyebrow">How to use Recall Radar</p>
            <h2>Check the product, then verify the notice</h2>
          </div>
        </div>
        <div class="step-grid">
          {workflowSteps.map((step, index) => (
            <article class="step-card">
              <span class="step-number">{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="signup-panel">
          <div>
            <p class="eyebrow">Local watchlist</p>
            <h2>Monitor saved searches and brands in this browser</h2>
            <p>Save searches or brands locally, then preview matching recall cards from the existing local dataset. Local demo only - no email is sent.</p>
          </div>
          <div class="link-row">
            <a class="btn btn-primary" href="/watchlist">Open watchlist</a>
            <a class="btn btn-secondary" href="/checker?q=pistachio&source=FDA">Try a food search</a>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <p class="eyebrow">Brand pages</p>
            <h2>Browse recalls linked to brands</h2>
          </div>
        </div>
        <div class="tag-row">
          {featuredBrands.map((group) => <a class="tag" href={`/brands/${group.slug}`}>{group.brand}</a>)}
        </div>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar uses local CPSC and FDA/openFDA processed data when available and local mock fallback data otherwise. Always verify against official recall notices.
    </footer>
  </body>
</html>
