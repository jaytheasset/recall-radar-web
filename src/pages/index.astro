---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import EuImageResourceHints from '../components/EuImageResourceHints.astro';
import AdSenseSlot from '../components/AdSenseSlot.astro';
import {
  categoryRoutes,
  getRecallsByCategory,
  processedAustraliaProductSafetyRecordCount,
  processedCanadaRecordCount,
  processedCpscRecordCount,
  processedEuSafetyGateRecordCount,
  processedFsanzFoodRecallRecordCount,
  processedFdaRecordCount,
  processedFranceRappelConsoRecordCount,
  processedHongKongCfsRecordCount,
  processedLocalRecordCount,
  processedNewZealandProductSafetyRecordCount,
  processedUkFsaRecordCount,
  siteRecalls
} from '../lib/recall-data';
import { getImageLoadingAttributes, getRecallImageForContext } from '../lib/recall-images';
import { getRecallSourcePlaceholder } from '../lib/recall-sources';
import { getBalancedRecentRecalls } from '../lib/homepage-recent';
import { getSourceLandingPageCards } from '../lib/source-landing-pages';
import { getProductFamilyI18nKey, getSourceLandingTitleI18nKey } from '../lib/i18n';
import '../styles/global.css';

const title = 'Recall Radar | Global product recall search';
const description =
  'Recall Radar helps consumers search official recall information across markets by brand, product name, model number, barcode, lot or batch code, date mark, recall number, ingredient, or keyword.';
const recentRecalls = getBalancedRecentRecalls(siteRecalls, { limit: 4 });
const activeSourceCount = [
  processedCpscRecordCount,
  processedFdaRecordCount,
  processedFranceRappelConsoRecordCount,
  processedCanadaRecordCount,
  processedEuSafetyGateRecordCount,
  processedUkFsaRecordCount,
  processedAustraliaProductSafetyRecordCount,
  processedNewZealandProductSafetyRecordCount,
  processedHongKongCfsRecordCount,
  processedFsanzFoodRecallRecordCount
].filter((count) => count > 0).length;
const countLine = `${processedLocalRecordCount} recalls from ${activeSourceCount} official sources.`;
const homepageProductFamilyOrder = [
  'food-grocery',
  'baby-kids',
  'electronics-batteries',
  'home-appliances',
  'furniture-household',
  'vehicles-mobility',
  'sports-outdoor',
  'tools-equipment'
];
const orderedProductFamilyRoutes = [
  ...homepageProductFamilyOrder
    .map((category) => categoryRoutes.find((route) => route.category === category))
    .filter((route): route is (typeof categoryRoutes)[number] => Boolean(route)),
  ...categoryRoutes.filter((route) => !homepageProductFamilyOrder.includes(route.category))
];
const productFamilies = orderedProductFamilyRoutes.map((route, index) => ({
  ...route,
  icon: route.category,
  count: getRecallsByCategory(route.category).length,
  isInitiallyVisible: index < homepageProductFamilyOrder.length
})).filter((type) => type.category !== 'unknown' && type.count > 0);
const productFamilyIconSvg: Record<string, string> = {
  'baby-kids': '<path d="M9 12h.01"/><path d="M15 12h.01"/><path d="M10 16c.5.3 1.3.5 2 .5s1.5-.2 2-.5"/><path d="M19 6.3a9 9 0 1 1-14 0"/><path d="M9 6.3a3 3 0 1 1 6 0"/>',
  'electronics-batteries': '<path d="M15 7h1a2 2 0 0 1 2 2v1h1a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2h-2"/><path d="M8 7H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h1"/><path d="m11 7-3 5h4l-3 5"/>',
  'food-grocery': '<path d="m15 11-1 9"/><path d="m19 11-4-7"/><path d="M2 11h20"/><path d="m3.5 11 1.6 7.4a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6l1.7-7.4"/><path d="M5 11l4-7"/>',
  'home-appliances': '<path d="M5 6a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6Z"/><path d="M5 10h14"/><path d="M15 7v.01"/><path d="M15 13v.01"/>',
  'furniture-household': '<path d="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3"/><path d="M3 11v6a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6"/><path d="M5 19v2"/><path d="M19 19v2"/><path d="M5 11a2 2 0 0 1 4 0v2h6v-2a2 2 0 0 1 4 0"/>',
  'vehicles-mobility': '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3C13.3 7.3 12.7 7 12 7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>',
  'sports-outdoor': '<path d="m6.5 6.5 11 11"/><path d="m21 21-1-1"/><path d="m3 3 1 1"/><path d="m18 22 4-4"/><path d="m2 6 4-4"/><path d="m3 10 7-7"/><path d="m14 21 7-7"/>',
  'clothing-accessories': '<path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 1 .84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.14a1 1 0 0 0 1-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>',
  'tools-equipment': '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/>',
  'health-personal-care': '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>',
  'chemicals-cleaning': '<path d="M10 2v7.31"/><path d="M14 9.3V2"/><path d="M8.5 2h7"/><path d="M14 9.3a6.5 6.5 0 1 1-4 0"/><path d="M5.58 16h12.85"/>',
  'pet-products': '<path d="M17 10c.7-.7 1.5-1 2.5-1A3.5 3.5 0 0 1 23 12.5c0 1-.3 1.8-1 2.5l-7 7H7l7-7c.7-.7 1.5-1 2.5-1"/><path d="m6 8 2-2"/><path d="m8 6 2-2"/><path d="m2 12 2-2"/><path d="m4 10 2-2"/>',
  'industrial-workplace': '<path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/>',
  other: '<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
  'need-review': '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>'
};
const sourcePages = getSourceLandingPageCards();
const homepageSourceRoutes = [
  '/us-product-recalls',
  '/canada-product-recalls',
  '/eu-safety-gate-recalls',
  '/uk-food-recalls',
  '/australia-product-recalls',
  '/new-zealand-product-recalls',
  '/hong-kong-food-recalls',
  '/france-product-recalls'
];
const homepageSourcePages = homepageSourceRoutes
  .map((route) => sourcePages.find((page) => page.route === route))
  .filter((page): page is (typeof sourcePages)[number] => Boolean(page));
const sourceCardDetails = {
  '/us-product-recalls': {
    flagSrc: '/flags/us.svg',
    flagAlt: 'United States flag'
  },
  '/canada-product-recalls': {
    flagSrc: '/flags/ca.svg',
    flagAlt: 'Canada flag'
  },
  '/eu-safety-gate-recalls': {
    flagSrc: '/flags/eu.svg',
    flagAlt: 'European Union flag'
  },
  '/france-product-recalls': {
    flagSrc: '/flags/fr.svg',
    flagAlt: 'France flag'
  },
  '/uk-food-recalls': {
    flagSrc: '/flags/gb.svg',
    flagAlt: 'United Kingdom flag'
  },
  '/australia-product-recalls': {
    flagSrc: '/flags/au.svg',
    flagAlt: 'Australia flag'
  },
  '/new-zealand-product-recalls': {
    flagSrc: '/flags/nz.svg',
    flagAlt: 'New Zealand flag'
  },
  '/hong-kong-food-recalls': {
    flagSrc: '/flags/hk.svg',
    flagAlt: 'Hong Kong flag'
  },
  '/australia-new-zealand-food-recalls': {
    flagSrcs: [
      { src: '/flags/au.svg', alt: 'Australia flag' },
      { src: '/flags/nz.svg', alt: 'New Zealand flag' }
    ]
  }
} as const;

function getHomeIssueBadge(recall: (typeof recentRecalls)[number]): string {
  if (recall.taxonomyHazardTypeLabel) {
    return recall.taxonomyHazardTypeLabel;
  }

  if (recall.taxonomyProductFamily === 'food-grocery' || recall.source === 'FDA' || recall.source === 'UK_FSA' || recall.source === 'HK_CFS') {
    return 'Food alert';
  }

  return 'Safety hazard';
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <EuImageResourceHints />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteHeader />

    <main class="page-shell home-page">
      <section class="home-hero">
        <div class="home-hero-intro">
          <div class="home-hero-copy">
            <h1>
              <span data-i18n="home.hero.line1">Stay informed.</span>
              <span data-i18n="home.hero.line2">Shop and live with confidence.</span>
            </h1>
            <p class="lead" data-i18n="home.lead">
              Search official recall notices from trusted sources around the world.
            </p>
          </div>

          <div class="home-hero-visual" aria-hidden="true">
            <div class="home-illustration-card home-illustration-shield">
              <svg viewBox="0 0 160 180" focusable="false">
                <path d="M80 13c18 17 43 24 62 27v52c0 36-24 63-62 76-38-13-62-40-62-76V40c19-3 44-10 62-27Z" />
                <path d="m51 90 21 21 42-52" />
              </svg>
            </div>
            <div class="home-illustration-card home-illustration-bag">
              <span></span>
            </div>
            <div class="home-illustration-card home-illustration-plant">
              <span></span>
            </div>
          </div>
        </div>

        <div class="home-search-panel" aria-label="Search product recalls" data-i18n-aria-label="home.searchButton">
          <form class="home-search-module" action="/checker" method="get">
            <label class="sr-only" for="home-recall-search" data-i18n="home.searchLabel">Brand, product, model, barcode, lot, date, or recall number</label>
            <span class="home-search-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <circle cx="11" cy="11" r="7" />
                <path d="m16.5 16.5 4 4" />
              </svg>
            </span>
            <input
              id="home-recall-search"
              name="q"
              type="search"
              placeholder="Search by brand, product, model, barcode, lot code, or recall number"
              data-i18n-placeholder="home.searchPlaceholder"
            />
            <button class="btn btn-primary" type="submit" data-i18n="home.searchButton">Search recalls</button>
          </form>
          <div class="home-example-links" aria-label="Example searches">
            <span data-i18n="common.try">Try:</span>
            <a href="/checker?q=baby%20sleeper">baby sleeper</a>
            <a href="/checker?q=power%20bank">power bank</a>
            <a href="/checker?q=pistachio&source=FDA">pistachio</a>
            <a href="/checker?q=smoke%20detector&source=CPSC">smoke detector</a>
            <a href="/checker?q=bike%20helmet">bike helmet</a>
          </div>
          <p class="home-trust-line">
            <span class="home-trust-icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" focusable="false">
                <path d="M6.4 10.8 3.5 7.9l-1 1 3.9 3.9 7.1-8.5-1.1-.9-6 7.4Z" />
              </svg>
            </span>
            <span data-i18n="home.trust">Official recalls. Trusted sources. Global coverage.</span>
          </p>
          <p
            class="data-count-line"
            data-i18n-template="home.countLine"
            data-i18n-values={JSON.stringify({ total: processedLocalRecordCount, sources: activeSourceCount })}
          >
            {countLine}
          </p>
        </div>
      </section>

      <section id="browse-recalls" class="section home-category-section">
        <div class="section-header">
          <div>
            <h2 data-i18n="home.productTypesHeading">Explore by product type</h2>
          </div>
          <button
            class="section-link home-expand-button"
            type="button"
            data-home-expand="product-types"
            aria-expanded="false"
          >
            <span data-i18n="common.viewAllProductTypes">View all product types</span> <span aria-hidden="true">&rsaquo;</span>
          </button>
        </div>
        <div class="home-carousel" data-home-carousel>
          <button class="home-carousel-button home-carousel-button-prev" type="button" aria-label="Scroll product types left" data-home-carousel-prev>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>
          </button>
          <div class="home-carousel-viewport" data-home-carousel-viewport>
            <div class="category-grid home-carousel-track home-product-type-track" data-home-product-types>
              {productFamilies.map((type) => (
                <a
                  class="category-card home-product-type-card"
                  href={type.href}
                  data-product-type-extra={!type.isInitiallyVisible ? 'true' : undefined}
                >
                  <span class="category-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                      <Fragment set:html={productFamilyIconSvg[type.icon] ?? productFamilyIconSvg.other} />
                    </svg>
                  </span>
                  <span class="category-card-body">
                    <h3 data-i18n={getProductFamilyI18nKey(type.category)}>{type.label}</h3>
                    <span class="home-card-link"><span data-i18n="common.viewRecalls">View recalls</span> <span aria-hidden="true">&rarr;</span></span>
                  </span>
                </a>
              ))}
            </div>
          </div>
          <button class="home-carousel-button" type="button" aria-label="Scroll product types" data-home-carousel-next>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M8.25 4.5 15.75 12l-7.5 7.5" />
            </svg>
          </button>
        </div>
      </section>

      <section id="official-sources" class="section home-source-section">
        <div class="section-header">
          <div>
            <h2 data-i18n="home.sourcesHeading">Browse by source</h2>
          </div>
          <a class="section-link" href="/countries"><span data-i18n="common.viewAllSources">View all sources</span> <span aria-hidden="true">&rsaquo;</span></a>
        </div>
        <div class="home-carousel" data-home-carousel>
          <button class="home-carousel-button home-carousel-button-prev" type="button" aria-label="Scroll sources left" data-home-carousel-prev>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>
          </button>
          <div class="home-carousel-viewport" data-home-carousel-viewport>
            <div class="category-grid source-country-grid home-carousel-track">
              {homepageSourcePages.map((page) => {
                const details = sourceCardDetails[page.route as keyof typeof sourceCardDetails];
                const card = page.card;

                return (
                <a class="category-card source-country-card" href={page.route}>
                  <span class:list={['source-flag-wrap', 'flagSrcs' in details && 'source-flag-wrap-pair']}>
                    {'flagSrcs' in details ? (
                      details.flagSrcs.map((flag) => (
                        <img class="source-flag source-flag-pair" src={flag.src} alt={flag.alt} loading="lazy" decoding="async" />
                      ))
                    ) : (
                      <img class="source-flag" src={details.flagSrc} alt={details.flagAlt} loading="lazy" decoding="async" />
                    )}
                  </span>
                  <span class="category-card-body">
                    <h3 data-i18n={getSourceLandingTitleI18nKey(page.route)}>{card.title}</h3>
                    <span class="source-card-kicker">{card.agencyLabel}</span>
                  </span>
                  <span
                    class="source-card-count"
                    data-i18n-template="common.recallsCount"
                    data-i18n-values={JSON.stringify({ count: page.count })}
                  >
                    {page.count} recalls
                  </span>
                </a>
                );
              })}
            </div>
          </div>
          <button class="home-carousel-button" type="button" aria-label="Scroll sources" data-home-carousel-next>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M8.25 4.5 15.75 12l-7.5 7.5" />
            </svg>
          </button>
        </div>
      </section>

      <section class="section home-latest-section">
        <div class="section-header">
          <div>
            <h2 data-i18n="home.latestHeading">Latest recalls</h2>
          </div>
          <a class="section-link" href="/checker"><span data-i18n="common.viewAllRecalls">View all recalls</span> <span aria-hidden="true">&rsaquo;</span></a>
        </div>
        <div class="product-grid home-latest-grid">
          {recentRecalls.map((recall, index) => {
            const image = getRecallImageForContext(recall, 'card');
            const imageAttrs = getImageLoadingAttributes('card', index);

            return (
            <article class="home-recall-card home-latest-card product-card">
              <a class="home-card-image image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                {image.url ? (
                  <>
                    <img
                      src={image.url}
                      alt={image.alt}
                      {...imageAttrs}
                      data-fallback-label={getRecallSourcePlaceholder(recall.source)}
                    />
                    <span class="image-placeholder image-placeholder-fallback" hidden>
                      {getRecallSourcePlaceholder(recall.source)}
                    </span>
                  </>
                ) : (
                  <span class="image-placeholder">{getRecallSourcePlaceholder(recall.source)}</span>
                )}
              </a>
              <div class="card-body">
                <span class="home-issue-badge">{getHomeIssueBadge(recall)}</span>
                <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                <div class="home-card-meta">
                  <span>{recall.sourceLabel}</span>
                  <span>{recall.recallDate}</span>
                </div>
              </div>
            </article>
            );
          })}
        </div>
      </section>

      <AdSenseSlot placement="home" />

      <section class="section home-watchlist-section">
        <div class="signup-panel compact-cta home-watchlist-cta">
          <div>
            <h2 data-i18n="home.watchlistHeading">Keep an eye on products you care about</h2>
            <p data-i18n="home.watchlistCopy">Save searches in this browser only. No account, email, or alerts yet.</p>
          </div>
          <div class="link-row">
            <a class="btn btn-primary" href="/watchlist" data-i18n="home.openSavedSearches">Open saved searches</a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
    <script>
      import { applyUiLanguage, DEFAULT_LOCALE, SUPPORTED_LOCALES, type SupportedLocale } from '../lib/i18n';
      import { initImageFallbacks } from '../lib/image-fallback';
      import { initProgressiveCardImages } from '../lib/progressive-detail-image';

      initProgressiveCardImages();
      initImageFallbacks();

      document.querySelectorAll('[data-home-carousel]').forEach((carousel) => {
        const viewport = carousel.querySelector('[data-home-carousel-viewport]');
        const prevButton = carousel.querySelector('[data-home-carousel-prev]');
        const nextButton = carousel.querySelector('[data-home-carousel-next]');
        const track = carousel.querySelector('.home-carousel-track');

        if (
          !(viewport instanceof HTMLElement) ||
          !(prevButton instanceof HTMLButtonElement) ||
          !(nextButton instanceof HTMLButtonElement) ||
          !(track instanceof HTMLElement)
        ) {
          return;
        }

        const getScrollMetrics = () => {
          const maxScrollLeft = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
          const firstCard = track.firstElementChild;
          const cardWidth = firstCard instanceof HTMLElement ? firstCard.getBoundingClientRect().width : 0;
          const gapValue = Number.parseFloat(window.getComputedStyle(track).columnGap || window.getComputedStyle(track).gap || '0');
          const singleStep = cardWidth + (Number.isFinite(gapValue) ? gapValue : 0);
          const pageStep = Math.max(singleStep * 3, viewport.clientWidth - 48);

          return { maxScrollLeft, pageStep };
        };

        const updateButtons = () => {
          const { maxScrollLeft } = getScrollMetrics();
          const left = viewport.scrollLeft;

          prevButton.disabled = left <= 4;
          nextButton.disabled = left >= maxScrollLeft - 4;
        };

        prevButton.addEventListener('click', () => {
          const { pageStep } = getScrollMetrics();

          viewport.scrollTo({
            left: Math.max(0, viewport.scrollLeft - pageStep),
            behavior: 'smooth'
          });
        });

        nextButton.addEventListener('click', () => {
          const { maxScrollLeft, pageStep } = getScrollMetrics();

          viewport.scrollTo({
            left: Math.min(maxScrollLeft, viewport.scrollLeft + pageStep),
            behavior: 'smooth'
          });
        });

        viewport.addEventListener('scroll', () => window.requestAnimationFrame(updateButtons));
        window.addEventListener('resize', updateButtons);
        updateButtons();
      });

      const productTypeSection = document.querySelector('#browse-recalls');
      const productTypeButton = document.querySelector('[data-home-expand="product-types"]');
      const extraProductTypeCards = document.querySelectorAll('[data-product-type-extra="true"]');

      if (productTypeSection && productTypeButton instanceof HTMLButtonElement) {
        productTypeButton.addEventListener('click', () => {
          const willExpand = productTypeButton.getAttribute('aria-expanded') !== 'true';
          const label = productTypeButton.querySelector('[data-i18n]');

          extraProductTypeCards.forEach((card) => {
            if (card instanceof HTMLElement) {
              card.hidden = !willExpand;
            }
          });

          productTypeSection.classList.toggle('is-expanded', willExpand);
          productTypeButton.setAttribute('aria-expanded', String(willExpand));
          productTypeSection.querySelector('[data-home-carousel-viewport]')?.scrollTo({ left: 0, behavior: 'smooth' });
          label?.setAttribute(
            'data-i18n',
            willExpand ? 'common.showFewerProductTypes' : 'common.viewAllProductTypes'
          );
          const currentLocale = (SUPPORTED_LOCALES as readonly string[]).includes(document.documentElement.lang)
            ? document.documentElement.lang
            : DEFAULT_LOCALE;
          applyUiLanguage(currentLocale as SupportedLocale);
        });
      }
    </script>
  </body>
</html>
