---
import {
  getRecallsByCategory,
  processedCpscRecordCount,
  processedFdaRecordCount,
  processedLocalRecordCount,
  siteRecalls
} from '../lib/recall-data';
import '../styles/global.css';

const title = 'Recall Radar | Local product recall checker';
const description =
  'Recall Radar helps consumers search local CPSC and FDA/openFDA recall records by product, brand, model, UPC, lot code, or keyword.';
const featuredRecall = siteRecalls.find((recall) => recall.primaryImageUrl) ?? siteRecalls[0];
const latestRecalls = siteRecalls
  .filter((recall) => recall.id !== featuredRecall?.id)
  .slice(0, 6);
const babyCount = getRecallsByCategory('baby-kids').length;
const batteryCount = getRecallsByCategory('battery-electronics').length;
const foodCount = getRecallsByCategory('food-allergy').length;
const householdCount = getRecallsByCategory('household-appliance').length;
const countLine = `${processedLocalRecordCount} local records - ${processedCpscRecordCount} CPSC - ${processedFdaRecordCount} FDA/openFDA`;
const productTypes = [
  {
    label: 'Baby & Kids',
    href: '/baby-product-recalls',
    count: babyCount,
    description: 'Cribs, sleepers, toys, and nursery gear.'
  },
  {
    label: 'Batteries & Electronics',
    href: '/battery-recalls',
    count: batteryCount,
    description: 'Power banks, chargers, batteries, and devices.'
  },
  {
    label: 'Food & Allergy',
    href: '/food-allergy-recalls',
    count: foodCount,
    description: 'Food recalls, allergens, UPCs, and lot codes.'
  },
  {
    label: 'Household Products',
    href: '/checker?category=household-appliance',
    count: householdCount,
    description: 'Appliances, furniture, fixtures, and home products.'
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby & Kids</a>
        <a href="/battery-recalls">Batteries & Electronics</a>
        <a href="/food-allergy-recalls">Food & Allergy</a>
      </nav>
    </header>

    <main class="page-shell home-page">
      <section class="home-hero">
        <div class="home-hero-copy">
          <h1>Check recalled products before they stay in your home</h1>
          <p class="lead">
            Search local CPSC and FDA/openFDA recall records by product, brand, model, UPC, lot code, or keyword.
          </p>
          <p class="data-count-line">{countLine}</p>
        </div>

        <div class="home-search-panel" aria-labelledby="hero-search-title">
          <h2 id="hero-search-title">Search the local recall file</h2>
          <form class="home-search-module" action="/checker" method="get">
            <label class="sr-only" for="home-recall-search">Product, brand, model, UPC, lot, or recall number</label>
            <input
              id="home-recall-search"
              name="q"
              type="search"
              placeholder="Search baby sleeper, power bank, pistachio, smoke detector..."
            />
            <button class="btn btn-primary" type="submit">Check recalls</button>
          </form>
          <div class="home-example-links" aria-label="Example searches">
            <span>Try</span>
            <a href="/checker?q=baby%20sleeper">baby sleeper</a>
            <a href="/checker?q=power%20bank">power bank</a>
            <a href="/checker?q=pistachio&source=FDA">pistachio</a>
            <a href="/checker?q=smoke%20detector&source=CPSC">smoke detector</a>
          </div>
        </div>
      </section>

      {featuredRecall ? (
        <section class="section home-featured-section">
          <article class="home-featured-recall">
            <a class="home-featured-image" href={featuredRecall.detailPath} aria-label={`View recall for ${featuredRecall.title}`}>
              {featuredRecall.primaryImageUrl ? (
                <img
                  src={featuredRecall.primaryImageUrl}
                  alt={featuredRecall.primaryImageAlt || featuredRecall.title}
                  loading="lazy"
                />
              ) : (
                <span class="image-placeholder">{featuredRecall.source === 'FDA' ? 'FDA food notice' : 'Recall notice'}</span>
              )}
            </a>
            <div class="home-featured-copy">
              <div class="home-card-meta">
                <span>{featuredRecall.sourceLabel}</span>
                <span>{featuredRecall.recallDate}</span>
              </div>
              <h2><a href={featuredRecall.detailPath}>{featuredRecall.title}</a></h2>
              <p>{featuredRecall.hazard || featuredRecall.reason || 'Hazard/reason not listed in local data'}</p>
              <a class="btn btn-primary" href={featuredRecall.detailPath}>View recall</a>
            </div>
          </article>
        </section>
      ) : null}

      <section class="section home-latest-section">
        <div class="section-header">
          <div>
            <h2>Recently recalled products</h2>
          </div>
          <a class="btn btn-secondary" href="/checker">Search all records</a>
        </div>
        <div class="product-grid">
          {latestRecalls.map((recall) => (
            <article class="home-recall-card product-card">
              <a class="home-card-image image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                {recall.primaryImageUrl ? (
                  <img src={recall.primaryImageUrl} alt={recall.primaryImageAlt || recall.title} loading="lazy" />
                ) : (
                  <span class="image-placeholder">{recall.source === 'FDA' ? 'FDA food notice' : 'Recall notice'}</span>
                )}
              </a>
              <div class="card-body">
                <div class="home-card-meta">
                  <span>{recall.sourceLabel}</span>
                  <span>{recall.recallDate}</span>
                </div>
                <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                <p>{recall.hazard || recall.reason || 'Hazard/reason not listed in local data'}</p>
                <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section home-category-section">
        <div class="section-header">
          <div>
            <h2>Browse recalls by product type</h2>
          </div>
        </div>
        <div class="category-grid">
          {productTypes.map((type) => (
            <a class="category-card" href={type.href}>
              <span class="category-card-body">
                <h3>{type.label}</h3>
                <p>{type.description}</p>
                <span class="category-count">{type.count} local record{type.count === 1 ? '' : 's'}</span>
                <span class="btn btn-link">Browse recalls</span>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section class="section home-watchlist-section">
        <div class="signup-panel compact-cta home-watchlist-cta">
          <div>
            <h2>Monitor saved searches in this browser</h2>
            <p>Local demo only &mdash; no email is sent.</p>
          </div>
          <div class="link-row">
            <a class="btn btn-primary" href="/watchlist">Open watchlist</a>
            <a class="btn btn-secondary" href="/checker?q=pistachio&source=FDA">Try pistachio</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar uses local CPSC and FDA/openFDA processed data when available and local mock fallback data otherwise. Always verify against official recall notices.
    </footer>
  </body>
</html>
