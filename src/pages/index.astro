---
import EuImageResourceHints from '../components/EuImageResourceHints.astro';
import {
  categoryRoutes,
  getRecallsByCategory,
  processedAustraliaProductSafetyRecordCount,
  processedCanadaRecordCount,
  processedCpscRecordCount,
  processedEuSafetyGateRecordCount,
  processedFsanzFoodRecallRecordCount,
  processedFdaRecordCount,
  processedFranceRappelConsoRecordCount,
  processedHongKongCfsRecordCount,
  processedLocalRecordCount,
  processedNewZealandProductSafetyRecordCount,
  processedUkFsaRecordCount,
  siteRecalls
} from '../lib/recall-data';
import { getImageLoadingAttributes, getRecallImageForContext } from '../lib/recall-images';
import { getRecallSourcePlaceholder } from '../lib/recall-sources';
import { getBalancedRecentRecalls } from '../lib/homepage-recent';
import { IDENTIFIER_SEARCH_PLACEHOLDER } from '../lib/identifier-guidance';
import { getSourceLandingPageCards } from '../lib/source-landing-pages';
import '../styles/global.css';

const title = 'Recall Radar | Global product recall search';
const description =
  'Recall Radar helps consumers search official recall information across markets by brand, product name, model number, barcode, lot or batch code, date mark, recall number, ingredient, or keyword.';
const recentRecalls = getBalancedRecentRecalls(siteRecalls, { limit: 12 });
const activeSourceCount = [
  processedCpscRecordCount,
  processedFdaRecordCount,
  processedFranceRappelConsoRecordCount,
  processedCanadaRecordCount,
  processedEuSafetyGateRecordCount,
  processedUkFsaRecordCount,
  processedAustraliaProductSafetyRecordCount,
  processedNewZealandProductSafetyRecordCount,
  processedHongKongCfsRecordCount,
  processedFsanzFoodRecallRecordCount
].filter((count) => count > 0).length;
const countLine = `${processedLocalRecordCount} recalls from ${activeSourceCount} official agencies.`;
const productFamilies = categoryRoutes.map((route) => ({
  ...route,
  icon: route.category,
  count: getRecallsByCategory(route.category).length
}));
const sourcePages = getSourceLandingPageCards();
const sourceCardDetails = {
  '/us-product-recalls': {
    flagSrc: '/flags/us.svg',
    flagAlt: 'United States flag'
  },
  '/canada-product-recalls': {
    flagSrc: '/flags/ca.svg',
    flagAlt: 'Canada flag'
  },
  '/eu-safety-gate-recalls': {
    flagSrc: '/flags/eu.svg',
    flagAlt: 'European Union flag'
  },
  '/france-product-recalls': {
    flagSrc: '/flags/fr.svg',
    flagAlt: 'France flag'
  },
  '/uk-food-recalls': {
    flagSrc: '/flags/gb.svg',
    flagAlt: 'United Kingdom flag'
  },
  '/australia-product-recalls': {
    flagSrc: '/flags/au.svg',
    flagAlt: 'Australia flag'
  },
  '/new-zealand-product-recalls': {
    flagSrc: '/flags/nz.svg',
    flagAlt: 'New Zealand flag'
  },
  '/hong-kong-food-recalls': {
    flagSrc: '/flags/hk.svg',
    flagAlt: 'Hong Kong flag'
  },
  '/australia-new-zealand-food-recalls': {
    flagSrcs: [
      { src: '/flags/au.svg', alt: 'Australia flag' },
      { src: '/flags/nz.svg', alt: 'New Zealand flag' }
    ]
  }
} as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <EuImageResourceHints />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/#browse-recalls">Product Types</a>
        <a href="/#official-sources">Countries</a>
        <a href="/watchlist">Watchlist</a>
      </nav>
    </header>

    <main class="page-shell home-page">
      <section class="home-hero">
        <div class="home-hero-copy">
          <h1>Check if a product has been recalled.</h1>
          <p class="lead">
            Search by brand, product, model, lot or batch code, date mark, recall number, barcode, ingredient, or keyword.
          </p>
        </div>

        <div class="home-search-panel" aria-label="Search product recalls">
          <form class="home-search-module" action="/checker" method="get">
            <label class="sr-only" for="home-recall-search">Brand, product, model, barcode, lot, date, or recall number</label>
            <input
              id="home-recall-search"
              name="q"
              type="search"
              placeholder={IDENTIFIER_SEARCH_PLACEHOLDER}
            />
            <button class="btn btn-primary" type="submit">Check recalls</button>
          </form>
          <div class="home-example-links" aria-label="Example searches">
            <span>Try</span>
            <a href="/checker?q=baby%20sleeper">baby sleeper</a>
            <a href="/checker?q=power%20bank">power bank</a>
            <a href="/checker?q=pistachio&source=FDA">pistachio</a>
            <a href="/checker?q=smoke%20detector&source=CPSC">smoke detector</a>
          </div>
          <p class="data-count-line">{countLine}</p>
        </div>
      </section>

      <section id="browse-recalls" class="section home-category-section">
        <div class="section-header">
          <div>
            <h2>Product types</h2>
          </div>
        </div>
        <div class="category-grid">
          {productFamilies.map((type) => (
            <a class="category-card home-product-type-card" href={type.href}>
              <span class="category-icon" aria-hidden="true">
                {type.icon === 'baby-kids' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M16 18h16" />
                    <path d="M18 18l-2 14h16l-2-14" />
                    <path d="M20 32v6" />
                    <path d="M28 32v6" />
                    <circle cx="18" cy="14" r="4" />
                    <circle cx="30" cy="14" r="4" />
                  </svg>
                ) : type.icon === 'electronics-batteries' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <rect x="9" y="17" width="26" height="16" rx="3" />
                    <path d="M35 22h4v6h-4" />
                    <path d="M23 19l-5 8h6l-3 7 8-10h-6l3-5z" />
                  </svg>
                ) : type.icon === 'food-grocery' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M15 18c5-8 14-8 18 0" />
                    <path d="M12 22h24l-3 15H15z" />
                    <path d="M20 12c3 1 5 3 6 6" />
                    <path d="M29 11c-3 1-5 3-6 7" />
                  </svg>
                ) : type.icon === 'home-appliances' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <rect x="14" y="9" width="20" height="30" rx="4" />
                    <path d="M19 16h10" />
                    <path d="M18 24h12" />
                    <path d="M18 31h12" />
                  </svg>
                ) : type.icon === 'furniture-household' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M14 23h20v15H14z" />
                    <path d="M18 23V12h12v11" />
                    <path d="M14 30H9v8" />
                    <path d="M34 30h5v8" />
                  </svg>
                ) : type.icon === 'vehicles-mobility' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M11 28h26l-4-9H17z" />
                    <path d="M13 28v7h22v-7" />
                    <circle cx="17" cy="36" r="3" />
                    <circle cx="31" cy="36" r="3" />
                  </svg>
                ) : type.icon === 'sports-outdoor' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <circle cx="24" cy="24" r="15" />
                    <path d="M12 24h24" />
                    <path d="M24 9c5 5 7 10 7 15s-2 10-7 15" />
                    <path d="M24 9c-5 5-7 10-7 15s2 10 7 15" />
                  </svg>
                ) : type.icon === 'tools-equipment' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M31 10l7 7-7 7-4-4-13 13-4-4 13-13z" />
                    <path d="M16 34l-4 4" />
                  </svg>
                ) : type.icon === 'clothing-accessories' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M17 12l7 5 7-5 8 8-6 6v12H15V26l-6-6z" />
                    <path d="M20 15c1 3 7 3 8 0" />
                  </svg>
                ) : type.icon === 'health-personal-care' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M21 10h6v11h11v6H27v11h-6V27H10v-6h11z" />
                  </svg>
                ) : type.icon === 'chemicals-cleaning' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M20 8h8" />
                    <path d="M22 8v8l-8 14a7 7 0 0 0 6 10h8a7 7 0 0 0 6-10l-8-14V8" />
                    <path d="M16 31h16" />
                  </svg>
                ) : type.icon === 'pet-products' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <circle cx="17" cy="17" r="4" />
                    <circle cx="31" cy="17" r="4" />
                    <circle cx="14" cy="28" r="4" />
                    <circle cx="34" cy="28" r="4" />
                    <path d="M19 35c2-5 8-5 10 0 2 4-1 7-5 7s-7-3-5-7z" />
                  </svg>
                ) : type.icon === 'industrial-workplace' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M12 37V21l8 6v-6l8 6v-6l8 6v10z" />
                    <path d="M13 21l3-10h6l2 14" />
                    <path d="M17 37v-5h6v5" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M12 18l12-7 12 7v16l-12 7-12-7z" />
                    <path d="M12 18l12 7 12-7" />
                    <path d="M24 25v16" />
                  </svg>
                )}
              </span>
              <span class="category-card-body">
                <h3>{type.label}</h3>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section id="official-sources" class="section home-source-section">
        <div class="section-header">
          <div>
            <h2>Countries & agencies</h2>
          </div>
        </div>
        <div class="category-grid source-country-grid">
          {sourcePages.map((page) => {
            const details = sourceCardDetails[page.route as keyof typeof sourceCardDetails];
            const card = page.card;

            return (
            <a class="category-card source-country-card" href={page.route}>
              <span class:list={['source-flag-wrap', 'flagSrcs' in details && 'source-flag-wrap-pair']}>
                {'flagSrcs' in details ? (
                  details.flagSrcs.map((flag) => (
                    <img class="source-flag source-flag-pair" src={flag.src} alt={flag.alt} loading="lazy" decoding="async" />
                  ))
                ) : (
                  <img class="source-flag" src={details.flagSrc} alt={details.flagAlt} loading="lazy" decoding="async" />
                )}
              </span>
              <span class="category-card-body">
                <span class="source-card-kicker">{card.agencyLabel}</span>
                <h3>{card.title}</h3>
                <span class="source-card-label-row" aria-label={`${card.marketLabel}; ${card.domainLabel}`}>
                  <span class="source-card-pill">{card.marketLabel}</span>
                  <span class="source-card-pill source-card-pill-domain">{card.domainLabel}</span>
                </span>
              </span>
            </a>
            );
          })}
        </div>
      </section>

      <section class="section home-latest-section">
        <div class="section-header">
          <div>
            <h2>Latest recalls</h2>
          </div>
          <a class="btn btn-secondary" href="/checker">Search all recalls</a>
        </div>
        <div class="product-grid">
          {recentRecalls.map((recall, index) => {
            const image = getRecallImageForContext(recall, 'card');
            const imageAttrs = getImageLoadingAttributes('card', index);

            return (
            <article class="home-recall-card product-card">
              <a class="home-card-image image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                {image.url ? (
                  <>
                    <img
                      src={image.url}
                      alt={image.alt}
                      {...imageAttrs}
                      data-fallback-label={getRecallSourcePlaceholder(recall.source)}
                    />
                    <span class="image-placeholder image-placeholder-fallback" hidden>
                      {getRecallSourcePlaceholder(recall.source)}
                    </span>
                  </>
                ) : (
                  <span class="image-placeholder">{getRecallSourcePlaceholder(recall.source)}</span>
                )}
              </a>
              <div class="card-body">
                <div class="home-card-meta">
                  <span>{recall.sourceLabel}</span>
                  <span>{recall.recallDate}</span>
                </div>
                <div class="home-card-meta home-taxonomy-meta">
                  <span>{recall.taxonomyProductFamilyLabel || recall.categoryLabel}</span>
                  {recall.taxonomyHazardTypeLabel ? <span>{recall.taxonomyHazardTypeLabel}</span> : null}
                </div>
                <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                <span class="home-card-hazard">{recall.hazard || recall.reason || 'Hazard or reason not listed in the official notice.'}</span>
                <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
              </div>
            </article>
            );
          })}
        </div>
      </section>

      <section class="section home-watchlist-section">
        <div class="signup-panel compact-cta home-watchlist-cta">
          <div>
            <h2>Monitor saved searches in this browser</h2>
            <p>Saved searches stay on this device. No account or email alerts are enabled yet.</p>
          </div>
          <div class="link-row">
            <a class="btn btn-primary" href="/watchlist">Open watchlist</a>
            <a class="btn btn-secondary" href="/checker?q=pistachio&source=FDA">Try pistachio</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar helps you find possible recalls. Search results are not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.
    </footer>
    <script>
      import { initImageFallbacks } from '../lib/image-fallback';
      import { initProgressiveCardImages } from '../lib/progressive-detail-image';

      initProgressiveCardImages();
      initImageFallbacks();
    </script>
  </body>
</html>
