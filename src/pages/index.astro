---
import { categoryRoutes, mockRecalls } from '../data/mock-recalls';
import { brandToSlug } from '../lib/slug';
import '../styles/global.css';

const title = 'Product Recall Checker | Recall Radar';
const description =
  'Recall Radar is a local MVP product recall checker for searching mock recall data by brand, model, category, or keyword.';
const featuredRecalls = mockRecalls.slice(0, 4);
const brands = [...new Set(mockRecalls.map((recall) => recall.brand))].sort();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/baby-product-recalls">Baby Product Recalls</a>
        <a href="/battery-recalls">Battery Recalls</a>
        <a href="/food-allergy-recalls">Food Allergy Recalls</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="hero">
        <div>
          <p class="eyebrow">Recall Radar</p>
          <h1>Check if a product has been recalled</h1>
          <p class="lead">Search product recalls by brand, model, category, or keyword.</p>
          <div class="category-band" aria-label="Recall categories">
            {categoryRoutes.map((route) => (
              <a class="category-link" href={route.href}>
                {route.label}
                <span>Browse local mock recalls</span>
              </a>
            ))}
          </div>
        </div>
        <section class="search-panel" aria-labelledby="home-search-title">
          <h2 id="home-search-title">Product Recall Checker</h2>
          <form class="search-form" action="/checker" method="get">
            <label>
              Search
              <input name="q" type="search" placeholder="Brand, model, UPC, lot, or keyword" />
            </label>
            <button type="submit">Check</button>
          </form>
        </section>
      </section>

      <section class="section">
        <div class="section-header">
          <h2>Recent Local Mock Recalls</h2>
          <a class="button-link button-secondary" href="/checker">Search all</a>
        </div>
        <div class="grid">
          {featuredRecalls.map((recall) => (
            <article class="recall-card">
              <div class="meta-row">
                <span class="tag">{recall.categoryLabel}</span>
                <span class="tag">{recall.noticeDate}</span>
              </div>
              <h3><a href={`/recalls/${recall.slug}`}>{recall.title}</a></h3>
              <p>{recall.summary}</p>
              <div class="link-row">
                <a href={`/brands/${brandToSlug(recall.brand)}`}>{recall.brand} recall page</a>
                <a href={`/recalls/${recall.slug}`}>Details</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="signup-panel">
          <div>
            <h2>Email Recall Alerts</h2>
            <p>Static signup UI for future alert routing.</p>
          </div>
          <form class="signup-form">
            <label>
              Email
              <input type="email" placeholder="you@example.com" autocomplete="email" />
            </label>
            <button type="button">Notify me</button>
            <p class="form-note">No email is sent or stored in this local MVP.</p>
          </form>
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <h2>Brand Recall Pages</h2>
        </div>
        <div class="tag-row">
          {brands.map((brand) => <a class="tag" href={`/brands/${brandToSlug(brand)}`}>{brand}</a>)}
        </div>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar is using local mock data for this MVP. Always verify against official recall notices.
    </footer>
  </body>
</html>
