---
import {
  brandGroups,
  categoryRoutes,
  dataSourceLabel,
  processedCpscRecordCount,
  processedFdaRecordCount,
  processedLocalRecordCount,
  siteRecalls,
  usingProcessedLocalData
} from '../lib/recall-data';
import '../styles/global.css';

const title = 'Product Recall Checker | Recall Radar';
const description =
  'Recall Radar is a local product recall checker for searching CPSC and FDA/openFDA local data by brand, product, category, or keyword.';
const featuredRecalls = siteRecalls.slice(0, 6);
const latestCpscRecalls = siteRecalls.filter((recall) => recall.source === 'CPSC').slice(0, 3);
const latestFdaRecalls = siteRecalls.filter((recall) => recall.source === 'FDA').slice(0, 3);
const featuredBrands = brandGroups.slice(0, 24);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby Product Recalls</a>
        <a href="/battery-recalls">Battery & Electronics Recalls</a>
        <a href="/food-allergy-recalls">Food Allergy Recalls</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="hero">
        <div>
          <p class="eyebrow">Recall Radar</p>
          <h1>Check if a product has been recalled</h1>
          <p class="lead">Search product recalls by brand, model, category, or keyword.</p>
          <div class="meta-row data-source-row">
            <span class="status-pill">{dataSourceLabel}</span>
          </div>
          <div class="metric-grid" aria-label="Local recall record counts">
            <div class="metric">
              <strong>{usingProcessedLocalData ? processedLocalRecordCount : featuredRecalls.length}</strong>
              <span>{usingProcessedLocalData ? 'Total local records' : 'Demo fallback records'}</span>
            </div>
            <div class="metric">
              <strong>{processedCpscRecordCount}</strong>
              <span>CPSC records</span>
            </div>
            <div class="metric">
              <strong>{processedFdaRecordCount}</strong>
              <span>FDA/openFDA records</span>
            </div>
          </div>
          <div class="category-band" aria-label="Recall categories">
            {categoryRoutes.map((route) => (
              <a class="category-link" href={route.href}>
                {route.label}
                <span>{route.description}</span>
              </a>
            ))}
          </div>
        </div>
        <section class="search-panel" aria-labelledby="home-search-title">
          <h2 id="home-search-title">Product Recall Checker</h2>
          <form class="search-form" action="/checker" method="get">
            <label>
              Search
              <input name="q" type="search" placeholder="Brand, product, model, or keyword" />
            </label>
            <button type="submit">Check</button>
          </form>
          <div class="example-searches" aria-label="Example searches">
            <span>Examples:</span>
            <a class="tag" href="/checker?q=arizer">arizer</a>
            <a class="tag" href="/checker?q=pistachio&source=FDA">pistachio in FDA</a>
            <a class="tag" href="/checker?q=smoke&source=CPSC">smoke in CPSC</a>
          </div>
        </section>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <h2>Latest Recalls by Source</h2>
            <p class="section-note">Separate local CPSC and FDA/openFDA views from the merged local data file.</p>
          </div>
          <a class="button-link button-secondary" href="/checker">Search all</a>
        </div>
        <div class="source-latest-grid">
          <section class="source-latest-column" aria-labelledby="latest-cpsc-title">
            <h3 id="latest-cpsc-title">Local CPSC data</h3>
            {latestCpscRecalls.map((recall) => (
              <article class="recall-card">
                <div class="meta-row">
                  <span class="tag source-tag">{recall.sourceLabel}</span>
                  <span class="tag">{recall.recallDate}</span>
                </div>
                <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                <p>{recall.hazard || recall.description}</p>
                <a href={recall.detailPath}>Details</a>
              </article>
            ))}
          </section>
          <section class="source-latest-column" aria-labelledby="latest-fda-title">
            <h3 id="latest-fda-title">Local FDA/openFDA data</h3>
            {latestFdaRecalls.map((recall) => (
              <article class="recall-card">
                <div class="meta-row">
                  <span class="tag source-tag">{recall.sourceLabel}</span>
                  <span class="tag">{recall.recallDate}</span>
                </div>
                <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                <p>{recall.hazard || recall.reason || recall.description}</p>
                <a href={recall.detailPath}>Details</a>
              </article>
            ))}
          </section>
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <h2>Latest Local Recall Records</h2>
            <p class="section-note">Generated from the local processed recall data file.</p>
          </div>
          <a class="button-link button-secondary" href="/checker">Search all</a>
        </div>
        <div class="grid">
          {featuredRecalls.map((recall) => (
            <article class="recall-card">
              <div class="meta-row">
                <span class="tag source-tag">{recall.sourceLabel}</span>
                <span class="tag">{recall.categoryLabel}</span>
                <span class="tag">{recall.recallDate}</span>
              </div>
              <h3><a href={recall.detailPath}>{recall.title}</a></h3>
              <p>{recall.description}</p>
              <div class="link-row">
                {recall.primaryBrandSlug ? (
                  <a href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} recall page</a>
                ) : null}
                <a href={recall.detailPath}>Details</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="signup-panel">
          <div>
            <h2>Local Watchlist & Alert Demo</h2>
            <p>Save searches and brands in this browser only, then preview matching local recall records.</p>
          </div>
          <div class="link-row">
            <a class="button-link" href="/watchlist">Open watchlist</a>
            <a class="button-link button-secondary" href="/checker?q=pistachio&source=FDA">Try a saved search</a>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <h2>Brand Recall Pages</h2>
        </div>
        <div class="tag-row">
          {featuredBrands.map((group) => <a class="tag" href={`/brands/${group.slug}`}>{group.brand}</a>)}
        </div>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar uses local CPSC and FDA/openFDA processed data when available and local mock fallback data otherwise. Always verify against official recall notices.
    </footer>
  </body>
</html>
