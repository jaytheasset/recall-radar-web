---
import {
  getRecallsByCategory,
  processedCpscRecordCount,
  processedFdaRecordCount,
  processedLocalRecordCount,
  siteRecalls,
  usingProcessedLocalData
} from '../lib/recall-data';
import { sourceLabelForSource } from '../lib/source-display';
import '../styles/global.css';

const title = 'Recall Radar | Product recall search';
const description =
  'Search official recall notices by product, brand, model, UPC, ingredient, or keyword. Recall Radar helps consumers discover possible recall matches and verify official notices.';
const latestRecalls = siteRecalls.slice(0, 6);
const babyCount = getRecallsByCategory('baby-kids').length;
const batteryCount = getRecallsByCategory('battery-electronics').length;
const foodCount = getRecallsByCategory('food-allergy').length;
const householdCount = getRecallsByCategory('household-appliance').length;
const countLine = usingProcessedLocalData
  ? `Currently indexing ${processedLocalRecordCount} official U.S. recall notices · ${processedCpscRecordCount} CPSC · ${processedFdaRecordCount} FDA/openFDA`
  : 'Demo notices are loaded for local preview.';
const productTypes = [
  {
    label: 'Baby & Kids',
    icon: 'baby',
    href: '/baby-product-recalls',
    count: babyCount,
    description: 'Nursery gear and kids products.'
  },
  {
    label: 'Batteries & Electronics',
    icon: 'battery',
    href: '/battery-recalls',
    count: batteryCount,
    description: 'Devices, batteries, and chargers.'
  },
  {
    label: 'Food & Allergy',
    icon: 'food',
    href: '/food-allergy-recalls',
    count: foodCount,
    description: 'Foods, allergens, UPCs, and lots.'
  },
  {
    label: 'Household Products',
    icon: 'household',
    href: '/checker?category=household-appliance',
    count: householdCount,
    description: 'Appliances and home products.'
  }
];

function reasonLabelFor(source: string): string {
  return source === 'FDA' ? 'Reason' : 'Hazard';
}

function reasonTextFor(recall: (typeof siteRecalls)[number]): string {
  return recall.source === 'FDA'
    ? recall.reason || recall.hazard || 'Reason not listed in the indexed notice'
    : recall.hazard || recall.reason || 'Hazard not listed in the indexed notice';
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby & Kids</a>
        <a href="/battery-recalls">Batteries & Electronics</a>
        <a href="/food-allergy-recalls">Food & Allergy</a>
      </nav>
    </header>

    <main class="page-shell home-page">
      <section class="home-hero">
        <div class="home-hero-copy">
          <h1>Find product recalls before they find you.</h1>
          <p class="lead">
            Search official recall notices by product, brand, model, UPC, ingredient, or keyword. Recall Radar helps you discover possible matches and verify them with official sources.
          </p>
        </div>

        <div class="home-search-panel" aria-label="Search official recall notices">
          <form class="home-search-module" action="/checker" method="get">
            <label class="sr-only" for="home-recall-search">Product, brand, model, UPC, ingredient, or keyword</label>
            <input
              id="home-recall-search"
              name="q"
              type="search"
              placeholder="Search baby sleeper, power bank, pistachio, smoke detector..."
            />
            <button class="btn btn-primary" type="submit">Check recalls</button>
          </form>
          <div class="home-example-links" aria-label="Example searches">
            <span>Try</span>
            <a href="/checker?q=baby%20sleeper">baby sleeper</a>
            <a href="/checker?q=power%20bank">power bank</a>
            <a href="/checker?q=pistachio&source=FDA">pistachio</a>
            <a href="/checker?q=smoke%20detector&source=CPSC">smoke detector</a>
          </div>
          <p class="data-count-line">{countLine}</p>
        </div>
      </section>

      <section class="section">
        <article class="notice-panel">
          <p class="eyebrow">Current coverage</p>
          <h2>Official U.S. recall notices</h2>
          <p>
            Recall Radar currently indexes official U.S. recall notices from CPSC consumer product recalls and FDA/openFDA enforcement reports. More regions and source types can be added over time.
          </p>
          <div class="meta-row data-source-row">
            <span class="badge-source">United States · CPSC</span>
            <span class="badge-source">United States · FDA / openFDA</span>
            <span class="tag">{processedLocalRecordCount} indexed notice{processedLocalRecordCount === 1 ? '' : 's'}</span>
          </div>
        </article>
      </section>

      <section class="section home-category-section">
        <div class="section-header">
          <div>
            <h2>Browse recalls by product type</h2>
          </div>
        </div>
        <div class="category-grid">
          {productTypes.map((type) => (
            <a class="category-card home-product-type-card" href={type.href}>
              <span class="category-icon" aria-hidden="true">
                {type.icon === 'baby' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M16 18h16" />
                    <path d="M18 18l-2 14h16l-2-14" />
                    <path d="M20 32v6" />
                    <path d="M28 32v6" />
                    <circle cx="18" cy="14" r="4" />
                    <circle cx="30" cy="14" r="4" />
                  </svg>
                ) : type.icon === 'battery' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <rect x="9" y="17" width="26" height="16" rx="3" />
                    <path d="M35 22h4v6h-4" />
                    <path d="M23 19l-5 8h6l-3 7 8-10h-6l3-5z" />
                  </svg>
                ) : type.icon === 'food' ? (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M15 18c5-8 14-8 18 0" />
                    <path d="M12 22h24l-3 15H15z" />
                    <path d="M20 12c3 1 5 3 6 6" />
                    <path d="M29 11c-3 1-5 3-6 7" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 48 48" role="img">
                    <path d="M10 24l14-12 14 12" />
                    <path d="M14 22v15h20V22" />
                    <path d="M20 37V27h8v10" />
                    <path d="M31 16v-4h4v8" />
                  </svg>
                )}
              </span>
              <span class="category-card-body">
                <h3>{type.label}</h3>
                <p>{type.description}</p>
                <span class="category-count">{type.count} notice{type.count === 1 ? '' : 's'}</span>
                <span class="btn btn-link">Browse recalls</span>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section class="section home-latest-section">
        <div class="section-header">
          <div>
            <h2>Recently recalled products</h2>
          </div>
          <a class="btn btn-secondary" href="/checker">Search all notices</a>
        </div>
        <div class="product-grid">
          {latestRecalls.map((recall) => (
            <article class="home-recall-card product-card">
              <a class="home-card-image image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                {recall.primaryImageUrl ? (
                  <img src={recall.primaryImageUrl} alt={recall.primaryImageAlt || recall.title} loading="lazy" />
                ) : (
                  <span class="image-placeholder">{recall.source === 'FDA' ? 'FDA notice' : 'Recall notice'}</span>
                )}
              </a>
              <div class="card-body">
                <h3><a href={recall.detailPath}>{recall.primaryProductName || recall.title}</a></h3>
                <span class="home-card-hazard">{reasonLabelFor(recall.source)}: {reasonTextFor(recall)}</span>
                {recall.remedy ? <p>Action: {recall.remedy}</p> : null}
                <div class="home-card-meta">
                  <span>{sourceLabelForSource(recall.source)}</span>
                  <span>{recall.categoryLabel}</span>
                  <span>{recall.recallDate}</span>
                </div>
                <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section home-watchlist-section">
        <div class="signup-panel compact-cta home-watchlist-cta">
          <div>
            <h2>Monitor saved searches in this browser</h2>
            <p>Local browser demo only &mdash; no email is sent.</p>
          </div>
          <div class="link-row">
            <a class="btn btn-primary" href="/watchlist">Open watchlist</a>
            <a class="btn btn-secondary" href="/checker?q=pistachio&source=FDA">Try pistachio</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar indexes official recall notices for local search. A match is not a final safety determination; always verify affected models, lots, dates, and remedies with the official notice.
    </footer>
  </body>
</html>
