---
import { getRecallsByCategory } from '../lib/recall-data';
import '../styles/global.css';

const title = 'Battery & Electronics Recall Signals | Recall Radar';
const description =
  'Scan local CPSC battery and electronics recall signals in Recall Radar, including lithium battery packs, power banks, chargers, and electronics.';
const recalls = getRecallsByCategory('battery-electronics');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby & Kids</a>
        <a href="/battery-recalls">Batteries & Electronics</a>
        <a href="/food-allergy-recalls">Food & Allergy</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow">Scan zone</p>
        <div class="meta-row data-source-row">
          <span class="status-pill">Local CPSC data</span>
          <span class="tag">{recalls.length} record{recalls.length === 1 ? '' : 's'}</span>
        </div>
        <h1>Battery & Electronics Recall Signals</h1>
        <p class="lead">A conservative local scan zone for batteries, power banks, charging accessories, and electronics recall signals.</p>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <h2>Source-backed signals</h2>
            <p class="section-note">Shown only when local classification identifies a battery or electronics signal.</p>
          </div>
        </div>
        {recalls.length ? (
          <div class="grid">
            {recalls.map((recall) => (
              <article class="recall-card signal-card">
                <div class="meta-row">
                  <span class="tag source-tag">{recall.sourceLabel}</span>
                  <span class="tag">{recall.recallDate}</span>
                </div>
                <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                <p>Product: {recall.primaryProductName}</p>
                <p>Brand/company: {recall.primaryBrand}</p>
                <p>Hazard signal: {recall.hazard || 'Not listed in local data'}</p>
                <div class="link-row">
                  {recall.primaryBrandSlug ? (
                    <a href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} monitor page</a>
                  ) : null}
                  <a href={recall.detailPath}>Signal report</a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="notice-panel">
            <p>No local CPSC records are currently classified in this scan zone.</p>
          </div>
        )}
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar uses local CPSC and FDA/openFDA processed data when available and local mock fallback data otherwise. Always verify against official recall notices.
    </footer>
  </body>
</html>
