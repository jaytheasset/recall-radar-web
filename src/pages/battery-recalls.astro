---
import EuImageResourceHints from '../components/EuImageResourceHints.astro';
import { getRecallsByCategory } from '../lib/recall-data';
import { categorySearchTextFor } from '../lib/category-search';
import { getNoResultIdentifierHint } from '../lib/identifier-guidance';
import { getRecallImageForContext } from '../lib/recall-images';
import { getRecallSourcePlaceholder } from '../lib/recall-sources';
import '../styles/global.css';

const title = 'Battery & Electronics Product Recalls | Recall Radar';
const description =
  'Browse battery and electronics product recall notices in Recall Radar, including lithium battery packs, power banks, chargers, and devices.';
const recalls = getRecallsByCategory('battery-electronics');
const searchPlaceholder = 'Search batteries, electronics, brand, model, or keyword';
const noResultCopy = getNoResultIdentifierHint();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <EuImageResourceHints />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/recalls/baby-kids">Baby & Kids</a>
        <a href="/recalls/electronics-batteries">Electronics & Batteries</a>
        <a href="/recalls/food-grocery">Food & Grocery</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow">Electronics & Batteries</p>
        <div class="meta-row data-source-row">
          <span class="badge-source">Product family</span>
          <span class="badge-date">{recalls.length} indexed notice{recalls.length === 1 ? '' : 's'}</span>
        </div>
        <h1>Electronics & Batteries product recalls</h1>
        <p class="lead">Battery, power bank, charging accessory, and electronics recall notices.</p>
      </section>

      <section class="section category-search-panel" data-category-search-root data-category-total={recalls.length}>
        <form class="category-search-form" data-category-search-form>
          <label>
            Search within Electronics & Batteries
            <input data-category-search-input type="search" placeholder={searchPlaceholder} autocomplete="off" />
          </label>
          <button class="btn btn-primary" type="submit">Search this type</button>
          <button class="btn btn-secondary" type="button" data-category-search-clear hidden>Clear</button>
        </form>
        <div class="category-search-status">
          <span class="status-pill" data-category-result-count>
            {recalls.length} of {recalls.length} indexed notice{recalls.length === 1 ? '' : 's'} shown
          </span>
        </div>
        <div class="notice-panel category-no-results" data-category-no-results hidden>
          <p>{noResultCopy}</p>
        </div>
      </section>

      <section class="section" data-category-group>
        <div class="section-header">
          <div>
            <h2>Indexed notices</h2>
            <p class="section-note">Shown when classification identifies a battery or electronics product recall.</p>
          </div>
        </div>
        {recalls.length ? (
          <div class="product-grid">
            {recalls.map((recall) => {
              const image = getRecallImageForContext(recall, 'list');

              return (
              <article class="product-card" data-category-card data-search-text={categorySearchTextFor(recall)}>
                <a class="image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                  {image.url ? (
                    <>
                      <img
                        src={image.url}
                        alt={image.alt}
                        loading="lazy"
                        decoding="async"
                        data-fallback-label={getRecallSourcePlaceholder(recall.source)}
                      />
                      <span class="image-placeholder image-placeholder-fallback" hidden>
                        {getRecallSourcePlaceholder(recall.source)}
                      </span>
                    </>
                  ) : (
                    <span class="image-placeholder">{getRecallSourcePlaceholder(recall.source)}</span>
                  )}
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{recall.sourceLabel}</span>
                    <span class="tag">{recall.taxonomyProductFamilyLabel || recall.categoryLabel}</span>
                    {recall.taxonomyHazardTypeLabel ? <span class="badge-danger">{recall.taxonomyHazardTypeLabel}</span> : null}
                    <span class="badge-date">{recall.recallDate}</span>
                  </div>
                  <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                  <p>{recall.hazard || recall.reason || 'Hazard or reason not listed in the indexed notice.'}</p>
                  <div class="link-row">
                    {recall.primaryBrandSlug ? (
                      <a class="btn btn-ghost" href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} page</a>
                    ) : null}
                    <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
                  </div>
                </div>
              </article>
              );
            })}
          </div>
        ) : (
          <div class="notice-panel">
            <p>No indexed notices are currently classified in this product family.</p>
          </div>
        )}
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar helps you find possible recall notices. Search results are not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.
    </footer>
    <script>
      import { initCategoryPageSearch } from '../lib/category-page-search';
      import { initImageFallbacks } from '../lib/image-fallback';
      import { initProgressiveCardImages } from '../lib/progressive-detail-image';

      initProgressiveCardImages();
      initImageFallbacks();
      initCategoryPageSearch();
    </script>
  </body>
</html>
