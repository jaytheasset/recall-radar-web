---
import {
  brandGroups,
  categoryRoutes,
  dataSourceLabel,
  processedCpscRecordCount,
  processedFdaRecordCount,
  processedLocalRecordCount,
  siteRecalls,
  usingProcessedLocalData
} from '../lib/recall-data';
import '../styles/global.css';

const title = 'Product Recall Checker | Recall Radar';
const description =
  'Scan local processed CPSC and FDA/openFDA recall signals with the Recall Radar Product Recall Checker by product name, brand, category, or keyword.';
const featuredBrands = brandGroups.slice(0, 24);
const checkerRecalls = siteRecalls.map((recall) => ({
  id: recall.id,
  source: recall.source,
  sourceLabel: recall.sourceLabel,
  sourceUrl: recall.sourceUrl,
  title: recall.title,
  brandNames: recall.brandNames,
  displayBrandNames: recall.displayBrandNames,
  primaryBrand: recall.primaryBrand,
  primaryBrandRawName: recall.primaryBrandRawName,
  primaryBrandSlug: recall.primaryBrandSlug,
  productNames: recall.productNames,
  primaryProductName: recall.primaryProductName,
  category: recall.category,
  rawCategory: recall.rawCategory,
  categoryLabel: recall.categoryLabel,
  hazard: recall.hazard,
  remedy: recall.remedy,
  recallDate: recall.recallDate,
  affectedUnits: recall.affectedUnits,
  description: recall.description,
  slug: recall.slug,
  detailPath: recall.detailPath,
  classification: recall.classification,
  reason: recall.reason,
  distributionPattern: recall.distributionPattern,
  productQuantity: recall.productQuantity,
  recallNumber: recall.recallNumber,
  status: recall.status
}));
const checkerRecallsJson = JSON.stringify(checkerRecalls);
const sourceOptions = [
  { value: 'all', label: 'All sources' },
  { value: 'CPSC', label: 'CPSC' },
  { value: 'FDA', label: 'FDA/openFDA' }
];
const categoryOptions = [
  { value: 'all', label: 'All categories' },
  { value: 'baby-kids', label: 'Baby and kids' },
  { value: 'battery-electronics', label: 'Battery and electronics' },
  { value: 'food-allergy', label: 'Food and allergy' },
  { value: 'household-appliance', label: 'Household appliance' },
  { value: 'food', label: 'Food' },
  { value: 'general', label: 'General' }
];
const sortOptions = [
  { value: 'best', label: 'Best match' },
  { value: 'newest', label: 'Newest first' },
  { value: 'oldest', label: 'Oldest first' }
];
const dateOptions = [
  { value: 'all', label: 'All time' },
  { value: '30', label: 'Last 30 days' },
  { value: '90', label: 'Last 90 days' }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby & Kids</a>
        <a href="/battery-recalls">Batteries & Electronics</a>
        <a href="/food-allergy-recalls">Food & Allergy</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="section scanner-hero">
        <p class="eyebrow">Product Recall Scanner</p>
        <h1>Scan local recall signals</h1>
        <p class="lead">Search local recall records by keyword, product, brand, model, UPC, lot, or recall number.</p>
        <div class="meta-row data-source-row">
          <span class="status-pill">{dataSourceLabel}</span>
          <span class="tag">
            {usingProcessedLocalData ? `${processedLocalRecordCount} local records` : 'Demo fallback records'}
          </span>
          {usingProcessedLocalData ? (
            <>
              <span class="tag">{processedCpscRecordCount} CPSC</span>
              <span class="tag">{processedFdaRecordCount} FDA/openFDA</span>
            </>
          ) : null}
        </div>

        <section class="search-panel scanner-console" aria-labelledby="checker-form-title">
          <div class="scan-panel-header">
            <div>
              <p class="eyebrow">Scanning console</p>
              <h2 id="checker-form-title">Product Recall Checker</h2>
            </div>
            <span class="tag source-tag">Source-backed records</span>
          </div>
          <form id="recall-search-form" class="search-form checker-search-form">
            <label class="search-query-field">
              Scan term
              <input
                id="recall-query"
                name="q"
                type="search"
                placeholder="Brand, product, model, UPC, lot, or recall number"
                autocomplete="off"
              />
            </label>
            <button type="submit">Scan</button>
            <button id="save-search-watchlist" class="button-secondary" type="button">Monitor this search</button>
            <div class="filter-grid" aria-label="Local recall search filters">
              <label>
                Source
                <select id="source-filter" name="source">
                  {sourceOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                </select>
              </label>
              <label>
                Category
                <select id="category-filter" name="category">
                  {categoryOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                </select>
              </label>
              <label>
                Sort
                <select id="sort-filter" name="sort">
                  {sortOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                </select>
              </label>
              <label>
                Date
                <select id="date-filter" name="date">
                  {dateOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                </select>
              </label>
            </div>
          </form>
          <p id="save-search-status" class="form-note" hidden></p>
          <div class="example-searches" aria-label="Example searches">
            <span>Examples:</span>
            <a class="tag" href="/checker?q=baby%20sleeper">baby sleeper</a>
            <a class="tag" href="/checker?q=power%20bank">power bank</a>
            <a class="tag" href="/checker?q=pistachio&source=FDA">pistachio in FDA</a>
            <a class="tag" href="/checker?q=smoke%20detector&source=CPSC">smoke detector in CPSC</a>
          </div>
          <p class="disclaimer-copy">
            No matching recall found does not guarantee a product is safe. Always verify with the official recall notice, manufacturer, and applicable government agency.
          </p>
          <div id="search-results" class="notice-panel result-panel" hidden>
            <div class="meta-row">
              <span id="result-match" class="status-pill">No local signal</span>
              <span id="result-count" class="tag">0 signals</span>
              <span id="result-filter-summary" class="tag">All local data</span>
            </div>
            <p id="result-summary"></p>
            <p id="result-disclaimer"></p>
            <div id="result-list" class="result-list"></div>
          </div>
        </section>
      </section>

      <section class="section">
        <div class="section-header">
          <h2>Scan Zones</h2>
        </div>
        <div class="category-band">
          {categoryRoutes.map((route) => (
            <a class="category-link" href={route.href}>
              {route.label}
              <span>{route.description}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <h2>Brand Monitor Pages</h2>
        </div>
        <div class="tag-row">
          {featuredBrands.map((group) => <a class="tag" href={`/brands/${group.slug}`}>{group.brand}</a>)}
        </div>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar uses local CPSC and FDA/openFDA processed data when available and local mock fallback data otherwise. Always verify against official recall notices.
    </footer>

    <script id="recall-search-data" type="application/json" is:inline set:html={checkerRecallsJson}></script>
    <script>
      import { MATCH_LABELS, NO_MATCH_DISCLAIMER, searchRecalls } from '../lib/recall-search';
      import { upsertWatchlistSearch } from '../lib/watchlist';

      const dataNode = document.querySelector<HTMLScriptElement>('#recall-search-data');
      const siteRecalls = dataNode?.textContent
        ? (JSON.parse(dataNode.textContent) as Parameters<typeof searchRecalls>[1])
        : [];
      const form = document.querySelector<HTMLFormElement>('#recall-search-form');
      const input = document.querySelector<HTMLInputElement>('#recall-query');
      const sourceFilter = document.querySelector<HTMLSelectElement>('#source-filter');
      const categoryFilter = document.querySelector<HTMLSelectElement>('#category-filter');
      const sortFilter = document.querySelector<HTMLSelectElement>('#sort-filter');
      const dateFilter = document.querySelector<HTMLSelectElement>('#date-filter');
      const saveSearchButton = document.querySelector<HTMLButtonElement>('#save-search-watchlist');
      const saveSearchStatus = document.querySelector<HTMLElement>('#save-search-status');
      const panel = document.querySelector<HTMLElement>('#search-results');
      const matchLabel = document.querySelector<HTMLElement>('#result-match');
      const countLabel = document.querySelector<HTMLElement>('#result-count');
      const filterSummary = document.querySelector<HTMLElement>('#result-filter-summary');
      const summary = document.querySelector<HTMLElement>('#result-summary');
      const disclaimer = document.querySelector<HTMLElement>('#result-disclaimer');
      const list = document.querySelector<HTMLElement>('#result-list');

      type SearchItem = ReturnType<typeof searchRecalls>['items'][number];
      type SourceFilter = 'all' | 'CPSC' | 'FDA';
      type CategoryFilter =
        | 'all'
        | 'baby-kids'
        | 'battery-electronics'
        | 'food-allergy'
        | 'household-appliance'
        | 'food'
        | 'general';
      type SortFilter = 'best' | 'newest' | 'oldest';
      type DateFilter = 'all' | '30' | '90';
      type SearchState = {
        query: string;
        source: SourceFilter;
        category: CategoryFilter;
        sort: SortFilter;
        date: DateFilter;
      };

      const sourceValues: SourceFilter[] = ['all', 'CPSC', 'FDA'];
      const categoryValues: CategoryFilter[] = [
        'all',
        'baby-kids',
        'battery-electronics',
        'food-allergy',
        'household-appliance',
        'food',
        'general'
      ];
      const sortValues: SortFilter[] = ['best', 'newest', 'oldest'];
      const dateValues: DateFilter[] = ['all', '30', '90'];

      function isOneOf<T extends string>(value: string | null, values: readonly T[], fallback: T): T {
        return value && values.includes(value as T) ? (value as T) : fallback;
      }

      function filterRecalls(state: SearchState): typeof siteRecalls {
        const now = Date.now();
        const cutoff =
          state.date === 'all' ? 0 : now - Number(state.date) * 24 * 60 * 60 * 1000;

        return siteRecalls.filter((recall) => {
          const sourceMatches = state.source === 'all' || recall.source === state.source;
          const categoryMatches =
            state.category === 'all' ||
            (state.category === 'food' && (recall.rawCategory === 'food' || recall.source === 'FDA')) ||
            (state.category === 'general' && recall.category === 'general-consumer-product') ||
            recall.category === state.category;
          const recallTime = Date.parse(recall.recallDate);
          const dateMatches = state.date === 'all' || (Number.isFinite(recallTime) && recallTime >= cutoff);

          return sourceMatches && categoryMatches && dateMatches;
        });
      }

      function readState(): SearchState {
        return {
          query: input?.value.trim() ?? '',
          source: isOneOf(sourceFilter?.value ?? null, sourceValues, 'all'),
          category: isOneOf(categoryFilter?.value ?? null, categoryValues, 'all'),
          sort: isOneOf(sortFilter?.value ?? null, sortValues, 'best'),
          date: isOneOf(dateFilter?.value ?? null, dateValues, 'all')
        };
      }

      function writeStateFromUrl(): SearchState {
        const params = new URLSearchParams(window.location.search);
        const state: SearchState = {
          query: params.get('q')?.trim() ?? '',
          source: isOneOf(params.get('source'), sourceValues, 'all'),
          category: isOneOf(params.get('category'), categoryValues, 'all'),
          sort: isOneOf(params.get('sort'), sortValues, 'best'),
          date: isOneOf(params.get('date'), dateValues, 'all')
        };

        if (input) {
          input.value = state.query;
        }
        if (sourceFilter) {
          sourceFilter.value = state.source;
        }
        if (categoryFilter) {
          categoryFilter.value = state.category;
        }
        if (sortFilter) {
          sortFilter.value = state.sort;
        }
        if (dateFilter) {
          dateFilter.value = state.date;
        }

        return state;
      }

      function syncUrl(state: SearchState): void {
        const url = new URL(window.location.href);
        const params = url.searchParams;

        state.query ? params.set('q', state.query) : params.delete('q');
        state.source === 'all' ? params.delete('source') : params.set('source', state.source);
        state.category === 'all' ? params.delete('category') : params.set('category', state.category);
        state.sort === 'best' ? params.delete('sort') : params.set('sort', state.sort);
        state.date === 'all' ? params.delete('date') : params.set('date', state.date);

        window.history.replaceState({}, '', url);
      }

      function hasActiveState(state: SearchState): boolean {
        return Boolean(
          state.query ||
            state.source !== 'all' ||
            state.category !== 'all' ||
            state.sort !== 'best' ||
            state.date !== 'all'
        );
      }

      function createTag(text: string, className = 'tag'): HTMLElement {
        const tag = document.createElement('span');
        tag.className = className;
        tag.textContent = text;
        return tag;
      }

      function createResultCard(item: SearchItem): HTMLElement {
        const { recall, match } = item;
        const article = document.createElement('article');
        article.className = 'recall-card result-card';

        const meta = document.createElement('div');
        meta.className = 'meta-row';

        const heading = document.createElement('h3');
        const detailLink = document.createElement('a');
        detailLink.href = recall.detailPath;
        detailLink.textContent = recall.title;
        heading.append(detailLink);

        const productSummary = document.createElement('p');
        const productText = recall.productNames.length
          ? recall.productNames.slice(0, 3).join(', ')
          : recall.primaryProductName;
        const brandText = recall.displayBrandNames.length
          ? recall.displayBrandNames.slice(0, 3).join(', ')
          : recall.primaryBrand;
        productSummary.textContent = `Product: ${productText}. Brand/company: ${brandText}.`;

        const hazard = document.createElement('p');
        hazard.textContent =
          recall.hazard || recall.reason
            ? `Hazard/reason: ${recall.hazard || recall.reason}`
            : 'Hazard/reason: Not listed in local data.';

        const links = document.createElement('div');
        links.className = 'link-row';

        if (recall.primaryBrandSlug) {
          const brand = document.createElement('a');
          brand.href = `/brands/${recall.primaryBrandSlug}`;
          brand.textContent = `${recall.primaryBrand} monitor page`;
          links.append(brand);
        }

        const details = document.createElement('a');
        details.href = recall.detailPath;
        details.textContent = 'Signal report';

        meta.append(
          createTag(MATCH_LABELS[match].replace(' local match', ''), 'tag match-tag'),
          createTag(recall.sourceLabel, 'tag source-tag'),
          createTag(recall.recallDate),
          createTag(recall.categoryLabel)
        );
        links.append(details);
        article.append(meta, heading, productSummary, hazard, links);

        return article;
      }

      function sortItems(items: SearchItem[], sort: SortFilter): SearchItem[] {
        if (sort === 'best') {
          return items;
        }

        return [...items].sort((a, b) => {
          const comparison = a.recall.recallDate.localeCompare(b.recall.recallDate);
          return sort === 'newest' ? -comparison : comparison;
        });
      }

      function createResultGroup(title: string, items: SearchItem[]): HTMLElement {
        const group = document.createElement('section');
        group.className = 'result-group';

        const heading = document.createElement('h3');
        heading.textContent = `${title} (${items.length})`;

        const cards = document.createElement('div');
        cards.className = 'result-list';
        cards.replaceChildren(...items.map(createResultCard));

        group.append(heading, cards);
        return group;
      }

      function describeFilters(state: SearchState): string {
        const parts = [
          state.source === 'all' ? 'All sources' : state.source === 'FDA' ? 'FDA/openFDA' : 'CPSC',
          state.category === 'all'
            ? 'all categories'
            : state.category === 'general'
              ? 'general'
              : state.category.replace(/-/g, ' '),
          state.date === 'all' ? 'all time' : `last ${state.date} days`,
          state.sort === 'best' ? 'best match' : state.sort === 'newest' ? 'newest first' : 'oldest first'
        ];

        return parts.join(' / ');
      }

      function renderSearch(state: SearchState): void {
        if (!panel || !matchLabel || !countLabel || !filterSummary || !summary || !disclaimer || !list) {
          return;
        }

        const filteredRecalls = filterRecalls(state);
        panel.hidden = false;
        filterSummary.textContent = describeFilters(state);
        disclaimer.textContent = NO_MATCH_DISCLAIMER;

        if (!state.query) {
          panel.dataset.match = 'none';
        matchLabel.textContent = 'Scan local data';
        countLabel.textContent = `${filteredRecalls.length} available record${
          filteredRecalls.length === 1 ? '' : 's'
        }`;
        summary.textContent =
            'Enter a product, brand, model, UPC, lot, recall number, or keyword to scan the filtered local recall data.';
          list.replaceChildren();
          return;
        }

        const result = searchRecalls(state.query, filteredRecalls);
        const sortedItems = sortItems(result.items, state.sort);
        panel.dataset.match = result.match;
        matchLabel.textContent = MATCH_LABELS[result.match];
        countLabel.textContent = `${sortedItems.length} signal${sortedItems.length === 1 ? '' : 's'}`;
        summary.textContent =
          result.match === 'none'
            ? 'No matching recall signal found in the local dataset.'
            : `Recall signals for "${state.query}" with the selected filters.`;

        if (state.sort === 'best') {
          const groupedResults = (['exact', 'possible', 'related'] as const)
            .map((match) => ({
              match,
              items: sortedItems.filter((item) => item.match === match)
            }))
            .filter((group) => group.items.length > 0)
            .map((group) => createResultGroup(MATCH_LABELS[group.match], group.items));
          list.replaceChildren(...groupedResults);
        } else {
          list.replaceChildren(
            ...(sortedItems.length ? [createResultGroup('Sorted recall signals', sortedItems)] : [])
          );
        }
      }

      function updateSearch(): void {
        const state = readState();
        syncUrl(state);
        renderSearch(state);
      }

      function saveCurrentSearch(): void {
        const state = readState();
        if (!saveSearchStatus) {
          return;
        }

        saveSearchStatus.hidden = false;
        if (!state.query) {
          saveSearchStatus.textContent = 'Enter a scan term before monitoring it in the local watchlist.';
          return;
        }

        const item = upsertWatchlistSearch({
          query: state.query,
          source: state.source,
          category: state.category
        });
        saveSearchStatus.textContent = `Monitoring "${item.query}" in this browser's local watchlist.`;
      }

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        updateSearch();
      });

      [sourceFilter, categoryFilter, sortFilter, dateFilter].forEach((filter) => {
        filter?.addEventListener('change', updateSearch);
      });
      saveSearchButton?.addEventListener('click', saveCurrentSearch);

      const initialState = writeStateFromUrl();
      if (hasActiveState(initialState)) {
        renderSearch(initialState);
      }
    </script>
  </body>
</html>
