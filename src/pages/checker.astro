---
import SiteHeader from '../components/SiteHeader.astro';
import EuImageResourceHints from '../components/EuImageResourceHints.astro';
import {
  processedAustraliaProductSafetyRecordCount,
  processedCanadaRecordCount,
  processedCpscRecordCount,
  processedEuSafetyGateRecordCount,
  processedFdaRecordCount,
  processedFsanzFoodRecallRecordCount,
  processedFranceRappelConsoRecordCount,
  processedHongKongCfsRecordCount,
  processedLocalRecordCount,
  processedNewZealandProductSafetyRecordCount,
  processedUkFsaRecordCount,
  siteRecalls
} from '../lib/recall-data';
import { getRecallImageForContext } from '../lib/recall-images';
import { cleanRecallDisplayText } from '../lib/recall-display-text';
import { getSourceOptionsForCurrentCoverage } from '../lib/recall-sources';
import { IDENTIFIER_SEARCH_PLACEHOLDER } from '../lib/identifier-guidance';
import '../styles/global.css';

const title = 'Product Recall Checker | Recall Radar';
const description =
  'Search product recalls by keyword, product, brand, model number, barcode, lot or batch code, date mark, recall number, ingredient, allergen, or official source.';
const activeSourceCount = [
  processedCpscRecordCount,
  processedFdaRecordCount,
  processedFranceRappelConsoRecordCount,
  processedCanadaRecordCount,
  processedEuSafetyGateRecordCount,
  processedUkFsaRecordCount,
  processedAustraliaProductSafetyRecordCount,
  processedNewZealandProductSafetyRecordCount,
  processedHongKongCfsRecordCount,
  processedFsanzFoodRecallRecordCount
].filter((count) => count > 0).length;
const checkerCountLine = `Search ${processedLocalRecordCount} recall notices from ${activeSourceCount} official sources.`;
const checkerRecalls = siteRecalls.map((recall) => {
  const cardImage = getRecallImageForContext(recall, 'list');

  return {
  id: recall.id,
  source: recall.source,
  sourceLabel: recall.sourceLabel,
  sourceUrl: recall.sourceUrl,
  title: recall.title,
  brandNames: recall.brandNames,
  displayBrandNames: recall.displayBrandNames,
  primaryBrand: recall.primaryBrand,
  primaryBrandRawName: recall.primaryBrandRawName,
  primaryBrandSlug: recall.primaryBrandSlug,
  productNames: recall.productNames,
  primaryProductName: recall.primaryProductName,
  category: recall.category,
  rawCategory: recall.rawCategory,
  categoryLabel: recall.categoryLabel,
  taxonomyProductFamily: recall.taxonomyProductFamily,
  taxonomyProductFamilyLabel: recall.taxonomyProductFamilyLabel,
  taxonomyProductType: recall.taxonomyProductType,
  taxonomyProductTypeLabel: recall.taxonomyProductTypeLabel,
  taxonomyHazardType: recall.taxonomyHazardType,
  taxonomyHazardTypeLabel: recall.taxonomyHazardTypeLabel,
  taxonomyHazardTags: recall.taxonomyHazardTags,
  taxonomyRecallDomain: recall.taxonomyRecallDomain,
  taxonomyRecallDomainLabel: recall.taxonomyRecallDomainLabel,
  taxonomyAudienceLabels: recall.taxonomyAudienceLabels,
  taxonomyConfidence: recall.taxonomyConfidence,
  taxonomyNeedsReview: recall.taxonomyNeedsReview,
  taxonomyReason: recall.taxonomyReason,
  hazard: recall.hazard,
  remedy: cleanRecallDisplayText(recall.remedy),
  recallDate: recall.recallDate,
  affectedUnits: recall.affectedUnits,
  description: cleanRecallDisplayText(recall.description),
  slug: recall.slug,
  detailPath: recall.detailPath,
  classification: recall.classification,
  reason: recall.reason,
  distributionPattern: recall.distributionPattern,
  productQuantity: recall.productQuantity,
  recallNumber: recall.recallNumber,
  status: recall.status,
  primaryImageUrl: recall.primaryImageUrl,
  primaryImageThumbnailUrl: recall.primaryImageThumbnailUrl,
  primaryImageAlt: recall.primaryImageAlt,
  cardImageUrl: cardImage.url,
  cardImageAlt: cardImage.alt
  };
});
const checkerRecallsJson = JSON.stringify(checkerRecalls);
const sourceOptions = [
  { value: 'all', label: 'All countries and sources' },
  ...getSourceOptionsForCurrentCoverage()
];
const categoryOptions = [
  { value: 'all', label: 'All product types' },
  { value: 'food-grocery', label: 'Food & Grocery' },
  { value: 'baby-kids', label: 'Baby & Kids' },
  { value: 'electronics-batteries', label: 'Electronics & Batteries' },
  { value: 'home-appliances', label: 'Home Appliances' },
  { value: 'furniture-household', label: 'Furniture & Household' },
  { value: 'vehicles-mobility', label: 'Vehicles & Mobility' },
  { value: 'sports-outdoor', label: 'Sports & Outdoor' },
  { value: 'tools-equipment', label: 'Tools & Equipment' },
  { value: 'clothing-accessories', label: 'Clothing & Accessories' },
  { value: 'health-personal-care', label: 'Health & Personal Care' },
  { value: 'chemicals-cleaning', label: 'Chemicals & Cleaning' },
  { value: 'pet-products', label: 'Pet Products' },
  { value: 'industrial-workplace', label: 'Industrial & Workplace' },
  { value: 'other', label: 'Other' },
  { value: 'unknown', label: 'Need Review' },
  { value: 'general', label: 'Legacy general' }
];
const sortOptions = [
  { value: 'best', label: 'Best match' },
  { value: 'newest', label: 'Newest first' },
  { value: 'oldest', label: 'Oldest first' }
];
const dateOptions = [
  { value: 'all', label: 'All time' },
  { value: '30', label: 'Last 30 days' },
  { value: '90', label: 'Last 90 days' }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <EuImageResourceHints />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteHeader />

    <main class="page-shell checker-page">
      <section class="section">
        <div class="checker-hero">
          <h1>Search recalls</h1>
          <p class="lead">Search by product, brand, model, barcode, lot, date, ingredient, or recall number.</p>
          <p class="checker-count-line">{checkerCountLine}</p>
        </div>

        <section class="search-board" aria-labelledby="checker-form-title">
          <h2 id="checker-form-title" class="sr-only">Recall search</h2>
          <form id="recall-search-form" class="search-form checker-search-form">
            <label class="search-query-field">
              <span class="sr-only">Search term</span>
              <input
                id="recall-query"
                name="q"
                type="search"
                placeholder={IDENTIFIER_SEARCH_PLACEHOLDER}
                autocomplete="off"
              />
            </label>
            <button class="btn btn-primary" type="submit">Search</button>
            <details id="advanced-filters" class="advanced-filters">
              <summary>More filters</summary>
              <div class="filter-grid" aria-label="Recall search filters">
                <label>
                  Country or source
                  <select id="source-filter" name="source">
                    {sourceOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                  </select>
                </label>
                <label>
                  Product type
                  <select id="category-filter" name="category">
                    {categoryOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                  </select>
                </label>
                <label>
                  Date
                  <select id="date-filter" name="date">
                    {dateOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                  </select>
                </label>
                <label>
                  Sort
                  <select id="sort-filter" name="sort">
                    {sortOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                  </select>
                </label>
              </div>
            </details>
          </form>
          <div class="example-searches" aria-label="Example searches">
            <span>Examples:</span>
            <a class="tag" href="/checker?q=baby%20sleeper">baby sleeper</a>
            <a class="tag" href="/checker?q=power%20bank">power bank</a>
            <a class="tag" href="/checker?q=pistachio">pistachio</a>
            <a class="tag" href="/checker?q=smoke%20detector">smoke detector</a>
          </div>
          <p class="disclaimer-copy">
            Results are possible matches. Always check the official notice.
          </p>
          <p class="checker-browse-hint">
            Browse instead:
            <a href="/#browse-recalls">Product types</a>
            <span aria-hidden="true">·</span>
            <a href="/#official-sources">Countries</a>
          </p>
          <button id="save-search-watchlist" class="save-search-link" type="button" hidden>Save this search</button>
          <p id="save-search-status" class="form-note" hidden></p>
          <div id="search-results" class="notice-panel result-panel" hidden>
            <div class="meta-row">
              <span id="result-match" class="status-pill">No clear match</span>
              <span id="result-count" class="tag">0 recalls</span>
              <span id="result-filter-summary" class="tag">All markets</span>
            </div>
            <p id="result-summary"></p>
            <div id="result-list" class="result-list"></div>
            <p id="result-disclaimer"></p>
          </div>
        </section>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar helps you find possible recall notices. Search results are not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.
    </footer>

    <script id="recall-search-data" type="application/json" is:inline set:html={checkerRecallsJson}></script>
    <script>
      import { MATCH_LABELS, SEARCH_RESULTS_DISCLAIMER, searchRecalls } from '../lib/recall-search';
      import { getNoResultIdentifierHint } from '../lib/identifier-guidance';
      import {
        getRecallActionLabel,
        getRecallDefaultActionFallback,
        getRecallReasonLabel,
        getRecallSourceLabel,
        getRecallSourcePlaceholder
      } from '../lib/recall-sources';
      import { initImageFallbacks } from '../lib/image-fallback';
      import { initProgressiveCardImages } from '../lib/progressive-detail-image';
      import { upsertWatchlistSearch, type WatchlistCategoryFilter } from '../lib/watchlist';

      initProgressiveCardImages();
      initImageFallbacks();

      const dataNode = document.querySelector<HTMLScriptElement>('#recall-search-data');
      const siteRecalls = dataNode?.textContent
        ? (JSON.parse(dataNode.textContent) as Parameters<typeof searchRecalls>[1])
        : [];
      const form = document.querySelector<HTMLFormElement>('#recall-search-form');
      const input = document.querySelector<HTMLInputElement>('#recall-query');
      const sourceFilter = document.querySelector<HTMLSelectElement>('#source-filter');
      const categoryFilter = document.querySelector<HTMLSelectElement>('#category-filter');
      const sortFilter = document.querySelector<HTMLSelectElement>('#sort-filter');
      const dateFilter = document.querySelector<HTMLSelectElement>('#date-filter');
      const advancedFilters = document.querySelector<HTMLDetailsElement>('#advanced-filters');
      const saveSearchButton = document.querySelector<HTMLButtonElement>('#save-search-watchlist');
      const saveSearchStatus = document.querySelector<HTMLElement>('#save-search-status');
      const panel = document.querySelector<HTMLElement>('#search-results');
      const matchLabel = document.querySelector<HTMLElement>('#result-match');
      const countLabel = document.querySelector<HTMLElement>('#result-count');
      const filterSummary = document.querySelector<HTMLElement>('#result-filter-summary');
      const summary = document.querySelector<HTMLElement>('#result-summary');
      const disclaimer = document.querySelector<HTMLElement>('#result-disclaimer');
      const list = document.querySelector<HTMLElement>('#result-list');

      type SearchItem = ReturnType<typeof searchRecalls>['items'][number];
      type RecallCardImageFields = {
        cardImageUrl?: string;
        cardImageAlt?: string;
      };
      type BrowseRecall = (typeof siteRecalls)[number] & RecallCardImageFields;
      type SourceFilter =
        | 'all'
        | 'CPSC'
        | 'FDA'
        | 'FR_RAPPELCONSO'
        | 'CA_RECALLS'
        | 'EU_SAFETY_GATE'
        | 'UK_FSA'
        | 'AU_PRODUCT_SAFETY'
        | 'NZ_PRODUCT_SAFETY'
        | 'HK_CFS'
        | 'FSANZ_FOOD_RECALLS';
      type CategoryFilter = WatchlistCategoryFilter;
      type SortFilter = 'best' | 'newest' | 'oldest';
      type DateFilter = 'all' | '30' | '90';
      type SearchState = {
        query: string;
        source: SourceFilter;
        category: CategoryFilter;
        sort: SortFilter;
        date: DateFilter;
      };

      const sourceValues: SourceFilter[] = [
        'all',
        'CPSC',
        'FDA',
        'FR_RAPPELCONSO',
        'CA_RECALLS',
        'EU_SAFETY_GATE',
        'UK_FSA',
        'AU_PRODUCT_SAFETY',
        'NZ_PRODUCT_SAFETY',
        'HK_CFS',
        'FSANZ_FOOD_RECALLS'
      ];
      const categoryValues: CategoryFilter[] = [
        'all',
        'food-grocery',
        'baby-kids',
        'electronics-batteries',
        'home-appliances',
        'furniture-household',
        'vehicles-mobility',
        'sports-outdoor',
        'tools-equipment',
        'clothing-accessories',
        'health-personal-care',
        'chemicals-cleaning',
        'pet-products',
        'industrial-workplace',
        'other',
        'unknown',
        'general'
      ];
      const sortValues: SortFilter[] = ['best', 'newest', 'oldest'];
      const dateValues: DateFilter[] = ['all', '30', '90'];
      const groupTitles = {
        exact: 'Strong matches',
        possible: 'Possible matches',
        related: 'Related notices'
      };
      const categoryFilterLabels: Record<string, string> = {
        all: 'all product types',
        'food-grocery': 'Food & Grocery',
        'baby-kids': 'Baby & Kids',
        'electronics-batteries': 'Electronics & Batteries',
        'home-appliances': 'Home Appliances',
        'furniture-household': 'Furniture & Household',
        'vehicles-mobility': 'Vehicles & Mobility',
        'sports-outdoor': 'Sports & Outdoor',
        'tools-equipment': 'Tools & Equipment',
        'clothing-accessories': 'Clothing & Accessories',
        'health-personal-care': 'Health & Personal Care',
        'chemicals-cleaning': 'Chemicals & Cleaning',
        'pet-products': 'Pet Products',
        'industrial-workplace': 'Industrial & Workplace',
        other: 'Other',
        unknown: 'Need Review',
        general: 'Legacy general'
      };

      function isOneOf<T extends string>(value: string | null, values: readonly T[], fallback: T): T {
        return value && values.includes(value as T) ? (value as T) : fallback;
      }

      function filterRecalls(state: SearchState): typeof siteRecalls {
        const now = Date.now();
        const cutoff =
          state.date === 'all' ? 0 : now - Number(state.date) * 24 * 60 * 60 * 1000;

        return siteRecalls.filter((recall) => {
          const sourceMatches = state.source === 'all' || recall.source === state.source;
          const family = recall.taxonomyProductFamily ?? '';
          const categoryMatches =
            state.category === 'all' ||
            family === state.category ||
            recall.category === state.category ||
            (state.category === 'general' && recall.category === 'general-consumer-product') ||
            (state.category === 'food-grocery' && recall.category === 'food-allergy') ||
            (state.category === 'electronics-batteries' && recall.category === 'battery-electronics') ||
            (state.category === 'household-appliance' &&
              ['home-appliances', 'furniture-household', 'chemicals-cleaning'].includes(family));
          const recallTime = Date.parse(recall.recallDate);
          const dateMatches = state.date === 'all' || (Number.isFinite(recallTime) && recallTime >= cutoff);

          return sourceMatches && categoryMatches && dateMatches;
        });
      }

      function readState(): SearchState {
        return {
          query: input?.value.trim() ?? '',
          source: isOneOf(sourceFilter?.value ?? null, sourceValues, 'all'),
          category: isOneOf(categoryFilter?.value ?? null, categoryValues, 'all'),
          sort: isOneOf(sortFilter?.value ?? null, sortValues, 'best'),
          date: isOneOf(dateFilter?.value ?? null, dateValues, 'all')
        };
      }

      function writeStateFromUrl(): SearchState {
        const params = new URLSearchParams(window.location.search);
        const state: SearchState = {
          query: params.get('q')?.trim() ?? '',
          source: isOneOf(params.get('source'), sourceValues, 'all'),
          category: isOneOf(params.get('category'), categoryValues, 'all'),
          sort: isOneOf(params.get('sort'), sortValues, 'best'),
          date: isOneOf(params.get('date'), dateValues, 'all')
        };

        if (input) {
          input.value = state.query;
        }
        if (sourceFilter) {
          sourceFilter.value = state.source;
        }
        if (categoryFilter) {
          categoryFilter.value = state.category;
        }
        if (sortFilter) {
          sortFilter.value = state.sort;
        }
        if (dateFilter) {
          dateFilter.value = state.date;
        }

        return state;
      }

      function syncUrl(state: SearchState): void {
        const url = new URL(window.location.href);
        const params = url.searchParams;

        state.query ? params.set('q', state.query) : params.delete('q');
        state.source === 'all' ? params.delete('source') : params.set('source', state.source);
        state.category === 'all' ? params.delete('category') : params.set('category', state.category);
        state.sort === 'best' ? params.delete('sort') : params.set('sort', state.sort);
        state.date === 'all' ? params.delete('date') : params.set('date', state.date);

        window.history.replaceState({}, '', url);
      }

      function hasActiveState(state: SearchState): boolean {
        return Boolean(
          state.query ||
            state.source !== 'all' ||
            state.category !== 'all' ||
            state.sort !== 'best' ||
            state.date !== 'all'
        );
      }

      function createTag(text: string, className = 'tag'): HTMLElement {
        const tag = document.createElement('span');
        tag.className = className;
        tag.textContent = text;
        return tag;
      }

      function createImageShell(recall: BrowseRecall): HTMLElement {
        const link = document.createElement('a');
        link.className = 'image-shell';
        link.href = recall.detailPath;
        link.setAttribute('aria-label', `View recall for ${recall.title}`);
        const fallbackLabel = getRecallSourcePlaceholder(recall.source);

        const imageUrl = recall.cardImageUrl || recall.primaryImageUrl;
        const imageAlt = recall.cardImageAlt || recall.primaryImageAlt || recall.title;

        if (imageUrl) {
          const image = document.createElement('img');
          image.src = imageUrl;
          image.alt = imageAlt;
          image.loading = 'lazy';
          image.setAttribute('decoding', 'async');
          image.dataset.fallbackLabel = fallbackLabel;

          const placeholder = document.createElement('span');
          placeholder.className = 'image-placeholder image-placeholder-fallback';
          placeholder.textContent = fallbackLabel;
          placeholder.hidden = true;

          image.addEventListener('error', () => {
            image.hidden = true;
            placeholder.hidden = false;
            link.classList.add('image-shell-fallback');
          });

          link.append(image, placeholder);
          return link;
        }

        const placeholder = document.createElement('span');
        placeholder.className = 'image-placeholder';
        placeholder.textContent = fallbackLabel;
        link.append(placeholder);
        return link;
      }

      function reasonLabelFor(recall: SearchItem['recall']): string {
        return getRecallReasonLabel(recall.source);
      }

      function reasonTextFor(recall: SearchItem['recall']): string {
        return recall.hazard || recall.reason || 'Not listed in the recall notice.';
      }

      function actionTextFor(recall: SearchItem['recall']): string {
        return recall.remedy || getRecallDefaultActionFallback(recall.source);
      }

      function productTextFor(recall: SearchItem['recall']): string {
        return recall.productNames.length
          ? recall.productNames.slice(0, 3).join(', ')
          : recall.primaryProductName;
      }

      function brandTextFor(recall: SearchItem['recall']): string {
        return recall.displayBrandNames.length
          ? recall.displayBrandNames.slice(0, 3).join(', ')
          : recall.primaryBrand;
      }

      function createCardLine(label: string, value: string, className = 'result-card-line'): HTMLElement {
        const line = document.createElement('p');
        line.className = className;
        const strong = document.createElement('strong');
        strong.textContent = `${label}: `;
        line.append(strong, value);
        return line;
      }

      function taxonomyTextFor(recall: SearchItem['recall']): string {
        return [
          recall.taxonomyProductFamilyLabel,
          recall.taxonomyProductTypeLabel,
          recall.taxonomyHazardTypeLabel
        ].filter(Boolean).join(' / ') || recall.categoryLabel;
      }

      function createResultCard(item: SearchItem): HTMLElement {
        const { recall, match } = item;
        const article = document.createElement('article');
        article.className = 'product-card result-card';

        const body = document.createElement('div');
        body.className = 'card-body';

        const meta = document.createElement('div');
        meta.className = 'meta-row result-card-badges';
        meta.append(
          createTag(MATCH_LABELS[match], 'badge-danger'),
          createTag(recall.sourceLabel, 'badge-source'),
          createTag(recall.taxonomyProductFamilyLabel || recall.categoryLabel),
          ...(recall.taxonomyHazardTypeLabel ? [createTag(recall.taxonomyHazardTypeLabel, 'badge-danger')] : []),
          createTag(recall.recallDate, 'badge-date')
        );

        const heading = document.createElement('h3');
        const detailLink = document.createElement('a');
        detailLink.href = recall.detailPath;
        detailLink.textContent = recall.title;
        heading.append(detailLink);

        const reason = createCardLine(reasonLabelFor(recall), reasonTextFor(recall), 'result-card-line result-card-reason');
        const action = createCardLine(getRecallActionLabel(recall.source), actionTextFor(recall), 'result-card-line result-card-action');
        const product = createCardLine('Product', productTextFor(recall));
        const brand = createCardLine('Brand/company', brandTextFor(recall));
        const taxonomy = createCardLine('Classification', taxonomyTextFor(recall), 'result-card-line taxonomy-card-line');
        const matchReason = createCardLine('Match reason', item.matchReasonLabel, 'result-card-line match-reason-line');
        const identifierHint = document.createElement('p');
        identifierHint.className = 'identifier-hint';
        identifierHint.textContent = item.identifierHint;

        const links = document.createElement('div');
        links.className = 'link-row';

        const details = document.createElement('a');
        details.className = 'btn btn-primary';
        details.href = recall.detailPath;
        details.textContent = 'View recall';

        links.append(details);
        body.append(heading, reason, action, product, brand, taxonomy, matchReason, identifierHint, meta, links);
        article.append(createImageShell(recall), body);

        return article;
      }

      function createBrowseCard(recall: BrowseRecall): HTMLElement {
        const article = document.createElement('article');
        article.className = 'product-card result-card';

        const body = document.createElement('div');
        body.className = 'card-body';

        const meta = document.createElement('div');
        meta.className = 'meta-row result-card-badges';
        meta.append(
          createTag(recall.sourceLabel, 'badge-source'),
          createTag(recall.taxonomyProductFamilyLabel || recall.categoryLabel),
          ...(recall.taxonomyHazardTypeLabel ? [createTag(recall.taxonomyHazardTypeLabel, 'badge-danger')] : []),
          createTag(recall.recallDate, 'badge-date')
        );

        const heading = document.createElement('h3');
        const detailLink = document.createElement('a');
        detailLink.href = recall.detailPath;
        detailLink.textContent = recall.title;
        heading.append(detailLink);

        const reason = createCardLine(reasonLabelFor(recall), reasonTextFor(recall), 'result-card-line result-card-reason');
        const action = createCardLine(getRecallActionLabel(recall.source), actionTextFor(recall), 'result-card-line result-card-action');
        const product = createCardLine('Product', productTextFor(recall));
        const brand = createCardLine('Brand/company', brandTextFor(recall));
        const taxonomy = createCardLine('Classification', taxonomyTextFor(recall), 'result-card-line taxonomy-card-line');

        const links = document.createElement('div');
        links.className = 'link-row';

        const details = document.createElement('a');
        details.className = 'btn btn-primary';
        details.href = recall.detailPath;
        details.textContent = 'View recall';

        links.append(details);
        body.append(heading, reason, action, product, brand, taxonomy, meta, links);
        article.append(createImageShell(recall), body);

        return article;
      }

      function createNoResultState(): HTMLElement {
        const emptyState = document.createElement('div');
        emptyState.className = 'no-result-state';

        const heading = document.createElement('h3');
        heading.textContent = 'No clear match found';

        const body = document.createElement('p');
        body.textContent = getNoResultIdentifierHint();

        const suggestionList = document.createElement('ul');
        suggestionList.className = 'no-result-suggestions';
        [
          'Brand or company name',
          'Model number or item number',
          'Barcode, UPC, GTIN, or EAN when listed',
          'Lot, batch, or date mark',
          'Pack size, certification number, or recall number',
          'Ingredient or allergen',
          'Product type or family'
        ].forEach((text) => {
          const item = document.createElement('li');
          item.textContent = text;
          suggestionList.append(item);
        });

        emptyState.append(heading, body, suggestionList);
        return emptyState;
      }

      function sortItems(items: SearchItem[], sort: SortFilter): SearchItem[] {
        if (sort === 'best') {
          return items;
        }

        return [...items].sort((a, b) => {
          const comparison = a.recall.recallDate.localeCompare(b.recall.recallDate);
          return sort === 'newest' ? -comparison : comparison;
        });
      }

      function sortBrowseRecalls(recalls: typeof siteRecalls, sort: SortFilter): BrowseRecall[] {
        if (sort === 'best') {
          return recalls as BrowseRecall[];
        }

        return [...recalls].sort((a, b) => {
          const comparison = a.recallDate.localeCompare(b.recallDate);
          return sort === 'newest' ? -comparison : comparison;
        }) as BrowseRecall[];
      }

      function createResultGroup(title: string, items: SearchItem[]): HTMLElement {
        const group = document.createElement('section');
        group.className = 'result-group';

        const heading = document.createElement('h3');
        heading.textContent = `${title} (${items.length})`;

        const cards = document.createElement('div');
        cards.className = 'product-grid';
        cards.replaceChildren(...items.map(createResultCard));

        group.append(heading, cards);
        return group;
      }

      function createBrowseGroup(title: string, recalls: BrowseRecall[]): HTMLElement {
        const group = document.createElement('section');
        group.className = 'result-group';

        const heading = document.createElement('h3');
        heading.textContent = `${title} (${recalls.length})`;

        const cards = document.createElement('div');
        cards.className = 'product-grid';
        cards.replaceChildren(...recalls.map(createBrowseCard));

        group.append(heading, cards);
        return group;
      }

      function describeFilters(state: SearchState): string {
        const parts = [
          state.source === 'all' ? 'All countries and sources' : getRecallSourceLabel(state.source),
          categoryFilterLabels[state.category],
          state.date === 'all' ? 'all time' : `last ${state.date} days`,
          state.sort === 'best' ? 'best match' : state.sort === 'newest' ? 'newest first' : 'oldest first'
        ];

        return parts.join(' / ');
      }

      function renderSearch(state: SearchState): void {
        if (!panel || !matchLabel || !countLabel || !filterSummary || !summary || !disclaimer || !list) {
          return;
        }

        const filteredRecalls = filterRecalls(state);
        panel.hidden = false;
        filterSummary.textContent = describeFilters(state);
        disclaimer.textContent = SEARCH_RESULTS_DISCLAIMER;
        if (saveSearchButton) {
          saveSearchButton.hidden = !state.query;
        }

        if (!state.query) {
          const browseRecalls = sortBrowseRecalls(filteredRecalls, state.sort);
          const shouldShowBrowseResults =
            state.source !== 'all' || state.category !== 'all' || state.date !== 'all';

          panel.dataset.match = 'none';
          matchLabel.textContent = shouldShowBrowseResults ? 'Filtered notices' : 'Recall notices';
          countLabel.textContent = `${browseRecalls.length} recall notice${
            browseRecalls.length === 1 ? '' : 's'
          }`;
          summary.textContent =
            shouldShowBrowseResults
              ? `Showing recall notices for ${describeFilters(state)}.`
              : 'Search by product, brand, model, barcode, lot, date, ingredient, or recall number.';
          list.replaceChildren(
            ...(shouldShowBrowseResults
              ? browseRecalls.length
                ? [createBrowseGroup('Matching recall notices', browseRecalls)]
                : [createNoResultState()]
              : [])
          );
          initProgressiveCardImages();
          return;
        }

        const result = searchRecalls(state.query, filteredRecalls);
        const sortedItems = sortItems(result.items, state.sort);
        panel.dataset.match = result.match;
        matchLabel.textContent = MATCH_LABELS[result.match];
        countLabel.textContent = `${sortedItems.length} recall notice${sortedItems.length === 1 ? '' : 's'}`;
        summary.textContent =
          result.match === 'none' ? 'No clear match found.' : `Possible recall matches for "${state.query}".`;

        if (result.match === 'none') {
          list.replaceChildren(createNoResultState());
          initProgressiveCardImages();
          return;
        }

        if (state.sort === 'best') {
          const groupedResults = (['exact', 'possible', 'related'] as const)
            .map((match) => ({
              match,
              items: sortedItems.filter((item) => item.match === match)
            }))
            .filter((group) => group.items.length > 0)
            .map((group) => createResultGroup(groupTitles[group.match], group.items));
          list.replaceChildren(...groupedResults);
        } else {
          list.replaceChildren(
            ...(sortedItems.length ? [createResultGroup('Sorted recall results', sortedItems)] : [])
          );
        }
        initProgressiveCardImages();
      }

      function updateSearch(): void {
        const state = readState();
        syncUrl(state);
        renderSearch(state);
      }

      function saveCurrentSearch(): void {
        const state = readState();
        if (!saveSearchStatus) {
          return;
        }

        saveSearchStatus.hidden = false;
        if (!state.query) {
          saveSearchStatus.textContent = 'Enter a search term before saving it in this browser.';
          return;
        }

        const item = upsertWatchlistSearch({
          query: state.query,
          source: state.source,
          category: state.category
        });
        saveSearchStatus.textContent = `Saved "${item.query}" in this browser.`;
      }

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        updateSearch();
      });

      [sourceFilter, categoryFilter, sortFilter, dateFilter].forEach((filter) => {
        filter?.addEventListener('change', updateSearch);
      });
      saveSearchButton?.addEventListener('click', saveCurrentSearch);

      const initialState = writeStateFromUrl();
      if (
        advancedFilters &&
        (initialState.source !== 'all' ||
          initialState.category !== 'all' ||
          initialState.date !== 'all' ||
          initialState.sort !== 'best')
      ) {
        advancedFilters.open = true;
      }
      if (hasActiveState(initialState)) {
        renderSearch(initialState);
      }
    </script>
  </body>
</html>
