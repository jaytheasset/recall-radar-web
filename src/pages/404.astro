---
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

const title = 'Page not found | Recall Radar';
const description = 'The requested Recall Radar page could not be found.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteHeader />

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow" data-i18n="error.pageNotFoundEyebrow">Page not found</p>
        <h1 data-i18n="error.pageNotFound">Page not found</h1>
        <p class="lead">
          We could not find that page. Search recall notices or return to the homepage.
        </p>
        <div class="link-row">
          <a class="btn btn-primary" href="/checker" data-i18n="home.searchButton">Search recalls</a>
          <a class="btn btn-secondary" href="/">Go home</a>
        </div>
      </section>

      <section class="section">
        <div class="notice-panel">
          <p data-i18n="disclaimer.possibleMatches">
            Search results are possible matches, not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.
          </p>
        </div>
      </section>
    </main>

    <footer class="page-footer">
      <span data-i18n="footer.disclaimer">Recall Radar helps you find possible recall notices. Search results are not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.</span>
    </footer>
  </body>
</html>
