---
import { siteRecalls } from '../../lib/recall-data';
import { NO_MATCH_DISCLAIMER } from '../../lib/recall-search';
import '../../styles/global.css';

export function getStaticPaths() {
  return siteRecalls.map((recall) => ({
    params: { slug: recall.slug },
    props: { recall }
  }));
}

const { recall } = Astro.props;
const title = `${recall.title} | Recall Radar`;
const description = `${recall.title} local recall record with source, product, brand, hazard, remedy, affected units, and official notice link.`;
const sourceLinkLabel = recall.source === 'FDA' ? 'Official FDA/openFDA reference' : 'Official CPSC notice';
const sourceLinkText = recall.source === 'FDA' ? 'Open official FDA/openFDA reference' : 'Open official CPSC notice';
const displayBrandNames = recall.displayBrandNames.length ? recall.displayBrandNames : [recall.primaryBrand];
const sourceBrandNames = recall.brandNames.filter(
  (rawName: string) => !displayBrandNames.some((displayName: string) => displayName.toLowerCase() === rawName.toLowerCase())
);
const galleryImages = recall.images.length ? recall.images : [];
const whatToCheckItems = [
  'Compare the product name, model, UPC, lot code, and brand or company names against the official notice.',
  'Review the hazard and remedy fields before using, selling, donating, repairing, or disposing of the product.',
  'Use the official agency notice and manufacturer or recalling firm instructions for the most authoritative next steps.'
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby & Kids</a>
        <a href="/battery-recalls">Batteries & Electronics</a>
        <a href="/food-allergy-recalls">Food & Allergy</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow">Recall report</p>
        <div class="meta-row data-source-row">
          <span class="badge-source">{recall.sourceLabel}</span>
          <span class="badge-date">{recall.recallDate}</span>
          <span class="tag">{recall.categoryLabel}</span>
        </div>
        <h1>{recall.title}</h1>
        <p class="lead">{recall.description}</p>
      </section>

      <section class="section detail-grid">
        <div class="detail-gallery" aria-label="Product images">
          <div class="image-shell image-shell-large">
            {recall.primaryImageUrl ? (
              <img src={recall.primaryImageUrl} alt={recall.primaryImageAlt || recall.title} loading="lazy" />
            ) : (
              <span class="image-placeholder">{recall.source === 'FDA' ? 'FDA food notice' : 'Recall notice'}</span>
            )}
          </div>
          {galleryImages.length > 1 ? (
            <div class="thumbnail-grid" aria-label="Additional product images">
              {galleryImages.slice(1, 7).map((image) => (
                <div class="image-shell">
                  <img src={image.url} alt={image.alt || image.caption || recall.title} loading="lazy" />
                </div>
              ))}
            </div>
          ) : null}
        </div>

        <aside class="detail-card recall-summary-card" aria-label="Recall summary">
          <h2>Recall summary</h2>
          <div class="facts">
            <div class="fact">
              <strong>Source</strong>
              <span>{recall.sourceLabel}</span>
            </div>
            <div class="fact">
              <strong>Recall date</strong>
              <span>{recall.recallDate}</span>
            </div>
            <div class="fact">
              <strong>Hazard</strong>
              <span>{recall.hazard || recall.reason || 'Not listed in local data'}</span>
            </div>
            <div class="fact">
              <strong>Remedy</strong>
              <span>{recall.remedy || 'Not listed in local data'}</span>
            </div>
            <div class="fact">
              <strong>Affected units</strong>
              <span>{recall.affectedUnits || recall.productQuantity || 'Not listed in local data'}</span>
            </div>
            <div class="fact">
              <strong>Record ID</strong>
              <span>{recall.id}</span>
            </div>
            <div class="fact">
              <strong>{sourceLinkLabel}</strong>
              {recall.sourceUrl ? (
                <a class="btn btn-primary official-source-link" href={recall.sourceUrl}>{sourceLinkText}</a>
              ) : (
                <span>Not listed</span>
              )}
            </div>
          </div>
        </aside>
      </section>

      <section class="section detail-grid">
        <article class="detail-card">
          <h2>Affected products</h2>
          <div class="facts">
            <div class="fact">
              <strong>Products</strong>
              <span>{recall.productNames.length ? recall.productNames.join(', ') : recall.primaryProductName}</span>
            </div>
            <div class="fact">
              <strong>Brands / companies</strong>
              <span>{displayBrandNames.join(', ')}</span>
            </div>
            {sourceBrandNames.length ? (
              <div class="fact">
                <strong>Raw source names</strong>
                <span>{sourceBrandNames.join(', ')}</span>
              </div>
            ) : null}
            {recall.classification ? (
              <div class="fact">
                <strong>Classification</strong>
                <span>{recall.classification}</span>
              </div>
            ) : null}
            {recall.status ? (
              <div class="fact">
                <strong>Status</strong>
                <span>{recall.status}</span>
              </div>
            ) : null}
            {recall.recallNumber ? (
              <div class="fact">
                <strong>Recall number</strong>
                <span>{recall.recallNumber}</span>
              </div>
            ) : null}
            {recall.distributionPattern ? (
              <div class="fact">
                <strong>Distribution</strong>
                <span>{recall.distributionPattern}</span>
              </div>
            ) : null}
          </div>
        </article>

        <article class="detail-card">
          <h2>What to check</h2>
          <ul class="check-list">
            {whatToCheckItems.map((item) => <li>{item}</li>)}
          </ul>
          <p class="disclaimer-copy">{NO_MATCH_DISCLAIMER}</p>
        </article>
      </section>

      <section class="section">
        <div class="link-row">
          <a class="btn btn-primary" href="/checker">Check another product</a>
          {recall.primaryBrandSlug ? (
            <a class="btn btn-secondary" href={`/brands/${recall.primaryBrandSlug}`}>
              Monitor this brand locally
            </a>
          ) : null}
        </div>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar uses local CPSC and FDA/openFDA processed data when available and local mock fallback data otherwise. Always verify against official recall notices.
    </footer>
  </body>
</html>
