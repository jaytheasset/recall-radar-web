---
import EuImageResourceHints from '../../components/EuImageResourceHints.astro';
import { categoryRoutes, siteRecalls } from '../../lib/recall-data';
import { buildRecallDetailView, recallSourceBadge } from '../../lib/recall-detail-view';
import {
  getDetailHeroImagePreloadAttributes,
  getDetailHeroImageSources,
  getRecallImageForContext
} from '../../lib/recall-images';
import { getRecallSourcePlaceholder } from '../../lib/recall-sources';
import '../../styles/global.css';

export function getStaticPaths() {
  return siteRecalls.map((recall) => ({
    params: { slug: recall.slug },
    props: { recall }
  }));
}

const { recall } = Astro.props;
const view = buildRecallDetailView(recall, siteRecalls);
const categoryRoute = categoryRoutes.find((route) => route.category === recall.category);
const categoryFallbackPath = categoryRoute?.href ?? `/checker?category=${recall.category}`;
const companyDetails = [
  { label: 'Importer', value: view.importer },
  { label: 'Manufacturer', value: view.manufacturer },
  { label: 'Manufactured in', value: view.manufacturedIn }
].filter((fact) => fact.value.length > 0);
const title = `${view.displayTitle} | Recall Radar`;
const description = `${view.displayTitle} with product photos, affected item details, reason for recall, consumer action, and official source link.`;
const fallbackImageLabel = getRecallSourcePlaceholder(recall.source);
const hasSparseIdentificationDetails = view.identificationDetails.length < 4;
const detailHeroImage = view.productImages[0];
const detailHeroSources = getDetailHeroImageSources(recall, detailHeroImage);
const detailHeroImageAttrs = {
  loading: detailHeroSources.loading,
  decoding: detailHeroSources.decoding,
  ...(detailHeroSources.fetchpriority ? { fetchpriority: detailHeroSources.fetchpriority } : {})
};
const detailHeroPreloadAttrs = getDetailHeroImagePreloadAttributes(recall, detailHeroImage);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <EuImageResourceHints />
    {detailHeroPreloadAttrs ? <link rel="preload" as="image" {...detailHeroPreloadAttrs} /> : null}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby & Kids</a>
        <a href="/battery-recalls">Batteries & Electronics</a>
        <a href="/food-allergy-recalls">Food & Allergy</a>
      </nav>
    </header>

    <main class="page-shell detail-report-page">
      <section class="section detail-report-hero">
        <p class="eyebrow">Recall report</p>
        <div class="meta-row data-source-row">
          <span class="badge-source">{view.sourceBadge}</span>
          <span class="badge-date">{view.recallDate}</span>
          <span class="tag">{view.categoryLabel}</span>
        </div>
        <h1 class="detail-title">{view.displayTitle}</h1>
        <p class="lead detail-intro">{view.introSentence}</p>
      </section>

      <section class="section detail-grid detail-main-grid">
        <article class="detail-gallery-card" aria-label="Product images">
          <div class="detail-gallery">
            <figure class="detail-image-figure">
              <div class="image-shell image-shell-large">
                {detailHeroImage ? (
                  <>
                    <img
                      class:list={[detailHeroSources.isProgressive && 'progressive-detail-hero-image']}
                      src={detailHeroSources.initialSrc || detailHeroImage.url}
                      alt={detailHeroImage.alt || view.primaryImageAlt}
                      data-full-src={detailHeroSources.isProgressive ? detailHeroSources.fullSrc : undefined}
                      data-thumbnail-src={detailHeroSources.isProgressive ? detailHeroSources.thumbnailSrc : undefined}
                      {...detailHeroImageAttrs}
                      data-fallback-label={fallbackImageLabel}
                    />
                    <span class="image-placeholder image-placeholder-fallback" hidden>{fallbackImageLabel}</span>
                  </>
                ) : (
                  <span class="image-placeholder">{fallbackImageLabel}</span>
                )}
              </div>
              {detailHeroImage?.caption ? <figcaption>{detailHeroImage.caption}</figcaption> : null}
            </figure>
            {view.productImages.length > 1 ? (
              <div class="thumbnail-grid detail-thumbnail-grid" aria-label="Additional product images">
                {view.productImages.slice(1, 7).map((image) => (
                  <figure class="detail-thumbnail">
                    <div class="image-shell">
                      <img
                        src={image.url}
                        alt={image.alt || image.caption || view.primaryImageAlt}
                        loading="lazy"
                        decoding="async"
                        data-fallback-label={fallbackImageLabel}
                      />
                      <span class="image-placeholder image-placeholder-fallback" hidden>{fallbackImageLabel}</span>
                    </div>
                    {image.caption ? <figcaption>{image.caption}</figcaption> : null}
                  </figure>
                ))}
              </div>
            ) : null}
          </div>
        </article>

        <aside class="detail-card recall-summary-card compact-summary-card" aria-label="Recall summary">
          <h2>Recall summary</h2>
          <div class="summary-list">
            <div class="summary-item">
              <strong>{view.reasonLabel}</strong>
              <p>{view.reason}</p>
            </div>
            <div class="summary-item">
              <strong>{view.actionLabel}</strong>
              <p>{view.action}</p>
            </div>
            <div class="summary-meta-row">
              <span>
                <strong>Recall date</strong>
                {view.recallDate}
              </span>
              {view.units ? (
                <span>
                  <strong>{view.quantityLabel}</strong>
                  {view.units}
                </span>
              ) : null}
            </div>
          </div>
          {view.officialSourceUrl ? (
            <a class="source-link source-link-small" href={view.officialSourceUrl} target="_blank" rel="noopener noreferrer">
              View official notice
            </a>
          ) : null}
        </aside>
      </section>

      <section class="section">
        <article class="detail-card detail-section-card identification-guide-card">
          <div class="section-header">
            <div>
              <p class="eyebrow">Check your product</p>
              <h2>How to verify product details</h2>
              <p class="section-note">{view.verificationIntro}</p>
            </div>
          </div>
          <div class="verification-layout">
            <section class="verification-panel" aria-labelledby="what-to-compare">
              <h3 id="what-to-compare">What to compare</h3>
              <ul class="verification-checklist">
                {view.verificationChecklist.map((item) => <li>{item}</li>)}
              </ul>
              <p class="verification-note">{view.detailSafetyCopy}</p>
              {hasSparseIdentificationDetails ? <p class="verification-note">{view.sparseIdentificationCopy}</p> : null}
            </section>
            <section class="verification-panel" aria-labelledby="details-found">
              <h3 id="details-found">Details found in this notice</h3>
              {view.identificationDetails.length ? (
                <div class="detail-fact-grid">
                  {view.identificationDetails.map((fact) => (
                    <div class="detail-fact">
                      <strong>{fact.label}</strong>
                      {Array.isArray(fact.value) ? (
                        <ul>
                          {fact.value.map((item) => <li>{item}</li>)}
                        </ul>
                      ) : (
                        <span>{fact.value}</span>
                      )}
                    </div>
                  ))}
                </div>
              ) : (
                <p class="verification-note">{view.sparseIdentificationCopy}</p>
              )}
            </section>
          </div>
        </article>
      </section>

      {view.actionParagraphs.length ? (
        <section class="section">
          <article class="detail-card detail-section-card">
            <div class="section-header">
              <div>
                <p class="eyebrow">Action</p>
                <h2>What to do next</h2>
              </div>
            </div>
            <div class="detail-prose">
              {view.actionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            {view.consumerContact ? (
              <div class="detail-fact-grid detail-action-facts">
                <div class="detail-fact">
                  <strong>Consumer contact</strong>
                  <span>{view.consumerContact}</span>
                </div>
              </div>
            ) : null}
          </article>
        </section>
      ) : null}

      {view.soldAt.length ? (
        <section class="section">
          <article class="detail-card detail-section-card">
            <div class="section-header">
              <div>
                <p class="eyebrow">Purchase details</p>
                <h2>Where it was sold</h2>
              </div>
            </div>
            <div class="detail-fact-grid">
              <div class="detail-fact">
                <strong>{view.distributionLabel}</strong>
                <ul>
                  {view.soldAt.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
          </article>
        </section>
      ) : null}

      {companyDetails.length ? (
        <section class="section">
          <article class="detail-card detail-section-card">
            <div class="section-header">
              <div>
                <p class="eyebrow">Company</p>
                <h2>Company and manufacturing details</h2>
              </div>
            </div>
            <div class="detail-fact-grid">
              {companyDetails.map((fact) => (
                <div class="detail-fact">
                  <strong>{fact.label}</strong>
                  <ul>
                    {fact.value.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </article>
        </section>
      ) : null}

      {view.incidents.length ? (
        <section class="section">
          <article class="detail-card detail-section-card">
            <div class="section-header">
              <div>
                <p class="eyebrow">Incidents</p>
                <h2>Incidents reported</h2>
              </div>
            </div>
            <div class="detail-fact-grid">
              <div class="detail-fact">
                <strong>Reports</strong>
                <ul>
                  {view.incidents.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
          </article>
        </section>
      ) : null}

      <section class="section official-source-section">
        <article class="detail-card official-source-card">
          <div>
            <p class="eyebrow">Official source</p>
            <h2>Verify with the official notice</h2>
            <p>{view.officialVerificationCopy}</p>
            <p class="official-recall-number">{view.officialSourceLabel}</p>
            <p>{view.officialTitle}</p>
            {view.recallNumber ? <p class="official-recall-number">Recall number: {view.recallNumber}</p> : null}
          </div>
          {view.officialSourceUrl ? (
            <a class="source-link source-link-small" href={view.officialSourceUrl} target="_blank" rel="noopener noreferrer">
              View official notice
            </a>
          ) : null}
        </article>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <p class="eyebrow">Brand history</p>
            <h2>Other indexed notices from this brand or company</h2>
          </div>
        </div>
        {view.companyRecallHistory.length ? (
          <div class="product-grid detail-related-grid">
            {view.companyRecallHistory.map((historyRecall) => {
              const image = getRecallImageForContext(historyRecall, 'related');

              return (
              <article class="product-card detail-related-card">
                <a class="image-shell" href={historyRecall.detailPath} aria-label={`View recall for ${historyRecall.title}`}>
                  {image.url ? (
                    <>
                      <img
                        src={image.url}
                        alt={image.alt}
                        loading="lazy"
                        decoding="async"
                        data-fallback-label={getRecallSourcePlaceholder(historyRecall.source)}
                      />
                      <span class="image-placeholder image-placeholder-fallback" hidden>
                        {getRecallSourcePlaceholder(historyRecall.source)}
                      </span>
                    </>
                  ) : (
                    <span class="image-placeholder">{getRecallSourcePlaceholder(historyRecall.source)}</span>
                  )}
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{recallSourceBadge(historyRecall)}</span>
                    <span class="badge-date">{historyRecall.recallDate}</span>
                  </div>
                  <h3><a href={historyRecall.detailPath}>{historyRecall.title}</a></h3>
                  <p>{historyRecall.hazard || historyRecall.reason || 'Hazard or reason not listed'}</p>
                  <a class="btn btn-primary" href={historyRecall.detailPath}>View recall</a>
                </div>
              </article>
              );
            })}
          </div>
        ) : (
          <div class="notice-panel">
            <p>No other indexed notices from this brand or company were found.</p>
          </div>
        )}
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <p class="eyebrow">Related recalls</p>
            <h2>Similar indexed notices</h2>
            <p class="section-note">Based on product type, hazard, or category.</p>
          </div>
        </div>
        {view.relatedRecalls.length ? (
          <div class="product-grid detail-related-grid">
            {view.relatedRecalls.map((relatedRecall) => {
              const image = getRecallImageForContext(relatedRecall, 'related');

              return (
              <article class="product-card detail-related-card">
                <a class="image-shell" href={relatedRecall.detailPath} aria-label={`View recall for ${relatedRecall.title}`}>
                  {image.url ? (
                    <>
                      <img
                        src={image.url}
                        alt={image.alt}
                        loading="lazy"
                        decoding="async"
                        data-fallback-label={getRecallSourcePlaceholder(relatedRecall.source)}
                      />
                      <span class="image-placeholder image-placeholder-fallback" hidden>
                        {getRecallSourcePlaceholder(relatedRecall.source)}
                      </span>
                    </>
                  ) : (
                    <span class="image-placeholder">{getRecallSourcePlaceholder(relatedRecall.source)}</span>
                  )}
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{recallSourceBadge(relatedRecall)}</span>
                    <span class="badge-date">{relatedRecall.recallDate}</span>
                  </div>
                  <h3><a href={relatedRecall.detailPath}>{relatedRecall.title}</a></h3>
                  <p>{relatedRecall.hazard || relatedRecall.reason || 'Hazard or reason not listed'}</p>
                  <a class="btn btn-primary" href={relatedRecall.detailPath}>View recall</a>
                </div>
              </article>
              );
            })}
          </div>
        ) : (
          <div class="notice-panel">
            <p>No similar indexed notices were found.</p>
            <a class="btn btn-secondary" href={categoryFallbackPath}>Browse {view.categoryLabel} recalls</a>
          </div>
        )}
      </section>

      <section class="section">
        <div class="link-row">
          <a class="btn btn-primary" href="/checker">Check another product</a>
          {recall.primaryBrandSlug ? (
            <a class="btn btn-secondary" href={`/brands/${recall.primaryBrandSlug}`}>
              View this brand page
            </a>
          ) : null}
        </div>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar helps you find possible recall notices. Search results are not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.
    </footer>
    <script>
      import { initImageFallbacks } from '../../lib/image-fallback';
      import { initProgressiveDetailImages } from '../../lib/progressive-detail-image';

      initProgressiveDetailImages();
      initImageFallbacks();
    </script>
  </body>
</html>
