---
import { categoryRoutes, siteRecalls } from '../../lib/recall-data';
import { getRecallIdentifierHints, getWhatToCheckItems } from '../../lib/recall-checklist';
import { getCompanyRecallHistory, getRelatedRecalls } from '../../lib/related-recalls';
import { NO_MATCH_DISCLAIMER } from '../../lib/recall-search';
import '../../styles/global.css';

export function getStaticPaths() {
  return siteRecalls.map((recall) => ({
    params: { slug: recall.slug },
    props: { recall }
  }));
}

const { recall } = Astro.props;
const cleanText = (value?: string | null) => (value ?? '').replace(/\s+/g, ' ').trim();
const shortenText = (value?: string | null, maxLength = 140) => {
  const text = cleanText(value);

  if (!text) {
    return 'Not listed';
  }

  if (text.length <= maxLength) {
    return text;
  }

  const clipped = text.slice(0, maxLength);
  const lastSpace = clipped.lastIndexOf(' ');
  const cutPoint = lastSpace > Math.floor(maxLength * 0.62) ? lastSpace : maxLength;

  return `${clipped.slice(0, cutPoint).trim()}...`;
};
const displayBrandNames = recall.displayBrandNames.length ? recall.displayBrandNames : [recall.primaryBrand];
const sourceBrandNames = recall.brandNames.filter(
  (rawName: string) => !displayBrandNames.some((displayName: string) => displayName.toLowerCase() === rawName.toLowerCase())
);
const galleryImages = recall.images.length ? recall.images : [];
const whatToCheckItems = getWhatToCheckItems(recall);
const identifierHints = getRecallIdentifierHints(recall);
const companyRecallHistory = getCompanyRecallHistory(recall, siteRecalls, 4);
const companyHistoryIds = new Set(companyRecallHistory.map((historyRecall) => historyRecall.id));
const relatedRecalls = getRelatedRecalls(recall, siteRecalls, 4, companyHistoryIds);
const categoryRoute = categoryRoutes.find((route) => route.category === recall.category);
const categoryFallbackPath = categoryRoute?.href ?? `/checker?category=${recall.category}`;
const sourceLinkText = recall.source === 'FDA' ? 'Official record: FDA/openFDA' : 'Official notice: CPSC';
const sourceLinkLabel = recall.source === 'FDA' ? 'Official record' : 'Official notice';
const simplifyTitlePart = (value?: string | null) =>
  cleanText(value)
    .replace(/\s+recalled\b.*$/i, '')
    .replace(/\s+recalls\b.*$/i, '')
    .replace(/\s+due to\b.*$/i, '')
    .replace(/\s+risk of\b.*$/i, '')
    .replace(/\s+because of\b.*$/i, '')
    .replace(/\s+recall(ed|s)?\b/gi, '')
    .trim();
const isUsefulName = (value: string) => Boolean(value && !/^(unknown|not listed|various|n\/a)$/i.test(value));
const titleProduct = simplifyTitlePart(recall.primaryProductName || recall.productNames[0] || recall.title);
const titleBrand = simplifyTitlePart(displayBrandNames[0]);
const titleBase =
  isUsefulName(titleBrand) && titleProduct && !titleProduct.toLowerCase().includes(titleBrand.toLowerCase())
    ? `${titleBrand} ${titleProduct}`
    : titleProduct || simplifyTitlePart(recall.title);
const visitorTitle = `${shortenText(titleBase || recall.title, 86)} recall`;
const productSummary = shortenText(recall.primaryProductName, 72);
const brandSummary = shortenText(displayBrandNames.join(', '), 88);
const shortHazard = shortenText(recall.hazard || recall.reason, 130);
const shortRemedy = shortenText(recall.remedy, 125);
const affectedUnitsSummary = shortenText(recall.affectedUnits || recall.productQuantity, 82);
const riskHazard = cleanText(recall.hazard || recall.reason) ? shortenText(recall.hazard || recall.reason, 52) : 'Recall notice';
const riskRemedy = cleanText(recall.remedy) ? shortenText(recall.remedy, 42) : '';
const riskLine = [
  riskHazard,
  riskRemedy,
  recall.recallDate ? `Recalled ${recall.recallDate}` : 'Recall date not listed'
].filter(Boolean).join(' - ');
const pageIntro = `This recall involves ${productSummary} from ${brandSummary}. Check the product photos and details below before using or keeping it.`;
const title = `${visitorTitle} | Recall Radar`;
const description = `${visitorTitle} with photos, product details, hazard, remedy, related recalls, and official notice link.`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/watchlist">Watchlist</a>
        <a href="/baby-product-recalls">Baby & Kids</a>
        <a href="/battery-recalls">Batteries & Electronics</a>
        <a href="/food-allergy-recalls">Food & Allergy</a>
      </nav>
    </header>

    <main class="page-shell detail-report-page">
      <section class="section detail-report-hero">
        <p class="eyebrow">Recall report</p>
        <div class="meta-row data-source-row">
          <span class="badge-source">{recall.sourceLabel}</span>
          <span class="badge-date">{recall.recallDate}</span>
          <span class="tag">{recall.categoryLabel}</span>
        </div>
        <h1 class="detail-title">{visitorTitle}</h1>
        <p class="detail-risk-line">{riskLine}</p>
        <p class="lead detail-intro">{pageIntro}</p>
      </section>

      <section class="section detail-grid detail-main-grid">
        <article class="detail-gallery-card" aria-label="Product images">
          <div class="detail-gallery">
            <div class="image-shell image-shell-large">
              {recall.primaryImageUrl ? (
                <img src={recall.primaryImageUrl} alt={recall.primaryImageAlt || recall.title} loading="lazy" />
              ) : (
                <span class="image-placeholder">{recall.source === 'FDA' ? 'FDA food notice' : 'Recall notice'}</span>
              )}
            </div>
            {galleryImages.length > 1 ? (
              <div class="thumbnail-grid detail-thumbnail-grid" aria-label="Additional product images">
                {galleryImages.slice(1, 7).map((image) => (
                  <div class="image-shell">
                    <img src={image.url} alt={image.alt || image.caption || recall.title} loading="lazy" />
                  </div>
                ))}
              </div>
            ) : null}
          </div>
        </article>

        <aside class="detail-card recall-summary-card compact-summary-card" aria-label="What you need to know">
          <h2>What you need to know</h2>
          <div class="facts compact-facts">
            <div class="fact">
              <strong>Why it was recalled</strong>
              <span class="summary-value-clamped">{shortHazard}</span>
            </div>
            <div class="fact">
              <strong>What to do</strong>
              <span class="summary-value-clamped">{shortRemedy}</span>
            </div>
            <div class="fact">
              <strong>Recalled on</strong>
              <span>{recall.recallDate}</span>
            </div>
            <div class="fact">
              <strong>Units affected</strong>
              <span>{affectedUnitsSummary}</span>
            </div>
            <div class="fact">
              <strong>Record ID</strong>
              <span>{recall.id}</span>
            </div>
            <div class="fact">
              <strong>{sourceLinkLabel}</strong>
              {recall.sourceUrl ? (
                <span>
                  <a class="source-link source-link-small" href={recall.sourceUrl} target="_blank" rel="noopener noreferrer">
                    {sourceLinkText}
                  </a>
                </span>
              ) : (
                <span>Not listed</span>
              )}
            </div>
          </div>
        </aside>
      </section>

      <section class="section detail-grid">
        <article class="detail-card">
          <h2>Is this your product?</h2>
          <p class="section-note product-compare-note">Compare these details with your product label, packaging, or purchase record.</p>
          <div class="facts">
            <div class="fact">
              <strong>Product name</strong>
              <span>{recall.productNames.length ? recall.productNames.join(', ') : recall.primaryProductName}</span>
            </div>
            <div class="fact">
              <strong>Brand/company</strong>
              <span>{displayBrandNames.join(', ')}</span>
            </div>
            {identifierHints.length ? (
              <div class="fact">
                <strong>Model, UPC, lot, or date-code hints</strong>
                <span>{identifierHints.join(', ')}</span>
              </div>
            ) : null}
            {recall.recallNumber ? (
              <div class="fact">
                <strong>Recall number</strong>
                <span>{recall.recallNumber}</span>
              </div>
            ) : null}
            {sourceBrandNames.length ? (
              <p class="also-listed-note">Also listed as: {sourceBrandNames.join(', ')}</p>
            ) : null}
          </div>
        </article>

        <article class="detail-card">
          <h2>What to check</h2>
          <ul class="check-list">
            {whatToCheckItems.map((item) => <li>{item}</li>)}
          </ul>
          <p class="disclaimer-copy">{NO_MATCH_DISCLAIMER}</p>
        </article>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <p class="eyebrow">Brand recall history</p>
            <h2>Other recalls from this brand or company</h2>
            <p class="section-note">Based on matching brand and company names.</p>
          </div>
        </div>
        {companyRecallHistory.length ? (
          <div class="product-grid detail-related-grid">
            {companyRecallHistory.map((historyRecall) => (
              <article class="product-card detail-related-card">
                <a class="image-shell" href={historyRecall.detailPath} aria-label={`View recall for ${historyRecall.title}`}>
                  {historyRecall.primaryImageUrl ? (
                    <img
                      src={historyRecall.primaryImageUrl}
                      alt={historyRecall.primaryImageAlt || historyRecall.title}
                      loading="lazy"
                    />
                  ) : (
                    <span class="image-placeholder">{historyRecall.source === 'FDA' ? 'FDA food notice' : 'Recall notice'}</span>
                  )}
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{historyRecall.sourceLabel}</span>
                    <span class="badge-date">{historyRecall.recallDate}</span>
                  </div>
                  <h3><a href={historyRecall.detailPath}>{historyRecall.title}</a></h3>
                  <p>{historyRecall.hazard || historyRecall.reason || 'Hazard/reason not listed in local data'}</p>
                  <a class="btn btn-primary" href={historyRecall.detailPath}>View recall</a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="notice-panel">
            <p>No other recalls from this brand or company were found in the current local dataset.</p>
          </div>
        )}
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <p class="eyebrow">Related recalls</p>
            <h2>Similar recalls you may want to check</h2>
            <p class="section-note">Based on product type, hazard, and category.</p>
          </div>
        </div>
        {relatedRecalls.length ? (
          <div class="product-grid detail-related-grid">
            {relatedRecalls.map((relatedRecall) => (
              <article class="product-card detail-related-card">
                <a class="image-shell" href={relatedRecall.detailPath} aria-label={`View recall for ${relatedRecall.title}`}>
                  {relatedRecall.primaryImageUrl ? (
                    <img
                      src={relatedRecall.primaryImageUrl}
                      alt={relatedRecall.primaryImageAlt || relatedRecall.title}
                      loading="lazy"
                    />
                  ) : (
                    <span class="image-placeholder">{relatedRecall.source === 'FDA' ? 'FDA food notice' : 'Recall notice'}</span>
                  )}
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{relatedRecall.sourceLabel}</span>
                    <span class="badge-date">{relatedRecall.recallDate}</span>
                  </div>
                  <h3><a href={relatedRecall.detailPath}>{relatedRecall.title}</a></h3>
                  <p>{relatedRecall.hazard || relatedRecall.reason || 'Hazard/reason not listed in local data'}</p>
                  <a class="btn btn-primary" href={relatedRecall.detailPath}>View recall</a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="notice-panel">
            <p>No closely related recalls were found in the current local dataset.</p>
            <a class="btn btn-secondary" href={categoryFallbackPath}>Browse {recall.categoryLabel} recalls</a>
          </div>
        )}
      </section>

      <section class="section">
        <div class="link-row">
          <a class="btn btn-primary" href="/checker">Check another product</a>
          {recall.primaryBrandSlug ? (
            <a class="btn btn-secondary" href={`/brands/${recall.primaryBrandSlug}`}>
              View this brand page
            </a>
          ) : null}
        </div>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar uses local CPSC and FDA/openFDA processed data when available and local mock fallback data otherwise. Always verify against official recall notices.
    </footer>
  </body>
</html>
