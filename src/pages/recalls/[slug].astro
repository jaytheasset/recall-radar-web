---
import { siteRecalls } from '../../lib/recall-data';
import '../../styles/global.css';

export function getStaticPaths() {
  return siteRecalls.map((recall) => ({
    params: { slug: recall.slug },
    props: { recall }
  }));
}

const { recall } = Astro.props;
const title = `${recall.title} | Recall Radar`;
const description = `${recall.title} local recall detail page with source, product, brand, hazard, remedy, affected units, and official notice link.`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/baby-product-recalls">Baby Product Recalls</a>
        <a href="/battery-recalls">Battery Recalls</a>
        <a href="/food-allergy-recalls">Food Allergy Recalls</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow">Recall detail</p>
        <div class="meta-row data-source-row">
          <span class="status-pill">{recall.sourceLabel}</span>
          <span class="tag">{recall.categoryLabel}</span>
        </div>
        <h1>{recall.title}</h1>
        <p class="lead">{recall.description}</p>
      </section>

      <section class="section detail-grid">
        <aside class="facts" aria-label="Recall facts">
          <div class="fact">
            <strong>Brand</strong>
            {recall.primaryBrandSlug ? (
              <a href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand}</a>
            ) : (
              <span>{recall.primaryBrand}</span>
            )}
          </div>
          <div class="fact">
            <strong>Category</strong>
            <span>{recall.categoryLabel}</span>
          </div>
          <div class="fact">
            <strong>Recall Date</strong>
            <span>{recall.recallDate}</span>
          </div>
          <div class="fact">
            <strong>Source</strong>
            <span>{recall.sourceLabel}</span>
          </div>
          <div class="fact">
            <strong>Record ID</strong>
            <span>{recall.id}</span>
          </div>
          <div class="fact">
            <strong>Official Notice</strong>
            {recall.sourceUrl ? <a href={recall.sourceUrl}>View source notice</a> : <span>Not listed</span>}
          </div>
        </aside>

        <article class="notice-panel">
          <h2>Product Details</h2>
          <div class="facts">
            <div class="fact">
              <strong>Products</strong>
              <span>{recall.productNames.length ? recall.productNames.join(', ') : recall.primaryProductName}</span>
            </div>
            <div class="fact">
              <strong>Affected Units</strong>
              <span>{recall.affectedUnits || 'Not listed in local data'}</span>
            </div>
            <div class="fact">
              <strong>Hazard</strong>
              <span>{recall.hazard || 'Not listed in local data'}</span>
            </div>
            <div class="fact">
              <strong>Remedy</strong>
              <span>{recall.remedy || 'Not listed in local data'}</span>
            </div>
          </div>
        </article>
      </section>

      <section class="section">
        <div class="link-row">
          <a class="button-link" href="/checker">Check another product</a>
          {recall.primaryBrandSlug ? (
            <a class="button-link button-secondary" href={`/brands/${recall.primaryBrandSlug}`}>
              Brand recall page
            </a>
          ) : null}
        </div>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar uses local CPSC processed data when available and local mock fallback data otherwise. Always verify against official recall notices.
    </footer>
  </body>
</html>
