---
import EuImageResourceHints from '../../components/EuImageResourceHints.astro';
import TaxonomyFamilyPage from '../../components/TaxonomyFamilyPage.astro';
import { categoryRoutes, siteRecalls } from '../../lib/recall-data';
import { buildRecallDetailView, recallSourceBadge, type DetailFact } from '../../lib/recall-detail-view';
import {
  getDetailHeroImagePreloadAttributes,
  getDetailHeroImageSources,
  getDisplayImageCaption,
  getRecallImageForContext
} from '../../lib/recall-images';
import { getRecallSourcePlaceholder } from '../../lib/recall-sources';
import {
  getTaxonomyV2CategoryPages,
  getTaxonomyV2CategoryRouteBySlug,
  recallMatchesTaxonomyCategory
} from '../../lib/taxonomy-v2-pages';
import '../../styles/global.css';

export function getStaticPaths() {
  return [
    ...siteRecalls.map((recall) => ({
      params: { slug: recall.slug },
      props: { pageKind: 'detail', recall }
    })),
    ...getTaxonomyV2CategoryPages(siteRecalls).map((taxonomyPage) => ({
      params: { slug: taxonomyPage.slug },
      props: { pageKind: 'taxonomy-family', taxonomyPage }
    }))
  ];
}

const taxonomyPage = Astro.props.pageKind === 'taxonomy-family' ? Astro.props.taxonomyPage : undefined;
const taxonomyRoute = taxonomyPage ? getTaxonomyV2CategoryRouteBySlug(taxonomyPage.slug) : undefined;
const taxonomyPageRecalls =
  taxonomyPage && taxonomyRoute
    ? siteRecalls.filter((siteRecall) => recallMatchesTaxonomyCategory(siteRecall, taxonomyRoute.category))
    : [];
const recall = (Astro.props.pageKind === 'detail' ? Astro.props.recall : siteRecalls[0])!;
const view = buildRecallDetailView(recall, siteRecalls);
const categoryRoute = categoryRoutes.find(
  (route) => route.category === recall.taxonomyProductFamily || route.category === recall.category
);
const categoryFallbackPath = categoryRoute?.href ?? `/checker?category=${recall.taxonomyProductFamily ?? recall.category}`;
const companyDetails = [
  { label: 'Importer', value: view.importer },
  { label: 'Manufacturer', value: view.manufacturer },
  { label: 'Manufactured in', value: view.manufacturedIn }
].filter((fact) => fact.value.length > 0);
function hasFactValue(value: string | string[] | undefined): value is string | string[] {
  return Array.isArray(value) ? value.length > 0 : Boolean(value?.trim());
}
function pageFact(label: string, value: string | string[] | undefined): DetailFact | undefined {
  return hasFactValue(value) ? { label, value } : undefined;
}
function uniqueText(values: string[]): string[] {
  return [...new Set(values.map((value) => value.replace(/\s+/g, ' ').trim()).filter(Boolean))];
}
function isUsefulDisplayValue(value: string | undefined): value is string {
  const text = value?.trim() ?? '';
  return Boolean(text) && !/^unknown\b/i.test(text) && !/^need review\b/i.test(text);
}
function simplifyActionText(value: string): string {
  return value
    .replace(/\s+(?:via|by)\s+email\s+[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b/gi, '')
    .replace(/\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b/gi, '')
    .replace(/\b(?:call|phone|tel)\s*:?\s*[+()0-9][0-9 ()+-]{6,}[0-9]\b/gi, '')
    .replace(/\b(?:email|visit|web)\s*:?\s*/gi, '')
    .replace(/\s+/g, ' ')
    .trim();
}
function isContactOnlyAction(value: string): boolean {
  const text = value.replace(/\s+/g, ' ').trim();
  return /^Contact\s+[^.]+\.?$/i.test(text) || /^(?:Call|Email|Visit|Web)\b/i.test(text);
}
function actionDisplayItems(values: string[]): string[] {
  return uniqueText(values.map(simplifyActionText)).filter((value) => value && !isContactOnlyAction(value));
}
function actionContactItems(values: string[]): string[] {
  const text = values.join(' ');
  const emails = [...text.matchAll(/\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b/gi)].map((match) => `Email: ${match[0]}`);
  const phones = [...text.matchAll(/\b(?:call|phone|tel)\s*:?\s*([+()0-9][0-9 ()+-]{6,}[0-9])\b/gi)].map(
    (match) => `Phone: ${match[1].trim()}`
  );
  const links = [...text.matchAll(/\b(?:https?:\/\/[^\s)]+|www\.[^\s)]+)/gi)].map((match) => `Website: ${match[0]}`);
  return uniqueText([...emails, ...phones, ...links]);
}
const displayProductTypeLabel = isUsefulDisplayValue(view.taxonomyProductTypeLabel) ? view.taxonomyProductTypeLabel : '';
const displayAudienceLabels = view.taxonomyAudienceLabels.filter(isUsefulDisplayValue);
const displayActionItems = actionDisplayItems(view.actionParagraphs.length ? view.actionParagraphs : [view.action]);
const displayContactItems = actionContactItems([view.action, view.consumerContact]);
const productIdentityFacts = [
  pageFact('Product', view.productName),
  pageFact('Brand / company', view.brandName),
  pageFact(view.quantityLabel, view.units),
  pageFact('Record ID', view.recallNumber || recall.id)
].filter((fact): fact is DetailFact => Boolean(fact));
const categoryFacts = [
  pageFact('Product family', view.taxonomyProductFamilyLabel),
  pageFact('Product type', displayProductTypeLabel),
  pageFact('Issue / hazard type', view.taxonomyHazardTypeLabel),
  pageFact('Recall domain', view.taxonomyRecallDomainLabel),
  pageFact('Audience', displayAudienceLabels)
].filter((fact): fact is DetailFact => Boolean(fact));
const officialSourceFacts = [
  pageFact('Source', view.sourceBadge),
  pageFact('Recall date', view.recallDate),
  pageFact('Product name', view.productName),
  pageFact('Brand / company', view.brandName),
  pageFact('Hazard / issue', view.reason),
  pageFact('Remedy / action', view.action),
  pageFact(view.quantityLabel, view.units),
  pageFact('Recall number / record ID', view.recallNumber || recall.id),
  ...view.fdaDetails.filter((fact) => ['Classification', 'Status'].includes(fact.label))
].filter((fact): fact is DetailFact => Boolean(fact));
const title = taxonomyPage ? `${taxonomyPage.label} Recalls | Recall Radar` : `${view.displayTitle} | Recall Radar`;
const description = taxonomyPage
  ? `Browse indexed ${taxonomyPage.label} recall notices by product family, issue tag, brand, model, barcode, lot, or keyword.`
  : `${view.displayTitle} with product photos, affected item details, reason for recall, consumer action, and official source link.`;
const fallbackImageLabel = getRecallSourcePlaceholder(recall.source);
const hasSparseIdentificationDetails = view.identificationDetails.length < 4;
const detailHeroImage = view.productImages[0];
const detailHeroSources = getDetailHeroImageSources(recall, detailHeroImage);
const detailGalleryImages = view.productImages.slice(0, 7).map((image, index) => {
  const sources = getDetailHeroImageSources(recall, image);
  const caption = getDisplayImageCaption(image.caption);
  const alt = image.alt || caption || view.primaryImageAlt;

  return {
    image,
    index,
    sources,
    caption,
    alt,
    initialSrc: sources.initialSrc || image.url,
    fullSrc: sources.fullSrc || image.url,
    thumbnailSrc: sources.thumbnailSrc || sources.initialSrc || image.url
  };
});
const detailHeroImageAttrs = {
  loading: detailHeroSources.loading,
  decoding: detailHeroSources.decoding,
  ...(detailHeroSources.fetchpriority ? { fetchpriority: detailHeroSources.fetchpriority } : {})
};
const detailHeroPreloadAttrs = getDetailHeroImagePreloadAttributes(recall, detailHeroImage);
const detailHeroCaption = getDisplayImageCaption(detailHeroImage?.caption);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <EuImageResourceHints />
    {!taxonomyPage && detailHeroPreloadAttrs ? <link rel="preload" as="image" {...detailHeroPreloadAttrs} /> : null}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/#browse-recalls">Browse Recalls</a>
        <a href="/#official-sources">Sources</a>
        <a href="/watchlist">Watchlist</a>
      </nav>
    </header>

    {taxonomyPage ? (
      <TaxonomyFamilyPage page={taxonomyPage} recalls={taxonomyPageRecalls} />
    ) : (
    <main class="page-shell detail-report-page">
      <section class="section detail-report-hero">
        <p class="eyebrow">Recall report</p>
        <div class="meta-row data-source-row">
          <span class="badge-source">{view.sourceBadge}</span>
          <span class="badge-date">{view.recallDate}</span>
          <span class="tag">{view.taxonomyProductFamilyLabel}</span>
          {view.taxonomyHazardTypeLabel ? <span class="tag">{view.taxonomyHazardTypeLabel}</span> : null}
        </div>
        <h1 class="detail-title">{view.displayTitle}</h1>
        <p class="lead detail-intro">{view.introSentence}</p>
      </section>

      <section class="section detail-grid detail-main-grid">
        <article class="detail-gallery-card" aria-label="Product images" data-detail-gallery-image-count={view.productImages.length}>
          <div class="detail-gallery">
            <figure class="detail-image-figure">
              <div class="image-shell image-shell-large">
                {detailHeroImage ? (
                  <>
                    <img
                      class:list={[detailHeroSources.isProgressive && 'progressive-detail-hero-image']}
                      src={detailHeroSources.initialSrc || detailHeroImage.url}
                      alt={detailHeroImage.alt || view.primaryImageAlt}
                      data-detail-gallery-main
                      data-full-src={detailHeroSources.fullSrc}
                      data-thumbnail-src={detailHeroSources.thumbnailSrc}
                      data-progressive-mode={detailHeroSources.isProgressive ? 'detail' : 'static'}
                      {...detailHeroImageAttrs}
                      data-fallback-label={fallbackImageLabel}
                    />
                    <span class="image-placeholder image-placeholder-fallback" hidden>{fallbackImageLabel}</span>
                  </>
                ) : (
                  <span class="image-placeholder">{fallbackImageLabel}</span>
                )}
              </div>
              <figcaption data-detail-gallery-caption hidden={!detailHeroCaption}>{detailHeroCaption}</figcaption>
            </figure>
            {view.productImages.length > 1 ? (
              <div class="thumbnail-grid detail-thumbnail-grid" aria-label="Additional product images">
                {detailGalleryImages.map((galleryImage) => (
                    <figure class="detail-thumbnail">
                      <button
                        class:list={['detail-thumbnail-button', galleryImage.index === 0 && 'is-selected']}
                        type="button"
                        aria-label={`View image ${galleryImage.index + 1} for ${view.displayTitle}`}
                        aria-pressed={galleryImage.index === 0 ? 'true' : 'false'}
                        aria-current={galleryImage.index === 0 ? 'true' : undefined}
                        data-gallery-thumbnail
                        data-gallery-index={galleryImage.index}
                        data-initial-src={galleryImage.initialSrc}
                        data-full-src={galleryImage.fullSrc}
                        data-thumbnail-src={galleryImage.thumbnailSrc}
                        data-alt={galleryImage.alt}
                        data-caption={galleryImage.caption}
                      >
                        <span class="image-shell">
                        <img
                          src={galleryImage.thumbnailSrc}
                          alt={galleryImage.alt}
                          loading="lazy"
                          decoding="async"
                          data-fallback-label={fallbackImageLabel}
                        />
                        <span class="image-placeholder image-placeholder-fallback" hidden>{fallbackImageLabel}</span>
                        </span>
                      </button>
                      {galleryImage.caption ? <figcaption>{galleryImage.caption}</figcaption> : null}
                    </figure>
                  ))}
              </div>
            ) : null}
          </div>
        </article>

        <aside class="detail-card recall-summary-card compact-summary-card v2-report-card" aria-label="Recall report summary">
          <p class="eyebrow">Recall report</p>
          <h2>{view.productName}</h2>
          <p class="summary-brand">{view.brandName || 'Brand or company not listed'}</p>
          <div class="v2-summary-stack">
            <div>
              <strong>Product family</strong>
              <span>{view.taxonomyProductFamilyLabel}</span>
            </div>
            {displayProductTypeLabel ? (
              <div>
                <strong>Product type</strong>
                <span>{displayProductTypeLabel}</span>
              </div>
            ) : null}
            {view.taxonomyHazardTypeLabel ? (
              <div>
                <strong>Issue</strong>
                <span>{view.taxonomyHazardTypeLabel}</span>
              </div>
            ) : null}
            <div>
              <strong>Recall date</strong>
              <span>{view.recallDate}</span>
            </div>
            <div>
              <strong>Source</strong>
              <span>{view.sourceBadge}</span>
            </div>
          </div>
          <div class="summary-alert">
            <strong>Risk / issue</strong>
            <p>{view.reason}</p>
          </div>
          {displayActionItems.length ? (
            <div class="summary-action">
              <strong>What to do</strong>
              <p>{displayActionItems[0]}</p>
            </div>
          ) : null}
          <div class="link-row">
            <a class="btn btn-primary" href="#what-to-check">What to check</a>
            {view.officialSourceUrl ? (
              <a class="btn btn-secondary" href={view.officialSourceUrl} target="_blank" rel="noopener noreferrer">
                Official notice
              </a>
            ) : null}
          </div>
        </aside>
      </section>

      <section class="section detail-priority-section" aria-label="Recall key details">
        <article class="detail-card detail-section-card detail-priority-card">
          <div class="section-header">
            <div>
              <p class="eyebrow">Key details</p>
              <h2>What to know first</h2>
            </div>
          </div>
          <div class="detail-priority-grid">
            <section class="detail-priority-panel detail-priority-risk" aria-labelledby="priority-risk">
              <h3 id="priority-risk">Risk / issue</h3>
              <p>{view.reason}</p>
            </section>
            {displayActionItems.length ? (
              <section class="detail-priority-panel detail-priority-action" aria-labelledby="priority-action">
                <h3 id="priority-action">What to do</h3>
                <ul class="detail-action-list compact">
                  {displayActionItems.slice(0, 3).map((item) => <li>{item}</li>)}
                </ul>
              </section>
            ) : null}
            <section class="detail-priority-panel" aria-labelledby="priority-product">
              <h3 id="priority-product">Product to compare</h3>
              <div class="detail-fact-grid compact-fact-grid">
                {productIdentityFacts.map((fact) => (
                  <div class="detail-fact">
                    <strong>{fact.label}</strong>
                    {Array.isArray(fact.value) ? (
                      <ul>
                        {fact.value.map((item) => <li>{item}</li>)}
                      </ul>
                    ) : (
                      <span>{fact.value}</span>
                    )}
                  </div>
                ))}
              </div>
            </section>
            {categoryFacts.length ? (
              <section class="detail-priority-panel" aria-labelledby="priority-category">
                <h3 id="priority-category">Product category</h3>
                <div class="detail-fact-grid compact-fact-grid">
                  {categoryFacts.map((fact) => (
                    <div class="detail-fact">
                      <strong>{fact.label}</strong>
                      {Array.isArray(fact.value) ? (
                        <ul>
                          {fact.value.map((item) => <li>{item}</li>)}
                        </ul>
                      ) : (
                        <span>{fact.value}</span>
                      )}
                    </div>
                  ))}
                </div>
              </section>
            ) : null}
          </div>
        </article>
      </section>

      <section class="section">
        <article id="what-to-check" class="detail-card detail-section-card identification-guide-card">
          <div class="section-header">
            <div>
              <p class="eyebrow">What to check</p>
              <h2>Affected identifiers and product details</h2>
              <p class="section-note">{view.verificationIntro}</p>
            </div>
          </div>
          <div class="verification-layout">
            <section class="verification-panel" aria-labelledby="what-to-compare">
              <h3 id="what-to-compare">What to compare</h3>
              <ul class="verification-checklist">
                {view.verificationChecklist.map((item) => <li>{item}</li>)}
              </ul>
              <p class="verification-note">{view.identifierVerificationHint}</p>
              <p class="verification-note">{view.detailSafetyCopy}</p>
              {hasSparseIdentificationDetails ? <p class="verification-note">{view.sparseIdentificationCopy}</p> : null}
            </section>
            <section class="verification-panel" aria-labelledby="details-found">
              <h3 id="details-found">Identifiers found in this notice</h3>
              {view.identificationDetails.length ? (
                <div class="detail-fact-grid">
                  {view.identificationDetails.map((fact) => (
                    <div class="detail-fact">
                      <strong>{fact.label}</strong>
                      {Array.isArray(fact.value) ? (
                        <ul>
                          {fact.value.map((item) => <li>{item}</li>)}
                        </ul>
                      ) : (
                        <span>{fact.value}</span>
                      )}
                    </div>
                  ))}
                </div>
              ) : (
                <p class="verification-note">{view.sparseIdentificationCopy}</p>
              )}
            </section>
          </div>
        </article>
      </section>

      {displayActionItems.length ? (
        <section class="section">
          <article class="detail-card detail-section-card">
            <div class="section-header">
              <div>
                <p class="eyebrow">Remedy / What to Do</p>
                <h2>Recommended consumer action</h2>
              </div>
            </div>
            <ul class="detail-action-list">
              {displayActionItems.map((paragraph) => <li>{paragraph}</li>)}
            </ul>
            {displayContactItems.length || view.consumerContact ? (
              <div class="detail-fact-grid detail-action-facts">
                <div class="detail-fact">
                  <strong>Consumer contact</strong>
                  <ul>
                    {uniqueText([...displayContactItems, view.consumerContact]).map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              </div>
            ) : null}
          </article>
        </section>
      ) : null}

      {view.soldAt.length ? (
        <section class="section">
          <article class="detail-card detail-section-card">
            <div class="section-header">
              <div>
                <p class="eyebrow">Purchase details</p>
                <h2>Where it was sold</h2>
              </div>
            </div>
            <div class="detail-fact-grid">
              <div class="detail-fact">
                <strong>{view.distributionLabel}</strong>
                <ul>
                  {view.soldAt.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
          </article>
        </section>
      ) : null}

      {companyDetails.length ? (
        <section class="section">
          <article class="detail-card detail-section-card">
            <div class="section-header">
              <div>
                <p class="eyebrow">Company</p>
                <h2>Company and manufacturing details</h2>
              </div>
            </div>
            <div class="detail-fact-grid">
              {companyDetails.map((fact) => (
                <div class="detail-fact">
                  <strong>{fact.label}</strong>
                  <ul>
                    {fact.value.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </article>
        </section>
      ) : null}

      {view.incidents.length ? (
        <section class="section">
          <article class="detail-card detail-section-card">
            <div class="section-header">
              <div>
                <p class="eyebrow">Incidents</p>
                <h2>Incidents reported</h2>
              </div>
            </div>
            <div class="detail-fact-grid">
              <div class="detail-fact">
                <strong>Reports</strong>
                <ul>
                  {view.incidents.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
          </article>
        </section>
      ) : null}

      <section class="section official-source-section">
        <article class="detail-card official-source-card">
          <div class="official-source-card-header">
            <div>
              <p class="eyebrow">Official source</p>
              <h2>Verify against the source notice</h2>
              <p>{view.officialVerificationCopy}</p>
              <p class="official-recall-number">{view.officialSourceLabel}</p>
              <p>{view.officialTitle}</p>
              {view.recallNumber ? <p class="official-recall-number">Recall number: {view.recallNumber}</p> : null}
            </div>
            {view.officialSourceUrl ? (
              <a class="source-link source-link-small" href={view.officialSourceUrl} target="_blank" rel="noopener noreferrer">
                View official notice
              </a>
            ) : null}
          </div>
          <details class="source-fields-accordion">
            <summary>Official source fields</summary>
            <div class="detail-fact-grid">
              {officialSourceFacts.map((fact) => (
                <div class="detail-fact">
                  <strong>{fact.label}</strong>
                  {Array.isArray(fact.value) ? (
                    <ul>
                      {fact.value.map((item) => <li>{item}</li>)}
                    </ul>
                  ) : (
                    <span>{fact.value}</span>
                  )}
                </div>
              ))}
            </div>
          </details>
        </article>
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <p class="eyebrow">Brand history</p>
            <h2>Other indexed notices from this brand or company</h2>
          </div>
        </div>
        {view.companyRecallHistory.length ? (
          <div class="product-grid detail-related-grid">
            {view.companyRecallHistory.map((historyRecall) => {
              const image = getRecallImageForContext(historyRecall, 'related');

              return (
              <article class="product-card detail-related-card">
                <a class="image-shell" href={historyRecall.detailPath} aria-label={`View recall for ${historyRecall.title}`}>
                  {image.url ? (
                    <>
                      <img
                        src={image.url}
                        alt={image.alt}
                        loading="lazy"
                        decoding="async"
                        data-fallback-label={getRecallSourcePlaceholder(historyRecall.source)}
                      />
                      <span class="image-placeholder image-placeholder-fallback" hidden>
                        {getRecallSourcePlaceholder(historyRecall.source)}
                      </span>
                    </>
                  ) : (
                    <span class="image-placeholder">{getRecallSourcePlaceholder(historyRecall.source)}</span>
                  )}
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{recallSourceBadge(historyRecall)}</span>
                    <span class="badge-date">{historyRecall.recallDate}</span>
                  </div>
                  <h3><a href={historyRecall.detailPath}>{historyRecall.title}</a></h3>
                  <p>{historyRecall.hazard || historyRecall.reason || 'Hazard or reason not listed'}</p>
                  <a class="btn btn-primary" href={historyRecall.detailPath}>View recall</a>
                </div>
              </article>
              );
            })}
          </div>
        ) : (
          <div class="notice-panel">
            <p>No other indexed notices from this brand or company were found.</p>
          </div>
        )}
      </section>

      <section class="section">
        <div class="section-header">
          <div>
            <p class="eyebrow">Related recalls</p>
            <h2>Similar indexed notices</h2>
            <p class="section-note">Based on product family, product type, and issue tags.</p>
          </div>
        </div>
        {view.relatedRecalls.length ? (
          <div class="product-grid detail-related-grid">
            {view.relatedRecalls.map((relatedRecall) => {
              const image = getRecallImageForContext(relatedRecall, 'related');

              return (
              <article class="product-card detail-related-card">
                <a class="image-shell" href={relatedRecall.detailPath} aria-label={`View recall for ${relatedRecall.title}`}>
                  {image.url ? (
                    <>
                      <img
                        src={image.url}
                        alt={image.alt}
                        loading="lazy"
                        decoding="async"
                        data-fallback-label={getRecallSourcePlaceholder(relatedRecall.source)}
                      />
                      <span class="image-placeholder image-placeholder-fallback" hidden>
                        {getRecallSourcePlaceholder(relatedRecall.source)}
                      </span>
                    </>
                  ) : (
                    <span class="image-placeholder">{getRecallSourcePlaceholder(relatedRecall.source)}</span>
                  )}
                </a>
                <div class="card-body">
                  <div class="meta-row">
                    <span class="badge-source">{recallSourceBadge(relatedRecall)}</span>
                    <span class="badge-date">{relatedRecall.recallDate}</span>
                  </div>
                  <h3><a href={relatedRecall.detailPath}>{relatedRecall.title}</a></h3>
                  <p>{relatedRecall.hazard || relatedRecall.reason || 'Hazard or reason not listed'}</p>
                  <a class="btn btn-primary" href={relatedRecall.detailPath}>View recall</a>
                </div>
              </article>
              );
            })}
          </div>
        ) : (
          <div class="notice-panel">
            <p>No similar indexed notices were found.</p>
            <a class="btn btn-secondary" href={categoryFallbackPath}>Browse {view.taxonomyProductFamilyLabel} recalls</a>
          </div>
        )}
      </section>

      <section class="section">
        <div class="link-row">
          <a class="btn btn-primary" href="/checker">Check another product</a>
          {recall.primaryBrandSlug ? (
            <a class="btn btn-secondary" href={`/brands/${recall.primaryBrandSlug}`}>
              View this brand page
            </a>
          ) : null}
        </div>
      </section>
    </main>
    )}

    <footer class="page-footer">
      Recall Radar helps you find possible recall notices. Search results are not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.
    </footer>
    <script>
      import { initImageFallbacks } from '../../lib/image-fallback';
      import { initDetailImageGallery, initProgressiveCardImages, initProgressiveDetailImages } from '../../lib/progressive-detail-image';

      initProgressiveDetailImages();
      initDetailImageGallery();
      initProgressiveCardImages();
      initImageFallbacks();
    </script>
  </body>
</html>
