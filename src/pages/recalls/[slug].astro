---
import { siteRecalls } from '../../lib/recall-data';
import { NO_MATCH_DISCLAIMER } from '../../lib/recall-search';
import '../../styles/global.css';

export function getStaticPaths() {
  return siteRecalls.map((recall) => ({
    params: { slug: recall.slug },
    props: { recall }
  }));
}

const { recall } = Astro.props;
const title = `${recall.title} | Recall Radar`;
const description = `${recall.title} local recall detail page with source, product, brand, hazard, remedy, affected units, and official notice link.`;
const sourceLinkLabel = recall.source === 'FDA' ? 'Official FDA/openFDA Reference' : 'Official CPSC Notice';
const sourceLinkText = recall.source === 'FDA' ? 'Open official FDA/openFDA reference' : 'Open official CPSC notice';
const displayBrandNames = recall.displayBrandNames.length ? recall.displayBrandNames : [recall.primaryBrand];
const sourceBrandNames = recall.brandNames.filter(
  (rawName: string) => !displayBrandNames.some((displayName: string) => displayName.toLowerCase() === rawName.toLowerCase())
);
const whatToCheckItems = [
  'Compare the product name, model, and brand or company names against the official notice.',
  'Review the hazard and remedy fields before using, selling, donating, or repairing the product.',
  'Use the official agency notice and manufacturer or recalling firm instructions for the most authoritative next steps.'
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/baby-product-recalls">Baby Product Recalls</a>
        <a href="/battery-recalls">Battery & Electronics Recalls</a>
        <a href="/food-allergy-recalls">Food Allergy Recalls</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="section">
        <p class="eyebrow">Recall detail</p>
        <div class="meta-row data-source-row">
          <span class="status-pill">{recall.sourceLabel}</span>
          <span class="tag">{recall.categoryLabel}</span>
        </div>
        <h1>{recall.title}</h1>
        <p class="lead">{recall.description}</p>
      </section>

      <section class="section detail-grid">
        <aside class="facts" aria-label="Recall facts">
          <div class="fact">
            <strong>Primary Brand / Company</strong>
            {recall.primaryBrandSlug ? (
              <a href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand}</a>
            ) : (
              <span>{recall.primaryBrand}</span>
            )}
          </div>
          <div class="fact">
            <strong>Category</strong>
            <span>{recall.categoryLabel}</span>
          </div>
          <div class="fact">
            <strong>Recall Date</strong>
            <span>{recall.recallDate}</span>
          </div>
          <div class="fact">
            <strong>Source</strong>
            <span>{recall.sourceLabel}</span>
          </div>
          <div class="fact">
            <strong>Record ID</strong>
            <span>{recall.id}</span>
          </div>
          <div class="fact">
            <strong>{sourceLinkLabel}</strong>
            {recall.sourceUrl ? <a href={recall.sourceUrl}>{sourceLinkText}</a> : <span>Not listed</span>}
          </div>
        </aside>

        <article class="notice-panel">
          <h2>Recall Details</h2>
          <div class="facts">
            <div class="fact">
              <strong>Affected Products</strong>
              <span>{recall.productNames.length ? recall.productNames.join(', ') : recall.primaryProductName}</span>
            </div>
            <div class="fact">
              <strong>Brands / Companies</strong>
              <span>{displayBrandNames.join(', ')}</span>
            </div>
            {sourceBrandNames.length ? (
              <div class="fact">
                <strong>Source Brand Names</strong>
                <span>{sourceBrandNames.join(', ')}</span>
              </div>
            ) : null}
            <div class="fact">
              <strong>Hazard</strong>
              <span>{recall.hazard || 'Not listed in local data'}</span>
            </div>
            <div class="fact">
              <strong>Remedy</strong>
              <span>{recall.remedy || 'Not listed in local data'}</span>
            </div>
            <div class="fact">
              <strong>Affected Units</strong>
              <span>{recall.affectedUnits || 'Not listed in local data'}</span>
            </div>
            {recall.classification ? (
              <div class="fact">
                <strong>Classification</strong>
                <span>{recall.classification}</span>
              </div>
            ) : null}
            {recall.status ? (
              <div class="fact">
                <strong>Status</strong>
                <span>{recall.status}</span>
              </div>
            ) : null}
            {recall.recallNumber ? (
              <div class="fact">
                <strong>Recall Number</strong>
                <span>{recall.recallNumber}</span>
              </div>
            ) : null}
            {recall.distributionPattern ? (
              <div class="fact">
                <strong>Distribution</strong>
                <span>{recall.distributionPattern}</span>
              </div>
            ) : null}
          </div>
        </article>
      </section>

      <section class="section">
        <article class="notice-panel">
          <h2>What to check</h2>
          <ul class="check-list">
            {whatToCheckItems.map((item) => <li>{item}</li>)}
          </ul>
          <p class="disclaimer-copy">{NO_MATCH_DISCLAIMER}</p>
        </article>
      </section>

      <section class="section">
        <div class="link-row">
          <a class="button-link" href="/checker">Check another product</a>
          {recall.primaryBrandSlug ? (
            <a class="button-link button-secondary" href={`/brands/${recall.primaryBrandSlug}`}>
              Brand recall page
            </a>
          ) : null}
        </div>
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar uses local CPSC and FDA/openFDA processed data when available and local mock fallback data otherwise. Always verify against official recall notices.
    </footer>
  </body>
</html>
