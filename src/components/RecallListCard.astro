---
import UiIcon from './UiIcon.astro';
import type { SiteRecall } from '../lib/recall-data';
import { getMessage } from '../lib/i18n';
import { cleanRecallDisplayText, formatRecallAction, getPhotoSubmissionNoticeUrl } from '../lib/recall-display-text';
import { getRecallImageForContext, type RecallImageContext } from '../lib/recall-images';
import { getOfficialAllergenTerms } from '../lib/multilingual-search';
import {
  getRecallActionLabel,
  getRecallDefaultActionFallback,
  getRecallReasonLabel,
  getRecallSourcePlaceholder
} from '../lib/recall-sources';
import {
  TAXONOMY_REVIEW_LABEL,
  TAXONOMY_REVIEW_NOTICE,
  needsTaxonomyReview
} from '../lib/taxonomy-review';

type Props = {
  recall: SiteRecall;
  searchText?: string;
  cardCategory?: string;
  cardSource?: string;
  sourceCard?: boolean;
  imageContext?: RecallImageContext;
  class?: string;
};

const {
  recall,
  searchText,
  cardCategory,
  cardSource,
  sourceCard = false,
  imageContext = 'list'
} = Astro.props;
const className = Astro.props.class;
const image = getRecallImageForContext(recall, imageContext);
const fallbackLabel = getRecallSourcePlaceholder(recall.source);
const productText = recall.productNames.length
  ? recall.productNames.slice(0, 3).join(', ')
  : recall.primaryProductName;
const shortTitle = recall.productNames.length ? productText : recall.title;
const brandText = recall.displayBrandNames.length
  ? recall.displayBrandNames.slice(0, 3).join(', ')
  : recall.primaryBrand;
const reasonText = cleanRecallDisplayText(recall.hazard || recall.reason || 'Not listed in the recall notice.');
const action = formatRecallAction(recall.remedy || getRecallDefaultActionFallback(recall.source));
const photoSubmissionNoticeUrl = getPhotoSubmissionNoticeUrl(recall.source, recall.sourceUrl, action.hasPhotoSubmission);
const reviewNeeded = needsTaxonomyReview(recall);
const allergens = searchText ? getOfficialAllergenTerms(recall) : [];
---

<article
  class:list={['product-card', 'result-card', 'recall-list-card', { 'recall-list-card-no-image': !image.url }, className]}
  data-category-card
  data-source-card={sourceCard ? true : undefined}
  data-card-category={cardCategory}
  data-card-source={cardSource}
  data-search-text={searchText}
  data-official-allergens={allergens.length ? allergens.join('|') : undefined}
>
  <a class="image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
    {image.url ? (
      <>
        <img
          src={image.url}
          alt={image.alt}
          loading="lazy"
          decoding="async"
          data-fallback-label={fallbackLabel}
        />
        <span class="image-placeholder image-placeholder-fallback" hidden>{fallbackLabel}</span>
      </>
    ) : (
      <span class="image-placeholder">{fallbackLabel}</span>
    )}
  </a>
  <div class="card-body">
    <div class="recall-list-card-heading">
      <div class="meta-row result-card-badges result-card-topline">
        <span class="badge-source">{recall.sourceLabel}</span>
        <span class="badge-date">{recall.recallDate}</span>
        {reviewNeeded ? <span class="badge-review">{TAXONOMY_REVIEW_LABEL}</span> : null}
      </div>
      <h3><a href={recall.detailPath}>
        <span class="recall-list-card-notice-title">{recall.title}</span>
        <span class="recall-list-card-short-title">{shortTitle}</span>
      </a></h3>
      <p class="result-card-line recall-list-card-products"><strong>Product: </strong>{productText}</p>
      {brandText && brandText !== 'Brand not listed' && <p class="result-card-line">{brandText}</p>}
    </div>
    <div class="recall-card-summary">
      <div class="recall-card-summary-row recall-card-risk">
        <UiIcon name="warning" />
        <p class="result-card-line result-card-reason"><strong>{getRecallReasonLabel(recall.source)}: </strong>{reasonText}</p>
      </div>
      <div class="recall-card-summary-row">
        <UiIcon name="checklist" />
        <p class="result-card-line result-card-action"><strong>{getRecallActionLabel(recall.source)}: </strong>{action.text}</p>
      </div>
    </div>
    {photoSubmissionNoticeUrl ? (
      <a class="source-link source-link-small photo-submission-link" href={photoSubmissionNoticeUrl} target="_blank" rel="noopener noreferrer">
        <UiIcon name="camera" />
        <span><span data-i18n="category.photoSubmission">{getMessage('category.photoSubmission')}</span> · CPSC <span aria-hidden="true">↗</span></span>
      </a>
    ) : null}
    {reviewNeeded ? <p class="taxonomy-review-note">{TAXONOMY_REVIEW_NOTICE}</p> : null}
    <div class="link-row">
      <a class="btn btn-primary" href={recall.detailPath} data-i18n="common.viewRecall">View recall</a>
    </div>
  </div>
</article>
