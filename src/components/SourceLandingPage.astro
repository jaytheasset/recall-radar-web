---
import CanonicalUrl from './CanonicalUrl.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import EuImageResourceHints from './EuImageResourceHints.astro';
import RecallListCard from './RecallListCard.astro';
import UiIcon from './UiIcon.astro';
import { getSourceLandingProductTypeFilters, type SourceLandingPageConfig } from '../lib/source-landing-pages';
import type { SiteRecall } from '../lib/recall-data';
import { getGeneralIdentifierGuidance, getSourceIdentifierGuidance } from '../lib/identifier-guidance';
import { formatUiMessage, getMessage, getProductFamilyI18nKey } from '../lib/i18n';
import { sourcePageSearchTextFor } from '../lib/source-page-search';
import '../styles/global.css';

type Props = {
  page: SourceLandingPageConfig;
  recalls: SiteRecall[];
};

const { page, recalls } = Astro.props;
const productTypeFilters = getSourceLandingProductTypeFilters(page);
const identifierGuidance =
  page.sourceIds.length === 1 ? getSourceIdentifierGuidance(page.sourceIds[0]) : getGeneralIdentifierGuidance();
const initialCount = { count: recalls.length.toLocaleString('en-US') };
---

<html lang="en">
  <head>
    <CanonicalUrl />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <EuImageResourceHints />
    <title>{page.title}</title>
    <meta name="description" content={page.metaDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteHeader />

    <main class="page-shell source-landing-page">
      <section class="section source-landing-intro">
        <h1>{page.heading}</h1>
        <p class="lead">{page.card.agencyLabel}</p>
      </section>

      <section class="section category-search-panel" data-category-search-root data-category-total={recalls.length}>
        <form class="category-search-form" data-category-search-form role="search">
          <label>
            <span class="sr-only" data-i18n="checker.title">Search recalls</span>
            <input data-category-search-input type="search" placeholder={page.searchPlaceholder} autocomplete="off" />
          </label>
          <button class="btn btn-primary" type="submit">
            <UiIcon name="search" />
            <span data-i18n="home.searchSubmit">Search</span>
          </button>
          <button class="btn btn-secondary" type="button" data-category-search-clear data-i18n="common.clear" hidden>Clear</button>
        </form>
        <details class="source-filter-panel">
          <summary>
            <UiIcon name="filter" />
            <span data-i18n="checker.productType">Product type</span>
            <span class="source-filter-selection" data-source-category-selection data-i18n="category.allTypes">All</span>
          </summary>
          <div class="source-filter-row" data-source-category-filters>
            {productTypeFilters.map((filter) => (
              <a
                class="source-filter-chip"
                href={filter.href}
                data-source-category-option={filter.category}
                data-source-category-label={filter.label}
              >
                <span data-i18n={filter.category === 'all' ? 'category.allTypes' : getProductFamilyI18nKey(filter.category)}>
                  {filter.label}
                </span>
                <span class="filter-count">{filter.count}</span>
              </a>
            ))}
          </div>
        </details>
        <div class="source-search-meta">
          <div class="category-search-status" role="status">
            <span class="status-pill" data-category-result-count data-i18n-template="common.recallsCount" data-i18n-values={JSON.stringify(initialCount)}>
              {formatUiMessage('common.recallsCount', initialCount, 'en')}
            </span>
          </div>
          <details class="source-search-help">
            <summary data-i18n="category.searchTips">Search tips</summary>
            <p class="form-note search-guidance-note">{identifierGuidance}</p>
          </details>
        </div>
        <p class="disclaimer-copy source-safety-note">
          <UiIcon name="warning" />
          <span data-i18n="category.officialCheck">{getMessage('category.officialCheck')}</span>
        </p>
        <div class="notice-panel category-no-results" data-category-no-results hidden>
          <p data-i18n="category.noMatches">{getMessage('category.noMatches')}</p>
        </div>
      </section>

      <section class="section source-results-section" data-category-group>
        <h2 class="sr-only" data-i18n="common.recallNotices">Recall notices</h2>
        {recalls.length ? (
          <div class="product-grid">
            {recalls.map((recall) => (
              <RecallListCard
                recall={recall}
                sourceCard
                cardCategory={recall.taxonomyProductFamily || recall.category}
                searchText={sourcePageSearchTextFor(recall)}
              />
            ))}
          </div>
        ) : (
          <div class="notice-panel">
            <p data-i18n="category.noSourceGroupNotices">No recall notices are currently available for this source group.</p>
          </div>
        )}
      </section>
    </main>

    <SiteFooter />
    <script>
      import { initCategoryPageSearch } from '../lib/category-page-search';
      import { initImageFallbacks } from '../lib/image-fallback';
      import { initProgressiveCardImages } from '../lib/progressive-detail-image';

      initProgressiveCardImages();
      initImageFallbacks();
      initCategoryPageSearch();
    </script>
  </body>
</html>
