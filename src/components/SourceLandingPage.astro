---
import EuImageResourceHints from './EuImageResourceHints.astro';
import { getSourceLandingProductTypeFilters, type SourceLandingPageConfig } from '../lib/source-landing-pages';
import type { SiteRecall } from '../lib/recall-data';
import { getGeneralIdentifierGuidance, getSourceIdentifierGuidance } from '../lib/identifier-guidance';
import { sourcePageSearchTextFor } from '../lib/source-page-search';
import { getRecallImageForContext } from '../lib/recall-images';
import { getRecallSourceLabel, getRecallSourcePlaceholder } from '../lib/recall-sources';
import '../styles/global.css';

type Props = {
  page: SourceLandingPageConfig;
  recalls: SiteRecall[];
};

const { page, recalls } = Astro.props;
const sourceLabels = page.sourceIds.map((source) => getRecallSourceLabel(source));
const productTypeFilters = getSourceLandingProductTypeFilters(page);
const identifierGuidance =
  page.sourceIds.length === 1 ? getSourceIdentifierGuidance(page.sourceIds[0]) : getGeneralIdentifierGuidance();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <EuImageResourceHints />
    <title>{page.title}</title>
    <meta name="description" content={page.metaDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Recall Radar</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/checker">Product Recall Checker</a>
        <a href="/#browse-recalls">Browse Recalls</a>
        <a href="/#official-sources">Sources</a>
        <a href="/watchlist">Watchlist</a>
      </nav>
    </header>

    <main class="page-shell source-landing-page">
      <section class="section">
        <p class="eyebrow">{page.eyebrow}</p>
        <div class="meta-row data-source-row">
          <span class="badge-source">Country / source</span>
          <span class="badge-date">{recalls.length} indexed notice{recalls.length === 1 ? '' : 's'}</span>
          {sourceLabels.map((label) => <span class="tag">{label}</span>)}
        </div>
        <h1>{page.heading}</h1>
        <p class="lead">{page.description}</p>
      </section>

      <section class="section source-filter-panel" aria-labelledby="source-product-type-filter">
        <div class="section-header">
          <div>
            <h2 id="source-product-type-filter">Filter by product family</h2>
            <p class="section-note">Narrow this source group without leaving the page.</p>
          </div>
        </div>
        <div class="source-filter-row" data-source-category-filters>
          {productTypeFilters.map((filter) => (
            <a
              class="source-filter-chip"
              href={filter.href}
              data-source-category-option={filter.category}
              data-source-category-label={filter.label}
            >
              <span>{filter.label}</span>
              <span class="filter-count">{filter.count} indexed notice{filter.count === 1 ? '' : 's'}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section category-search-panel" data-category-search-root data-category-total={recalls.length}>
        <form class="category-search-form" data-category-search-form>
          <label>
            {page.searchLabel}
            <input data-category-search-input type="search" placeholder={page.searchPlaceholder} autocomplete="off" />
          </label>
          <button class="btn btn-primary" type="submit">Search this source</button>
          <button class="btn btn-secondary" type="button" data-category-search-clear hidden>Clear</button>
        </form>
        <p class="form-note search-guidance-note">{identifierGuidance}</p>
        <div class="category-search-status">
          <span class="status-pill" data-category-result-count>
            {recalls.length} of {recalls.length} indexed notice{recalls.length === 1 ? '' : 's'} shown
          </span>
        </div>
        <p class="disclaimer-copy">
          Search results are possible matches, not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.
        </p>
        <div class="notice-panel category-no-results" data-category-no-results hidden>
          <p>{page.noResultCopy}</p>
        </div>
      </section>

      <section class="section" data-category-group>
        <div class="section-header">
          <div>
            <h2>Indexed notices</h2>
            <p class="section-note">Shown from the selected official source group currently indexed by Recall Radar.</p>
          </div>
        </div>
        {recalls.length ? (
          <div class="product-grid">
            {recalls.map((recall) => {
              const image = getRecallImageForContext(recall, 'list');

              return (
                <article
                  class="product-card"
                  data-category-card
                  data-source-card
                  data-card-category={recall.taxonomyProductFamily || recall.category}
                  data-search-text={sourcePageSearchTextFor(recall)}
                >
                  <a class="image-shell" href={recall.detailPath} aria-label={`View recall for ${recall.title}`}>
                    {image.url ? (
                      <>
                        <img
                          src={image.url}
                          alt={image.alt}
                          loading="lazy"
                          decoding="async"
                          data-fallback-label={getRecallSourcePlaceholder(recall.source)}
                        />
                        <span class="image-placeholder image-placeholder-fallback" hidden>
                          {getRecallSourcePlaceholder(recall.source)}
                        </span>
                      </>
                    ) : (
                      <span class="image-placeholder">{getRecallSourcePlaceholder(recall.source)}</span>
                    )}
                  </a>
                  <div class="card-body">
                    <div class="meta-row">
                      <span class="badge-source">{recall.sourceLabel}</span>
                      <span class="tag">{recall.taxonomyProductFamilyLabel || recall.categoryLabel}</span>
                      {recall.taxonomyHazardTypeLabel ? <span class="badge-danger">{recall.taxonomyHazardTypeLabel}</span> : null}
                      <span class="badge-date">{recall.recallDate}</span>
                    </div>
                    <h3><a href={recall.detailPath}>{recall.title}</a></h3>
                    <p>{recall.hazard || recall.reason || 'Reason not listed in the indexed notice.'}</p>
                    <div class="link-row">
                      {recall.primaryBrandSlug ? (
                        <a class="btn btn-ghost" href={`/brands/${recall.primaryBrandSlug}`}>{recall.primaryBrand} page</a>
                      ) : null}
                      <a class="btn btn-primary" href={recall.detailPath}>View recall</a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="notice-panel">
            <p>No indexed notices are currently available for this source group.</p>
          </div>
        )}
      </section>
    </main>

    <footer class="page-footer">
      Recall Radar helps you find possible recall notices. Search results are not safety confirmations. Always verify affected models, lots, dates, distribution, and remedies with the official notice.
    </footer>
    <script>
      import { initCategoryPageSearch } from '../lib/category-page-search';
      import { initImageFallbacks } from '../lib/image-fallback';
      import { initProgressiveCardImages } from '../lib/progressive-detail-image';

      initProgressiveCardImages();
      initImageFallbacks();
      initCategoryPageSearch();
    </script>
  </body>
</html>
