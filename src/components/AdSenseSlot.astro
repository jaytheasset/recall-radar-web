---
import { getAdSenseSlotConfig, type AdSensePlacement } from '../lib/monetization.ts';

interface Props {
  placement: AdSensePlacement;
}

const { placement } = Astro.props;
const config = getAdSenseSlotConfig(placement);
---

{
  config && (
    <aside class="adsense-slot" aria-label="Advertisement">
      <ins
        class="adsbygoogle"
        style="display: block"
        data-ad-client={config.client}
        data-ad-slot={config.slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
      <script is:inline>
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </aside>
  )
}
